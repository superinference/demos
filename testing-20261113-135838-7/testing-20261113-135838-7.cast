[115.381319, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m 2      \"\"\"\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m 3      Convert duration strings like '3h', '45m', '120s' to total seconds.\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m 4      \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5-     Intentionally buggy:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6-     - Does not handle leading/trailing whitespace\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m 7-     - Fails on '0s'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8-     \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9-     # Bug 1: No stripping of whitespace\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m10-     if len(s) < 2:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 30 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         return value * 3600\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m21+     elif unit == 'm':\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m22+         return value * 60\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m23+     elif unit == 's':\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m24+         # Fix 3: Allow zero values\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  25          return value\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  26      else:\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  27          raise ValueError(f\"Unknown unit: {unit}\")\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-21\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Percolating \u001b[2m22.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K        \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m   \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[32m\u2894\u281d\u282b\u2862\u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m  \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                       \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[67G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n"]
