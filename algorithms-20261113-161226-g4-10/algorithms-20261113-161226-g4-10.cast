[81.680872, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[81.681362, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m14          Find shortest path from start to end using Dijkstra's algorithm.\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m15          Returns (shortest_distance, path).\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m16          \"\"\"\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m-         # Initialize distances and parent tracking\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m-         distances = {node: float('inf') for node in self.graph}\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m-         distances[start] = 0\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m-         parent = {node: None for node in self.graph}\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+         # Collect all nodes (both sources and destinations)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         all_nodes = set(self.graph.keys())\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502      ... 3 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m22+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m23+         # Initialize distances and parent tracking\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m24+         distances = {node: float('inf') for node in all_nodes}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m25+         distances[start] = 0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m26+         parent = {node: None for node in all_nodes}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  27          \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  28          # Min heap: (distance, node)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  29          pq = [(0, start)]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+10\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-4\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Crystallizing \u001b[2m17.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m   \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u2869\u288d\u001b[39m                                 \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580