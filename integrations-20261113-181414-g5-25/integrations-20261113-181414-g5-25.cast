[84.262874, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[32m\u289e\u28d3\u2840\u001b[39m \u001b[37m\u2811\u2804\u2820\u280a\u001b[39m          \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m              \u001b[93m\u28e0\u28be\u2875\u28c4\u001b[39m                \u001b[35m\u289e\u28d3\u2840\u001b[39m \u001b[37m\u2811\u2804\u2820\u280a\u001b[39m\r\r\n\u001b[24G\u001b[K\u001b[32m\u001b[39m\u001b[37m\u2801\u001b[39m            \u001b[36m\u287d\u2809\u283f\u2809\u28af\u001b[39m              \u001b[93m\u2819\u28ae\u2877\u280a\u001b[39m               \u001b[35m\u2819\u285f\u28ab\u2843\u001b[2m\u2836\u001b[22m\u001b[39m \u001b[37m\u2801\u001b[39m\r\r\n\u001b[19G\u001b[K                                        \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[14G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u00