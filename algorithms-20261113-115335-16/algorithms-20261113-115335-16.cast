[79.325731, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ Implements tokenizer, recursive-descent parser, and tree-walking evaluator.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ import random\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ # ============================================================================\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     NUMBER = 'NUMBER'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     DICE_OP = 'DICE_OP'      # 'd' or 'D'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     KEEP_HIGH = 'KEEP_HIGH'   # 'kh' or 'KH'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     PLUS = 'PLUS'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     MINUS = 'MINUS'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     STAR = 'STAR'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     LPAREN = 'LPAREN'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+340 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run the file to see the results:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[20G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u28a0\u28ff\u2844\u001b[39m                             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u2879\u283b\u288b\u001b[39m  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                          \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[24G\u001b[K  \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                             \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m1% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
