[188.237374, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+ # build a tuple) at *parse* time -- before any of our code touches it.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ servers:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+   - name: web-01\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     ip: 10.0.0.11\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     role: frontend\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ pwned: !!python/object/apply:builtins.exec\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+   - \"open('/tmp/ami-demo-yCN1wP/PWNED.txt','w').write('arbitrary code executed during YAM\r\r\n\u001b[6G\u001b[K\u001b[2m11  [Auto-formatted]\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(=== Running VULNERABLE loader on malicious file...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KInteresting and important: in PyYAML 6.0.3, FullLoader already \u001b[1mblocks\u001b[22m builtins.exec specifically.\r\r\n\u001b[1G\u001b[KThat's a partial, incidental protection \u2014 but FullLoader is still not safe. Let me prove that by\r\r\n\u001b[1G\u001b[Kshowing it will happily instantiate other arbitrary Python objects (the real danger), and test what\r\r\n\u001b[1G\u001b[Ksafe_load does.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(FullLoader tuple blocked: ConstructorError) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KLet me find a concrete difference between FullLoader and safe_load to justify the fix with evidence.\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Error: Command contains brace expansion that co...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Tinkering \u001b[2m1.5s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called load_inv\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[20G\u001b[K\u001b[93m\u001b[39m\u001b[32m\u28d7\u2844\u001b[39m                \u001b[36m\u28a0\u28ff\u2844\u001b[39m                                  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[93m\u001b[39m\u001b[32m\u282b\u2862\u001b[39m                \u001b[36m\u287d\u283f\u28af\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m                                                       \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinfere"]
