[92.788754, "o", "\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: click a \u25b6 row, or press Ctrl+T, to expand every component\u001b[22m\r\r\n\u001b[19G\u001b[K                                     \u001b[93m\u001b[2m\u2824\u001b[22m\u2880\u28c0\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[93m\u28f4\u28bb\u28cf\u2877\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u287d\u2839\u280f\u28af\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[93m\u2808\u283b\u280f\u001b[39m              \u001b[35m\u001b[2m\u2808\u001b[22m\u001b[39m \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 Ctrl+D exit\u001b[22m              \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0"]
