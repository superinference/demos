[69.541242, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ # quickping\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ Check network latency from the command line. Fast, minimal, readable.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ ```bash\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ $ quickping google.com\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ google.com: 12ms (avg over 5 pings)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ ```\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 5 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ # Linux\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ curl -L https://github.com/user/quickping/releases/latest/download/quickping-linux -o qui\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ chmod +x quickping\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ sudo mv quickping /usr/local/bin/\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+111 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  22  [Auto-formatted]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Cooking \u001b[2m16.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[29G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m      \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m             \u001b[35m\u001b[2m\u2820\u001b[22m\u28a0\u28fa\u28d7\u2844\u001b[39m                        \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m\r\r\n\u001b[24G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u2894\u281d\u282b\u2862\u001b[39m      \u001b[36m\u001b[2m\u2802\u001b[22m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m                        \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m                         \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 