[312.691944, "o", "\u001b[1;1H\u001b[J\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[2m  \u2502  \u001b[22m 1+ #include <stdio.h>\r\r\n\u001b[2m  \u2502  \u001b[22m 2+ #include <stdlib.h>\r\r\n\u001b[2m  \u2502  \u001b[22m 3+ #include <string.h>\r\r\n\u001b[2m  \u2502  \u001b[22m 4+ #include <stdbool.h>\r\r\n\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[2m  \u2502  \u001b[22m 6+ #define MAX_PATH 10000\r\r\n\u001b[2m  \u2502  \u001b[22m 7+ #define MAX_GRID 30\r\r\n\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[2m  \u2502  \u001b[22m 9+ typedef struct {\r\r\n\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[2m  \u2502  \u001b[22m14+     int width, height;\r\r\n\u001b[2m  \u2502  \u001b[22m15+     int grid[MAX_GRID][MAX_GRID];\r\r\n\u001b[2m  \u2502  \u001b[22m16+     int start_x, start_y;\r\r\n\u001b[2m  \u2502  \u001b[22m17+     int end_x, end_y;\r\r\n\u001b[2m  \u2502  \u001b[22m18+ } Maze;\r\r\n\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[2m  \u2502  \u001b[22m20+ typedef struct {\r\r\n\u001b[2m  \u2502  21  ... (+171 more lines)\u001b[22m\r\r\n\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[38;5;136m/\u001b[39m Noodling \u001b[2m11.2s\u001b[22m\r\r\n"]
[312.691997, "o", "\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a self-contained polyg\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\r\r\n          \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                    \u001b[92m\u28a0\u28fa\u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m                                  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n          \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m                   \u001b[92m\u2894\u281d\u001b[36m\u287d\u2839\u280f\u28af\u001b[39m                                  \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n                                    \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m   \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[2m \u001b[22m\r\r\n \u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m          \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  12% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;2