[111.214832, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[111.21532, "o", "\u001b[29A\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m#!/usr/bin/env python3\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m\"\"\"\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m Recipe Scaling CLI - Scales recipes and auto-converts units intelligently.\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m \"\"\"\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mfrom ingredients import Recipe, Ingredient\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mfrom converter import scale_ingredient\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mfrom formatter import format_recipe, format_recipes_side_by_side\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[E\u001b[18G\u001b[K\u001b[2m\u001b[22mname=\"Spicy Black Bean Chili\",\r\r\n\u001b[18G\u001b[K\u001b[2m\u001b[22mservings=4,\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m         ingredients=[\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m        Ingredient(quantity=2, unit=\"tbsp\", name=\"olive oil\"),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m        Ingredient(quantity=1, unit=\"cup\", name=\"onion, diced\"),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m        Ingredient(quantity=4, unit=\"clove\", name=\"garlic, minced\"),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m        Ingredient(quantity=2, unit=\"tbsp\", name=\"chili powder\"),\r\r\n\u001b[16G\u001b[K\u001b[2m56 more lines)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Hyperspacing \u001b[2m3.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mBuild a small Python CLI app \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K       \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2820\u001b[22m\u001b[39m        \u001b[36m\u28a0\u28ff\u2844\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m  \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u2879\u283b\u288b\u001b[39m               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m  \u001b[93m\u2839\u287a\u2897\u280f\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[92m\u001b[2m\u2802\u001b[22m\u001b[39m                             \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m1% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b