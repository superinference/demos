[215.856485, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[32m\u28f0\u28f8\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m              \u001b[33m\u28c9\u283e\u28b9\u28d9\u001b[39m       \u001b[35m\u28c0\u28b8\u2856\u28c5\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u2895\u285d\u282b\u2863\u001b[39m        \u001b[36m\u287d\u2809\u283f\u2809\u28af\u001b[39m              \u001b[33m\u281b\u2816\u2831\u2898\u001b[39m       \u001b[35m\u2839\u280e\u28b3\u287e\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                   \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m           \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u00