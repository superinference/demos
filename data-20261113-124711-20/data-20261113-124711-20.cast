[119.063961, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[14G\u001b[K \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[92m\u2809\u2809\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m           \u001b[36m\u2890\u2842\u001b[2m\u2804\u001b[22m\u001b[39m                                  \u001b[35m\u284e\u2809\u2809\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m\r\r\n\u001b[14G\u001b[K \u001b[93m\u2819\u28be\u2877\u280b\u001b[92m\u281d\u2809\u2801\u001b[39m \u001b[37m\u2808\u281d\u2809\u2801\u001b[39m           \u001b[36m\u284d\u28a9\u001b[39m                                   \u001b[35m\u2808\u281d\u2809\u2801\u001b[39m \u001b[37m\u2808\u281d\u2809\u2801\u001b[39m\r\r\n\u001b[1G\u001b[K                \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m   \u001b[92m\u001b[2m\u2802\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                       \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[119.064746, "o", "\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[119.104409, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it again to show the final output with the \u2605 markers:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KPerfect! Here's what the script does:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mStats.py Analysis Results:\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KThe script successfully analyzes the caf\u00e9's weekly drink orders and produces a clean ranking:\r\r\n\u001b[E\u001b[1G\u001b[K1. \u001b[1mLatte\u001b[22m (\u2605) \u2014 Mean: 61.43, Median: 61.0 \u2014 the clear winner with most consistent high volume\r\r\n\u001b[1G\u001b[K2. \u001b[1mEspresso\u001b[22m (\u2605) \u2014 Mean: 41.00, Median: 41.0 \u2014 solid second place with steady demand\r\r\n\u001b[1G\u001b[K3. \u001b[1mCappuccino\u001b[22m (\u2605) \u2014 Mean: 35.00, Median: 35.0 \u2014 rounds out the top 3\r\r\n\u001b[1G\u001b[K4. \u001b[1mMatcha\u001b[22m \u2014 Mean: 29.14, Median: 29.0\r\r\n\u001b[1G\u001b[K5. \u001b[1mChai\u001b[22m \u2014 Mean: 20.00, Median: 20.0\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe sparkline visualization shows 7-day trends using Unicode block characters (\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588) where the\r\r\n\u001b[1G\u001b[Kheight represents relative daily sales. All three top drinks are marked with \u2605 for quick visual\r\r\n\u001b[1G\u001b[Kidentification.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
