[143.529179, "o", "\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[40G\u001b[K\u001b[36m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m      \u001b[32m\u282a\u2810\u2805\u2807\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m         \u001b[36m\u001b[2m\u2802\u001b[22m\u28f0\u28fd\u2867\u2840\u001b[39m                                  \u001b[35m\u282a\u2810\u2805\u2807\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m    \u001b[32m\u282a\u282d\u282d\u2815\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m          \u001b[36m\u281e\u2818\u281b\u28d7\u001b[2m\u2820\u001b[22m\u001b[39m                                 \u001b[35m\u282a\u282d\u282d\u2815\u001b[2m\u2810\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                               \u001b[36m\u2808\u001b[39m                                    \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org