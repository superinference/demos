[47.122826, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[47.123172, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import random\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ def patience_sort(arr):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+     \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     Sorts an array using the patience sort algorithm.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     Returns the sorted array and the piles created during sorting.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     # Split phase: create piles\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     piles = []\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+         for pile in piles:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+             if pile[-1] >= num:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+                 pile.append(num)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+                 placed = True\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+                 break\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         # If no suitable pile found, create a new pile\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+64 more lines)\u001b[22m\r\r\n"]
[47.123234, "o", "\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Tinkering \u001b[2m3.3s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mImplement patience sort in Py\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2804\u001b[22m\u001b[39m        \u001b[36m\u2869\u288d\u001b[39m                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[49G\u001b[K\u001b[36m\u001b[2m\u001b[22m\u001b[39m       \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m   \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
