[32.014783, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[32.014899, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ def convert_temp_for_nyc(fahrenheit):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+     \"\"\"Convert temperature for New York City with local formatting.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+     celsius = (fahrenheit - 32) * 5 / 9\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+     return f\"NYC: {fahrenheit}\u00b0F = {celsius:.1f}\u00b0C\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ def convert_temp_for_london(fahrenheit):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     \"\"\"Convert temperature for London with local formatting.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     celsius = (fahrenheit - 32) * 5 / 9\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     \"\"\"Convert temperature for Tokyo with local formatting.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     celsius = (fahrenheit - 32) * 5 / 9\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     return f\"Tokyo: {fahrenheit}\u00b0F = {celsius:.1f}\u00b0C\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ if __name__ == \"__main__\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     test_temps = [32, 68, 100, 212, -40]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+6 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Percolating \u001b[2m1.5s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python file called o\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[39m                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u2869\u288d\u001b[39m                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[22G\u001b[K      \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                  \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n"]
