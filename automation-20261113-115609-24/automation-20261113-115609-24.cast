[207.737279, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[207.737662, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m7- - 500g bread flour\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8- - 350g water (70% hydration)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9- - 10g salt\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10- - 100g active sourdough starter\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 18 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+ ## Steps\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ 1. Mix the flour, water, salt, and starter until no dry flour remains, then let rest.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ 2. Bulk ferment at room temperature for 6 hours, folding the dough every 30-45 minutes.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ 3. Shape the dough, then cold-retard it in the refrigerator overnight (8-12 hours) to dev\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ 4. Proof if needed, then bake in a preheated Dutch oven at 230\u00b0C until deeply browned.\r\r\n\u001b[6G\u001b[K\u001b[2m19  [Auto-formatted]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+18\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-17\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Exit code: 0) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan git_commit([master e6d421c] tweak: higher hydration, whole...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow the final step \u2014 printing both the log and the diff to the terminal:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[10G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u001b[39m\u001b[2mbash(=== git log --oneline ===) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Coalescing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u001b[39m\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[36m\u287d\u2809\u283f\u2809\u28af\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m  \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[74G\u001b[K\u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[92m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[3"]
