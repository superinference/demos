[150.700416, "o", "\u001b[29A\u001b[64G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u001b[39m\u001b[2m4 0.0s\u001b[22m\r\r\n\u001b[63G\u001b[K\u001b[38;5;35m\u001b[39m\u001b[1m\u001b[38;5;167m\u001b[39m\u001b[22m\u001b[2m\u001b[22m\u001b[38;5;243m\u001b[39m\u001b[2m\u001b[22m\u001b[38;5;35m4)\u001b[39m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;35m202 tok\u001b[39m\r\r\n\u001b[E\u001b[36G\u001b[K\u001b[2m10 lines changed]\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[32G\u001b[K\u001b[2m\u001b[22mthe full Loader can instantiate arbitrary Python\r\r\n\u001b[20G\u001b[K\u001b[2m\u001b[22mobjects, enabling remote code execution. (Historically this was\r\r\n\u001b[18G\u001b[K\u001b[2m\u001b[22m# yaml.load(f)'s default behavior before PyYAML 5.1.)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10-         config = yaml.load(f, Loader=yaml.Loader)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         # FIXED: safe_load() only constructs standard YAML types (dicts,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         # lists, scalars) and refuses arbitrary Python object tags, so a\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         # malicious !!python/object/apply payload cannot execute code.\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+         config = yaml.safe_load(f)\r\r\n\u001b[7G\u001b[K\u001b[2m1      return config\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  13  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Tinkering \u001b[2m0.9s\u001b[22m\r\r\n"]
[150.70044, "o", "\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a small Python script \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2820\u001b[22m\u001b[39m               \u001b[36m\u28a0\u28ff\u2844\u001b[2m\u2804\u001b[22m\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[93m\u28c6\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2879\u283b\u288b\u001b[39m                                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[93m\u280b\u001b[35m\u001b[2m\u2802\u001b[93m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[75G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[93m\u001b[2m\u001b[35m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
