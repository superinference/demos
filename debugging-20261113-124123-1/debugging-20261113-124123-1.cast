[48.605232, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ # Parse the date\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ date_obj = datetime.strptime(date_str, '%Y-%m-%d')\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ # Build dict of parts - bug: using 'dow' instead of 'weekday'\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 2 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+     'month': date_obj.strftime('%B'),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+     'day': date_obj.day,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     'dow': date_obj.strftime('%A')  # \u001b[32mBUG:\u001b[39m should be 'weekday'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ }\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ # Substitute into format string\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ result = fmt.format(**parts)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ print(result)\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+19\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it to see the crash:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-xp7z2V && python fmt_date.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-xp7z2V && python fmt_date.py \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u001b[39m\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u001b[39m\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u001b[2m\u2809\u001b[22m\u2894\u281d\u282b\u2862\u001b[39m              \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u001b[2m\u2812\u001b[22m\u001b[39m                                                     \u001b[35m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n"]
[48.605738, "o", "\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B \u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-sonnet-4-5 \u00b7  8% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
