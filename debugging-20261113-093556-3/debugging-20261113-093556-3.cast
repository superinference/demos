[249.138873, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m6  def test_legitimate_request_returns_contents():\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7-     assert serve_file(\"greeting.txt\") == \"hello from safe file\\n\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+     assert serve_file(\"greeting.txt\").strip() == \"hello from safe file\"\r\r\n\u001b[6G\u001b[K\u001b[2m 8  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m 9  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m10  def test_traversal_attempt_is_blocked():\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(============================= test session star...) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KAll done. All 3 tests pass.\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mSummary\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mFiles created in /tmp/ami-demo-JNkyG0/:\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 serve_file.py \u2014 the file server (now hardened)\r\r\n\u001b[1G\u001b[K\u2022 test_serve_file.py \u2014 3 tests\r\r\n\u001b[3G\u001b[Kdata/greeting.txt \u2014 sample legitimate file\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mThe vulnerability (as requested, then fixed)\u001b[23m\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KThe original used\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;2