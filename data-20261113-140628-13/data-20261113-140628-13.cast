[82.206389, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m 1  import statistics\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2- from tabulate import tabulate\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4- # 20 daily temperature data points (in Fahrenheit)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5- temperatures = [\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6-     72, 75, 68, 71, 76, 79, 81, 78, 74, 70,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7-     69, 73, 77, 80, 82, 75, 72, 71, 76, 78\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8- ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 50 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m30+\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m31+ # Print formatted table\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m32+ print(f\"{'Statistic':<20} | {'Value':<40}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m33+ print(\"-\" * 65)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m34+ for stat, value in summary_data:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m35+     print(f\"{stat:<20} | {value:<40}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m36+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m37+ print(\"=\" * 65)\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+36\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-30\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Noodling \u001b[2m2.4s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python file stats.py\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[18G\u001b[K                                         \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m                 \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m            \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u001b[2m\u2802\u001b[22m\u284d\u28a9\u001b[39m                 \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m            \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K                    \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                   \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m           \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b