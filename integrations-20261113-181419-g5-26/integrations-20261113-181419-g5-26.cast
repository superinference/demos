[214.853305, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2811\u2884\u2860\u280a\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m          \u001b[36m\u28a0\u28fa\u2897\u2844\u001b[2m\u2820\u001b[22m\u001b[39m        \u001b[33m\u284e\u28b1\u001b[39m   \u001b[37m\u284e\u28b1\u001b[39m                  \u001b[35m\u2811\u2884\u2860\u280a\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u2801\u2808\u2822\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m          \u001b[36m\u287f\u2839\u280f\u28af\u001b[39m        \u001b[33m\u001b[2m\u2802\u001b[22m\u28bc\u2867\u001b[39m   \u001b[37m\u28bc\u2867\u001b[39m                  \u001b[35m\u2814\u2801\u2808\u2822\u001b[2m\u2837\u001b[22m\u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m                                 \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u