[106.8238, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     {\"name\": \"Alice\", \"score\": \"95\"},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     {\"name\": \"Bob\", \"score\": \"80\"},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     {\"name\": \"Carol\", \"score\": \"100\"},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     {\"name\": \"Dave\", \"score\": \"90\"},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     {\"name\": \"Eve\", \"score\": \"9\"},\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ ]\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     (100, []),                     # nobody above 100\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     (0, [\"Alice\", \"Bob\", \"Carol\", \"Dave\", \"Eve\"]),  # everyone above 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     (85, [\"Alice\", \"Carol\", \"Dave\"]),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ def run():\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+12 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run the tests to capture the \"before\" (buggy) results:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash([FAIL] threshold= 90 expected=['Alice', 'Carol'...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Crystallizing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[39m                       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                       \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u2869\u288d\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                    \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m                       \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[92m\u001b[2m\u2804\u001b[22m\u001b[39m                                                               \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588