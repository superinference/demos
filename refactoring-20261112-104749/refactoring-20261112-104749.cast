[26.529509, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from concurrent.futures import ThreadPoolExecutor\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ from time import perf_counter, sleep\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ TASK_COUNT = 12\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ SLEEP_SECONDS = 0.05\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     return task_id, checksum\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def main() -> None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     start = perf_counter()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     serial_results = [task(task_id) for task_id in range(TASK_COUNT)]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     serial_seconds = perf_counter() - start\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+18 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Traceback (most recent call last):) 0.8s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan file_read(File unchanged since last read: /tmp/ami-demo-o...) 0.0s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u