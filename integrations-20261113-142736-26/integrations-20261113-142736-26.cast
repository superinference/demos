[142.946812, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;203m\\\u001b[39m Percolating \u001b[38;5;136m23.7s\u001b[38;5;172m (reasoning\u2026)\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[9G\u001b[K\u001b[32m\u28dc\u28db\u280a\u2883\u001b[39m                        \u001b[36m\u28a4\u28d6\u28cf\u28c0\u001b[39m            \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                          \u001b[35m\u28a0\u28fa\u2897\u2844\u001b[39m\r\r\n\u001b[9G\u001b[K\u001b[32m\u2885\u2809\u28b6\u2802\u001b[39m                        \u001b[36m\u2815\u28e3\u284b\u28ae\u001b[39m            \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                          \u001b[35m\u28b9\u285f\u28b9\u284f\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[12G\u001b[K                            \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                          \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m