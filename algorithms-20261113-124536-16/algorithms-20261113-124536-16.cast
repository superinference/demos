[117.362221, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[22G\u001b[K\u001b[32m\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2880\u28b4\u289f\u2805\u001b[39m        \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m  \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m        \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2828\u287b\u001b[2m\u2820\u001b[22m\u2801\u001b[39m        \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m  \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m        \u001b[35m\u2899\u287f\u28bf\u284b\u001b[39m\r\r\n\u001b[30G\u001b[K\u001b[32m\u001b[39m\u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m           \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[117.433563, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mParser\u001b[22m (Parser class)\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 Recursive-descent parser implementing this grammar:\r\r\n\u001b[1G\u001b[K  \u25e6 expression := term (('+' | '-') term)*\r\r\n\u001b[1G\u001b[K  \u25e6 term := dice ('*' dice)*\r\r\n\u001b[5G\u001b[Kdice := factor ('d' factor)?\r\r\n\u001b[5G\u001b[Kfactor := NUMBER | '(' expression ')'\r\r\n\u001b[1G\u001b[K\u2022 Builds an Abstract Syntax Tree (AST) with three node types:\r\r\n\u001b[5G\u001b[KNumberNode for literals\r\r\n\u001b[1G\u001b[K  \u25e6 DiceNode for dice rolls (e.g., 2d6)\r\r\n\u001b[5G\u001b[KBinOpNode for binary operations\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mEvaluator\u001b[22m (Evaluator class)\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 Tree-walking interpreter that recursively evaluates the AST\r\r\n\u001b[1G\u001b[K\u2022 DiceNode evaluation: rolls N dice with S sides using random.randint(1, sides)\r\r\n\u001b[3G\u001b[KFixed seed (42) ensures reproducible results\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mResults (with seed 42)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K- `2d6+3` =\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[3