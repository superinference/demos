[166.547871, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K \u001b[92m\u28de\u28d3\u001b[39m   \u001b[37m\u284e\u28b1\u001b[39m     \u001b[36m\u28a0\u28ff\u2844\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m          \u001b[33m\u289e\u28f3\u2880\u001b[39m  \u001b[37m\u284e\u28b1\u001b[39m              \u001b[35m\u28de\u28d3\u001b[39m   \u001b[37m\u284e\u28b1\u001b[39m\r\r\n\u001b[26G\u001b[K\u001b[92m\u28bc\u2823\u2842\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[37m\u281c\u2803\u001b[39m     \u001b[36m\u2879\u283b\u288b\u001b[39m           \u001b[33m\u2811\u28be\u2867\u2803\u001b[39m  \u001b[37m\u281c\u2803\u001b[39m             \u001b[35m\u2811\u28fe\u28a3\u2843\u001b[39m  \u001b[37m\u281c\u2803\u001b[39m\r\r\n\u001b[26G\u001b[K\u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;2