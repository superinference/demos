[190.632903, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[190.633286, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m3- A simple sourdough loaf at 70% hydration.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5- ## Ingredients\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7- - 500g bread flour\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8- - 350g water (70% hydration)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9- - 10g salt\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10- - 100g active sourdough starter\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 18 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ ## Steps\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ 1. Mix the flour, water, salt, and starter until no dry flour remains, then let rest.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ 2. Bulk ferment at room temperature for 6 hours, folding the dough every 30-45 minutes.\r\r\n"]
[190.633319, "o", "\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ 3. Shape the dough, then cold-retard it in the refrigerator overnight (8-12 hours) to dev\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ 4. Proof if needed, then bake in a preheated Dutch oven at 230\u00b0C until deeply browned.\r\r\n\u001b[6G\u001b[K\u001b[2m19  [Auto-formatted]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+18\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-17\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Exit code: 0) 0.0s\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u001b[39m\u001b[2mgit_commit([master e6d421c] tweak: higher hydration, whole...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Coalescing \u001b[2m16.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K        \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m   \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                          \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u001b[2m\u2820\u001b[22m\u287d\u2809\u283f\u2809\u28af\u001b[39m   \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m                         \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
