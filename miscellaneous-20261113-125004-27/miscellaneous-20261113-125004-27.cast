[45.999629, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Generate a maze (recursive backtracking), solve it (BFS), render with ANSI colors.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ import random\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ from collections import deque\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ COLS, ROWS = 25, 15          # maze size in cells\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ W, H = COLS * 2 + 1, ROWS * 2 + 1   # grid size including walls\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     grid = [[False] * W for _ in range(H)]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     def cell(cx, cy):          # cell coord -> grid coord\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+         return cx * 2 + 1, cy * 2 + 1\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     visited = [[False] * COLS for _ in range(ROWS)]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     stack = [(0, 0)]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+102 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Noodling \u001b[2m13.8s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m            \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m               \u001b[36m\u2869\u288d\u001b[39m  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[93m\u001b[2m\u2824\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m            \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[59G\u001b[K\u001b[36m\u001b[2m\u001b[22m\u001b[39m \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[32m\u001b[2m Mentor  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
