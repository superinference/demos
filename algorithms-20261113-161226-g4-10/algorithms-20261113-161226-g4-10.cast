[129.007824, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m    ... 3 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m22+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m23+         # Initialize distances and parent tracking\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         distances = {node: float('inf') for node in all_nodes}\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m25+         distances[start] = 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m26+         parent = {node: None for node in all_nodes}\r\r\n\u001b[6G\u001b[K\u001b[2m27          \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m28          # Min heap: (distance, node)\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m29          pq = [(0, start)]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+10\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-4\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Shortest path from A to E:) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KPerfect! Here's the result:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mOutput:\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KShortest path from A to E:\r\r\n\u001b[1G\u001b[KPath: A -> C -> B -> E\r\r\n\u001b[1G\u001b[KTotal cost: 4\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K**How\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file graph.py that i\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2880\u28ba\u28d3\u28c0\u001b[2m\u2820\u001b[22m\u001b[37m\u2808\u2809\u2809\u001b[39m          \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m                                 \u001b[35m\u2880\u28ba\u28d3\u28c0\u001b[39m \u001b[37m\u2808\u2809\u2809\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2814\u281d\u282b\u2863\u001b[39m             \u001b[36m\u001b[2m\u2802\u001b[22m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m                                 \u001b[35m\u2819\u285f\u28bb\u284b\u001b[39m \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m  \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[20G\u001b[K                   \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                    \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
