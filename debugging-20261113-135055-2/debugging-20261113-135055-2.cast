[141.086467, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m2-     names = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3-     for record in records:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4-         # \u001b[32mBUG:\u001b[39m record[\"score\"] is a string. We compare it against the\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5-         # threshold coerced to a string, so Python does a *lexicographic*\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-         # string comparison instead of a numeric one. This never raises an\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-         # error, it just silently returns wrong results (e.g. \"100\" < \"90\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8-         # lexicographically because '1' < '9').\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9-         if record[\"score\"] > str(threshold):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10-             names.append(record[\"name\"])\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 1 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ def top_scorers(records, threshold):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     names = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     for record in records:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         # FIX: cast the string score to a number so we do a numeric\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         # comparison against the numeric threshold.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         if float(record[\"score\"]) > threshold:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+             names.append(record[\"name\"])\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     return names\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+8\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-11\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash([PASS] threshold= 90 expected=['Alice', 'Carol'...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Crystallizing \u001b[2m15.9s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u28a0\u28ff\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[93m\u001b[39m \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u2879\u283b\u288b\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                             \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[92m\u001b[2m\u2802\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m     \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[92m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;htt