[88.771637, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[88.772022, "o", "\u001b[29A\u001b[3G\u001b[K\u001b[1mangle\u001b[22m \u2014 the needle's tilt, uniform on [0, \u03c0/2].\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KA needle crosses a line when center \u2264 (length/2)\u00b7sin(angle). Over many drops the crossing\r\r\n\u001b[1G\u001b[Kprobability converges to 2\u00b7length / (\u03c0\u00b7spacing), which rearranges to the estimator \u03c0 \u2248 2\u00b7N /\r\r\n\u001b[1G\u001b[Kcrossings when length == spacing.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe run landed within \u001b[1m~0.11%\u001b[22m of true \u03c0 \u2014 typical for 500k samples. Monte Carlo error shrinks like\r\r\n\u001b[1G\u001b[K1/\u221aN, so to get one more decimal digit of reliable accuracy you'd need roughly 100\u00d7 more needles.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The simulation needs no actual (x, y) coordinates \u2014 only the *relative* distance to the nearest\r\r\n\u001b[1G\u001b[Kline and the angle matter, which is why sampling `center` on `[0, spacing/2]` is sufficient and\r\r\n\u001b[1G\u001b[Kkeeps it fast.\r\r\n\u001b[1G\u001b[K- \u03c0 appears in the answer because `angle` is sampled uniformly and `sin` is integrated over it \u2014 the\r\r\n\u001b[1G\u001b[K `\u03c0/2` range of the angle is what injects \u03c0 into the crossing probability.\r\r\n\u001b[1G\u001b[K- `1/\u221aN` convergence is the fundamental Monte Carlo trade-off: accuracy improves only with the\r\r\n\u001b[1G\u001b[Ksquare root of sample count, so brute-forcing extra digits gets expensive fast.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: how-it-works.md (27 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Cooked for 1m 17s \u00b7 done 12:56 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mBuffon's Needle \u03c0 Estimation \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: the Usage inspector tab breaks down tokens and cost\u001b[22m\r\r\n\u001b[18G\u001b[K                    \u001b[36m\u2880\u2860\u2840\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28f0\u28fd\u285f\u28d7\u001b[39m                                  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u281e\u2818\u2803\u2808\u001b[39m                                  \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m         \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K                                                        \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m           \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 Ctrl+D exit\u001b[22m               \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5"]
