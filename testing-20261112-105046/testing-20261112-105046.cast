[21.817424, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Parameterized tests for string_utils using the standard library only.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ import unittest\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ from string_utils import normalize_whitespace\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+ class NormalizeWhitespaceTests(unittest.TestCase):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     cases = [\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+         (\"   \\t\\n\", \"\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+         (\"one\\u00a0two\", \"one two\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+         (\" leading and trailing \", \"leading and trailing\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     def test_normalizes_representative_and_edge_cases(self):\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m20+         for value, expected in self.cases:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\