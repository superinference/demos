[25.917533, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(before: 0.769951s | after: 0.000372s | speedup:...) 0.8s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated and ran benchmark.py in the current directory.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KOutput:\r\r\n\u001b[E\u001b[1G\u001b[Kbefore: 0.769951s | after: 0.000372s | speedup: 2067.5x\r\r\n\u001b[E\u001b[1G\u001b[KThe script uses deterministic in-memory input, compares an O(n\u00b2) nested-loop implementation with an\r\r\n\u001b[1G\u001b[KO(n) set-based implementation, and creates no files outside the current directory.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The slow version checks each item against earlier items, producing quadratic work.\r\r\n\u001b[1G\u001b[K- The set-based version uses hash lookups, reducing duplicate detection to expected linear time.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Worked for 12s \u00b7 done 10:47 AM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[24s | 18280 tokens | $0.0020] Done in 4 turns \u00b7 done 10:47 AM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[8G\u001b[K\u001b[2mprovision spins up a remote GPU pod to run on\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[8G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m      \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2804\u001b[22m\u001b[39m               \u001b[36m\u2890\u2842\u001b[2m\u2802\u001b[22m\u001b[39m                                  \u001b[35m\u282a\u2810\u2805\u2807\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[93m\u2839\u287a\u2897\u280f\u001b[39m  \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m   \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                \u001b[35m\u282a\u282d\u282d\u2815\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[9G\u001b[K\u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m            \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                                                       \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[24G\u001b[K\u001b[36m\u001b[2m.\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
