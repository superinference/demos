[138.490156, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[138.490379, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[1m6. Scannable structure\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 Can jump to Install, Quick start, or Troubleshooting without reading linearly\r\r\n\u001b[3G\u001b[KOptions presented as compact list, not prose\r\r\n\u001b[4G\u001b[Kutput formats shown with real examples, not described\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe README also inverts the typical documentation trap: instead of explaining what each flag does\r\r\n\u001b[1G\u001b[Kand making readers assemble a command, it shows complete commands for real tasks, then references\r\r\n\u001b[1G\u001b[Kthe flags.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- Cognitive load in docs comes from forced reconstruction \u2014 readers shouldn't reassemble pieces into\r\r\n\u001b[1G\u001b[K a working command or infer whether a feature solves their problem\r\r\n\u001b[1G\u001b[K- Tables that map *user intent* (task/question) to *concrete action* (command/answer) exploit\r\r\n\u001b[1G\u001b[Krecognition memory, which is 10x stronger than recall\r\r\n\u001b[1G\u001b[K- The first 20 lines determine if someone stays or leaves; lead with runnable value, defer rationale\r\r\n\u001b[1G\u001b[K and edge cases to later sections for those who need depth\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: how-the-principles-were-applied.md (41 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Worked for 2m 7s \u00b7 done 7:09 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mREADME for quickping CLI netw\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: click a \u25b6 row, or press Ctrl+T, to expand every component\u001b[22m\r\r\n\u001b[18G\u001b[K                                       \u001b[93m\u2880\u2840\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m              \u001b[93m\u28f4\u28bb\u2877\u28c4\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[32m\u001b[2m\u2808\u001b[22m\u2894\u281d\u282b\u2862\u001b[39m              \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m              \u001b[93m\u2808\u283b\u2837\u280b\u001b[39m               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:A\u2026\u001b[22m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[cognitive-doc-design] \u001b[39manthropic-vertex/claude-sonnet-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u