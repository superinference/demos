[35.071159, "o", "\u001b[29A\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m# Constellation Detective\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mA self-contained, deterministic terminal mystery written in Python. Stars are\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mnodes in a directed graph, clue lines are parsed into edges, and breadth-first\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mtraversal follows the evidence to identify the hidden culprit.\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m## Run\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m From this directory, using only the Python standard library:\r\r\n\u001b[14G\u001b[K\u001b[2m5 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ No network, packages, configuration, or interactive input are required.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ ## Case mechanics\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ - `START` names the first star.\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+8 more lines)\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m2  [Auto-formatted]\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Hyperspacing \u001b[2m3.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[2m\u2802\u001b[22m\u001b[39m                               \u001b[93m\u28f0\u28b5\u286e\u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u2869\u288d\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                             \u001b[93m\u2819\u28be\u2877\u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                  \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m    \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m                         \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
