[17.027116, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import csv\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ from io import StringIO\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ DATA = \"\"\"name,department,score\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ Avery,Engineering,94\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ Blair,Design,88\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ Casey,Marketing,91\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ Drew,Support,85\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     header: max(len(header), *(len(row[header]) for row in rows))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     for header in headers\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ }\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ header_line = \" | \".join(header.ljust(widths[header]) for header in headers)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ separator = \"-+-\".join(\"-\" * widths[header] for header in headers)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ print(header_line)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+3 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25