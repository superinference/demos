[160.881934, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import pytest\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from serve_file import serve_file, PathTraversalError\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ def test_legitimate_request_returns_contents():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     assert serve_file(\"greeting.txt\") == \"hello from safe file\\n\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[14G\u001b[K\u001b[2m4 more changes ...\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m def test_absolute_path_is_blocked():\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mwith pytest.raises(PathTraversalError):\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    serve_file(\"/etc/passwd\")\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mif __name__ == \"__main__\":\r\r\n\u001b[16G\u001b[K\u001b[2m3 more lines)\u001b[22m\r\r\n\u001b[11G\u001b[K\u001b[38;5;243m\u001b[39m\u001b[2m\u001b[22m\u001b[38;5;35m\u001b[39m\u001b[2mtotal)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m18.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m   \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m        \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[92m\u2894\u281d\u282b\u2862\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m        \u001b[36m\u287d\u2809\u283f\u2809\u28af\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[92m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
