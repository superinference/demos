[90.776912, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1- def get_event_date(season, hemisphere):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2-     if hemisphere == \"north\":\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3-         if season == \"spring\":\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4-             return \"March equinox\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5-         elif season == \"summer\":\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6-             return \"June solstice\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7-         elif season == \"autumn\":\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8-             return \"September equinox\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-         elif season == \"winter\":\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 28 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ def get_event_date(season, hemisphere):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     try:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+         return _EVENT_DATES[(season, hemisphere)]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     except KeyError:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+         raise ValueError(f\"Unknown combination: {season}+{hemisphere}\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  18  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  19  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  20  if __name__ == \"__main__\":\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+17\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-25\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\