[23.40735, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ \"\"\"A small tokenizer, recursive-descent parser, and evaluator for integer arithmetic.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from dataclasses import dataclass\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ from typing import List, Union\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ @dataclass(frozen=True)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ class Token:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     kind: str\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     tokens: List[Token] = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     index = 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     while index < len(source):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         character = source[index]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         if character.isspace():\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+             index += 1\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         elif character.isdigit():\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+125 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Expression Result) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Crystallizing \u001b[2m0.9s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m   \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u001b[2m\u2809\u001b[22m\u2839\u287a\u2897\u280f\u001b[39m   \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2820\u001b[22m\u001b[39m      \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m       \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[35m\u001b[2m Hype  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
