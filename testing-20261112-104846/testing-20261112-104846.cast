[36.223417, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m11+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+ def test_empty_input():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     assert normalize_and_count(\"\") == (\"\", 0)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ def test_punctuation():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     assert normalize_and_count(\"Hello, world!\") == (\"Hello, world!\", 2)\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(bash: line 1: pytest: command not found) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(/usr/bin/python: No module named pytest) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #4\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(4 tests passed (manual fallback; pytest unavail...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 text_tools.py \u2014 normalizes whitespace and returns the word count.\r\r\n\u001b[1G\u001b[K\u2022 test_text_tools.py \u2014 covers normal input, extra whitespace, empty input, and punctuation.\r\r\n\u001b[E\u001b[1G\u001b[Kpytest -q could not run because pytest is not installed. The four focused assertions passed via a\r\r\n\u001b[1G\u001b[Kmanual fallback:\r\r\n\u001b[1G\u001b[K\r\r\n\u00