[20.027935, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def has_duplicates_slow(values):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     for index, value in enumerate(values):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         for previous in values[:index]:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+             if value == previous:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+                 return True\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     return False\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ def main():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     values = list(range(12000)) + [11999]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     start = perf_counter()\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     slow_result = has_duplicates_slow(values)\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mpython3 /tmp/ami-demo-giCGah/benchmark.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m-\u001b[39m bash python3 /tmp/ami-demo-giCGah/benchmar