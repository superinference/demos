[51.610017, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ \"\"\"Print a plain-text project status report from data.json.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ import json\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ from pathlib import Path\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def main() -> None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     data = json.loads(Path(\"data.json\").read_text())\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     print(f\"PROJECT STATUS REPORT: {data['project']}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     print(rule)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     # Overview\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     status = data[\"status\"].replace(\"_\", \" \").title()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     completion = data[\"completion\"]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     bar_len = 20\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+32 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(================================================) 0.1s\u001b[22m\r\r\n\u001b[1G\