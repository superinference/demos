[11.068802, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > In the current directory, create a self-contained Python file named stats_demo.py with an inline \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255mdataset of numbers, compute its mean, median, and top three values, then run it; use no network and \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255monly relative paths, and print one concise, clearly labeled final summary to the terminal rather \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255mthan a real-time animation. \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m Tinkering \u001b[2m0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500 \u001b[22m\u001b[1m\u001b[38;5;35m\u2713 Pasted 321 chars\u001b[22m\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mIn the current directory, cre\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[33m\u001b[2m\u2802\u001b[22m\u28e0\u28be\u2877\u28c4\u001b[39m \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[16G\u001b[K\u001b[32m\u001b[2m\u281