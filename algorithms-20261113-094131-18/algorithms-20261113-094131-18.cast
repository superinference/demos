perinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[38G\u001b[K                   \u001b[93m\u2880\u28c0\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u2808\u001b[22m\u001b[37m\u282a\u2810\u2805\u2807\u001b[39m           \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[93m\u28f4\u28bb\u28cf\u2877\u001b[2m\u2812\u001b[22m\u001b[39m              \u001b[35m\u282a\u2810\u2805\u2807\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[32m\u001b[39m\u001b[37m\u001b[39m \u001b[36m\u2869\u288d\u001b[39m                \u001b[93m\u2808\u283b\u280f\u001b[39m                \u001b[35m\u282a\u282d\u282d\u2815\u001b[2m\u2810\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[20G\u001b[K                      \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.s"]
[85.343524, "o", "uperinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l\u001b]2;\u2826 AMI \u00b7 Monte Carlo Pi Estimation Script\u0007"]
[85.351607, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[85.351839, "o", "\u001b[29A\u001b[1G\u001b[KTrue pi:        3.141593\r\r\n\u001b[1G\u001b[KAbsolute error: 0.002501\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe script samples points in the unit square [0,1]\u00d7[0,1], counts those satisfying x\u00b2 + y\u00b2 \u2264 1\r\r\n\u001b[1G\u001b[K(inside the quarter circle), and scales the ratio by 4 to estimate \u03c0.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- **Why multiply by 4:** The quarter circle has area `\u03c0\u00b7r\u00b2/4 = \u03c0/4` for `r=1`, while the sampling\r\r\n\u001b[1G\u001b[Ksquare has area 1. So `inside/total \u2248 \u03c0/4`, meaning \u03c0 \u2248 4\u00b7(inside/total).\r\r\n\u001b[1G\u001b[K- **Convergence rate:** Monte Carlo error shrinks as `~1/\u221aN`, so 1M samples gives ~3 significant\r\r\n\u001b[1G\u001b[Kdigits. Getting one more digit would require roughly 100\u00d7 more points \u2014 this slow convergence is the\r\r\n\u001b[1G\u001b[K method's main trade-off.\r\r\n\u001b[1G\u001b[K- **No seed set:** Results vary per run. Add `random.seed(0)` for reproducibility when testing or\r\r\n\u001b[1G\u001b[Kcomparing.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Forged for 1m 12s \u00b7 done 10:43 AM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[1.4m | 30503 tokens | $0.02] Done in 3 turns \u00b7 done 10:43 AM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[7G\u001b[K\u001b[2m/help lists every command\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                                                   \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2890\u2842\u001b[22m\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                 \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u001b[93m\u28e0\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[38G\u001b[K\u001b[36m\u001b[2m\u284d\u28a9\u001b[22m\u001b[39m                                    \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[93m\u001b[2m\u2819\u28be\u2877\u280b\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[35m\u001b[2m Hype  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
