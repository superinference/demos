[68.73602, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[32m\u289b\u28d3\u28e1\u001b[39m \u001b[37m\u2808\u2801\u2801\u2890\u001b[39m         \u001b[36m\u28a0\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[36m\u28e2\u2844\u001b[39m                                 \u001b[35m\u289b\u28d3\u28e1\u001b[39m \u001b[37m\u2808\u2801\u2801\u2890\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u282b\u2863\u001b[39m  \u001b[37m\u2810\u2808\u001b[39m          \u001b[36m\u287d\u001b[93m\u2819\u28be\u2877\u280b\u001b[36m\u2839\u28af\u001b[39m                                \u001b[35m\u2819\u285f\u28ab\u2843\u001b[39m  \u001b[37m\u2810\u2808\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[68.736299, "o", "\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[68.795956, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[68.796393, "o", "\u001b[29A\u001b[1G\u001b[KDone. Here's the actual output from running python3 buffon.py:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KBuffon's Needle - Monte Carlo estimation of pi\r\r\n\u001b[1G\u001b[K---------------------------------\r\r\n\u001b[1G\u001b[KNeedles       : 500000\r\r\n\u001b[1G\u001b[KCrossings     : 317956\r\r\n\u001b[1G\u001b[KEstimated pi  : 3.145089\r\r\n\u001b[1G\u001b[KTrue pi       : 3.141593\r\r\n\u001b[1G\u001b[KPercent error : 0.1113%\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mHow it works\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe script models each needle drop with two independent random variables:\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 \u001b[1mcenter\u001b[22m \u2014 distance from the needle's midpoint to the nearest line, uniform on [0, spacing/2].\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mangle\u001b[22m \u2014 the needle's tilt, uniform on [0, \u03c0/2].\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KA needle crosses a line when center \u2264 (length/2)\u00b7sin(angle). Over many drops the crossing\r\r\n\u001b[1G\u001b[Kprobability converges to 2\u00b7length / (\u03c0\u00b7spacing), which rearranges to the estimator \u03c0 \u2248 2\u00b7N /\r\r\n\u001b[1G\u001b[Kcrossings when length == spacing.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe run landed within\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[38;5;248m41 \u00b7 C\u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  8% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
