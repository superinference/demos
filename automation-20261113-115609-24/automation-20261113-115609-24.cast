[98.108351, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ # Basic Sourdough Bread\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ A simple sourdough loaf at 70% hydration.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ ## Ingredients\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ - 500g bread flour\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ - 350g water (70% hydration)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ - 10g salt\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+ - 100g active sourdough starter\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ ## Steps\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ 1. Mix the flour, water, salt, and starter until no dry flour remains, then let rest.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ 2. Bulk ferment at room temperature for 4 hours, folding the dough every 30-45 minutes.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ 3. Shape the dough, proof, then bake in a preheated Dutch oven at 230\u00b0C until deeply brow\r\r\n\u001b[6G\u001b[K\u001b[2m17  [Auto-formatted]\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Exit code: 0) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mgit_commit\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243m{\"message\":\"first draft: basic sourdough\"}\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m git_commit {\"message\":\"first draft: basic sourdough\"} \u001b[2m32.4s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K        \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m  \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[32m\u2894\u281d\u282b\u2862\u001b[93m\u001b[2m\u2824\u001b[22m\u2839\u287a\u2897\u280f\u001b[39m  \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m                                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[75G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001