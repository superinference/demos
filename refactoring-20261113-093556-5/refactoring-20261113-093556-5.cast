[248.430923, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[32m\u288c\u28c3\u2802\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m          \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[93m\u28c4\u28bf\u28ff\u28e2\u001b[39m \u001b[37m\u28d4\u28f7\u28fe\u28e2\u001b[39m           \u001b[35m\u288c\u28c3\u2802\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u2809\u280a\u2862\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m          \u001b[36m\u287d\u2839\u281f\u28af\u001b[39m               \u001b[93m\u2811\u28bf\u283b\u280b\u001b[2m\u2824\u001b[22m\u001b[37m\u2811\u281f\u283b\u280a\u001b[39m          \u001b[35m\u2814\u284b\u288a\u2863\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[3