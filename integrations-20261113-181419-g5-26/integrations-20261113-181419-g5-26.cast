[148.787561, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[39G\u001b[K\u001b[32m\u001b[39m\u001b[37m\u001b[39m\u001b[36m\u28d5\u284c\u001b[39m                     \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[2m\u2812\u001b[22m\u001b[39m        \u001b[35m\u2811\u2884\u2860\u280a\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m          \u001b[36m\u2879\u281d\u282f\u288b\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m        \u001b[35m\u001b[2m\u283e\u001b[22m\u2814\u2801\u2808\u2822\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m     \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                          \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m             \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[14G\u001b[K\u001b[35m\u001b[2mh\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
