[97.326044, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m4          Find shortest path from start to end using Dijkstra's algorithm.\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m5          Returns (shortest_distance, path).\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m16          \"\"\"\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-         # Initialize distances and parent tracking\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8-         distances = {node: float('inf') for node in self.graph}\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19-         distances[start] = 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20-         parent = {node: None for node in self.graph}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         # Collect all nodes (both sources and destinations)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+         all_nodes = set(self.graph.keys())\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 3 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+         # Initialize distances and parent tracking\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         distances = {node: float('inf') for node in all_nodes}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         distances[start] = 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m26+         parent = {node: None for node in all_nodes}\r\r\n\u001b[7G\u001b[K\u001b[2m7          \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m8          # Min heap: (distance, node)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  29          pq = [(0, start)]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+10\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-4\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250