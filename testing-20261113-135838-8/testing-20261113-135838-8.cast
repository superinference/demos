[49.57948, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import pytest\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from calc import parse_duration\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ @pytest.mark.parametrize(\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     \"value, expected\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     [\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         (\"3h\", 10800),\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         (\"0s\", 0),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         (\"0h\", 0),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     ],\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ )\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ def test_valid_conversions(value, expected):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     assert parse_duration(value) == expected\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+8 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(============================= test session star...) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Percolating \u001b[2m16.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[29G\u001b[K