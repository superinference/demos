[74.838843, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[74.839083, "o", "\u001b[29A\u001b[1G\u001b[K2. \u001b[1mModified Dijkstra's Algorithm:\u001b[22m Instead of minimizing distance, it maximizes the \u001b[3mminimum\u001b[23m edge\r\r\n\u001b[1G\u001b[Kweight (bottleneck) along the entire path. Uses a max-heap (negative values) to explore paths in\r\r\n\u001b[1G\u001b[Korder of decreasing bottleneck capacity.\r\r\n\u001b[E\u001b[1G\u001b[K3. \u001b[1mResults:\u001b[22m The algorithm found that the optimal route from Saffron Bay to Cardamom Reach is:\r\r\n\u001b[1G\u001b[K  \u25e6 \u001b[1mPath:\u001b[22m Saffron Bay \u2192 Pepper Point \u2192 Clove Harbor \u2192 Nutmeg Strait \u2192 Cardamom Reach\r\r\n\u001b[1G\u001b[K  \u25e6 \u001b[1mBottleneck Capacity:\u001b[22m 135 tons (the narrowest leg: Clove Harbor \u2192 Nutmeg Strait)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe script prints the full graph edges with capacities, then displays the optimal path with route\r\r\n\u001b[1G\u001b[Kdetails highlighting the bottleneck edge with the \u25c4\u2500\u2500 marker.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- **Maximum-bottleneck is different from shortest-path:** While Dijkstra finds minimum total cost,\r\r\n\u001b[1G\u001b[Kbottleneck algorithms find the path where the worst link is as good as possible\u2014useful for\r\r\n\u001b[1G\u001b[Klogistics, network resilience, and capacity planning where you need to guarantee throughput through\r\r\n\u001b[1G\u001b[Kthe most-constrained leg.\r\r\n\u001b[1G\u001b[K- **Greedy max-heap exploration works:** By always exploring the path with the highest current\r\r\n\u001b[1G\u001b[Kbottleneck first, we can guarantee optimality\u2014once we reach the destination, we've found the best\r\r\n\u001b[1G\u001b[Kpossible bottleneck, because any other path must have a worse minimum edge.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m Marinating \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python script called\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[18G\u001b[K \u001b[32m\u28e0\u001b[39m\r\r\n\u001b[3G\u001b[K \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m          \u001b[32m\u2898\u28be\u28d7\u2844\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m        \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[3G\u001b[K \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m          \u001b[32m\u2810\u2801\u282b\u2842\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m          \u001b[35m\u2899\u287f\u28bf\u284b\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[7G\u001b[K                                  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m         \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m          \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
