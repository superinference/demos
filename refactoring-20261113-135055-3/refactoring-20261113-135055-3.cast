[23.720734, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;203m-\u001b[39m Crystallizing \u001b[38;5;167m12.6s\u001b[38;5;172m (connecting\u2026)\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[20G\u001b[K \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m             \u001b[36m\u2890\u2842\u001b[39m               \u001b[33m\u001b[2m\u2820\u001b[22m\u28e0\u28b4\u287f\u28c6\u001b[39m           \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[20G\u001b[K \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m             \u001b[36m\u284d\u28a9\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[33m\u2839\u28fe\u2817\u280b\u001b[39m          \u001b[32m\u001b[2m\u2824\u001b[22m\u2894\u281d\u282b\u2862\u001b[39m\r\r\n\u001b[24G\u001b[K\u001b[35m\u001b[2m\u2824\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                   \u001b[32m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[36m\u001b[2mo\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u00