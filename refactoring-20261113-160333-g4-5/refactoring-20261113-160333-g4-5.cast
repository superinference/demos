[70.072491, "o", "\u001b[29A\u001b[E\u001b[13G\u001b[K\u001b[2m\u001b[22mVerification script comparing original and refactored implementations.\"\"\"\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m import sys\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mimport original\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mimport refactored\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m # Test cases: (function_name, test_inputs)\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mTEST_CASES = [\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m(\"fahrenheit_to_celsius\", [32, 212, 98.6, -40, 0]),\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m# Edge cases that should raise ValueError\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mERROR_CASES = [\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m(\"fahrenheit_to_celsius\", -460),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m(\"celsius_to_fahrenheit\", -274),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m(\"kelvin_to_celsius\", -1),\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m]\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[16G\u001b[K\u001b[2m102 more lines)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Noodling \u001b[2m5.7s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called original\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K    \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[32m\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[39m                       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K    \u001b[93m\u2819\u28be\u2877\u280b\u001b[32m\u281d\u282b\u2862\u001b[2m\u2802\u001b[22m\u001b[39m        \u001b[36m\u2869\u288d\u001b[39m                       \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K        \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                      \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b[35G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\