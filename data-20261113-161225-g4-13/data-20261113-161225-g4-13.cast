[50.140165, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ #!/usr/bin/env python3\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ \"\"\"Compute and display summary statistics for 20 daily sales numbers.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ from statistics import mean, median\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ # Inline dataset: sales for 20 consecutive days\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ sales = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     120, 85, 240, 310, 95, 150, 60, 420, 275, 190,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     330, 45, 500, 210, 165, 80, 390, 230, 145, 300,\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     total = sum(sales)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     avg = mean(sales)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     med = median(sales)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     lowest = min(sales)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     highest = max(sales)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     # Top-3 highest days (1-based day index, value), sorted by value desc\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+23 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(========================================) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Simmering \u001b[2m16.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[22G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m       \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[E\u001b[75G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n"]
