[231.027938, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[36G\u001b[K\u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m \u001b[35m\u28b8\u2859\u28d7\u2844\u001b[39m      \u001b[32m\u28c0\u28fa\u28d5\u284c\u001b[39m                \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[36G\u001b[K\u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m \u001b[35m\u28ab\u2843\u28f8\u28cb\u001b[39m      \u001b[32m\u2894\u28fd\u288a\u2876\u001b[39m               \u001b[93m\u001b[2m\u2812\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m         \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m     \u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m                     \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001