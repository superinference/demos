[40.433921, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import unittest\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from citymap import MapSyntaxError, MapValidationError, parse_map, shortest_path\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+ SOURCE = \"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+ place A\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+ place B\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ place C\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ class CityMapTests(unittest.TestCase):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     def test_parser_reads_all_record_types(self):\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m19+         city_map = parse_map(SOURCE)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         self.assertEqual([place.name for place in city_map.places], [\"A\", \"B\", \"C\"])\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+23 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Crystallizing \u001b[2m9.9s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[42G\u001b[K\u001b[