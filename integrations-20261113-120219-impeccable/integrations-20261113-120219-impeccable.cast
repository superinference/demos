[281.001157, "o", "\u001b]2;\u280b AMI \u00b7 Styling an Accessible Button in HTML\u0007"]
[281.049868, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u001b[1mOne-line summary:\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2502 \u001b[3mTurned a bare browser-default button into an accessible primary control: 48px tap target, a \u001b[23m\r\r\n\u001b[1G\u001b[K\u001b[3mlayered\u001b[23m\r\r\n\u001b[1G\u001b[K\u2502 \u001b[3mgradient with honest offset+blur depth, distinct hover/active/disabled states, a keyboard-only\u001b[23m\r\r\n\u001b[3G\u001b[K\u001b[3m:focus-visible ring with a white gap, themed text selection, and a prefers-reduced-motion fallback\u001b[23m\r\r\n\u001b[1G\u001b[K\u001b[3m \u2014\u001b[23m\r\r\n\u001b[1G\u001b[K\u2502 \u001b[3minline CSS, zero external resources.\u001b[23m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- `:focus-visible` (not `:focus`) is the key a11y move: it shows the ring for keyboard users without\r\r\n\u001b[1G\u001b[K flashing it on every mouse click, so you get accessibility without the \"ugly outline\" pushback that\r\r\n\u001b[2G\u001b[Kleads people to wrongly delete focus styles.\r\r\n\u001b[1G\u001b[K- Depth that reads as real uses an *offset + soft blur* shadow plus a 1px inset top highlight; a\r\r\n\u001b[1G\u001b[Kzero-offset colored halo is decoration, not elevation \u2014 the distinction is what separates \"built\"\r\r\n\u001b[1G\u001b[Kfrom \"assembled.\"\r\r\n\u001b[1G\u001b[K- Theming browser-owned surfaces (`::selection`, focus ring, caret) is the cheapest, most-skipped\r\r\n\u001b[1G\u001b[Ksignal that a page was deliberately designed rather than left to UA defaults.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Saut\u00e9ed for 4m 29s \u00b7 done 1:07 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mStyling an Accessible Button \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: type / to open the slash-command palette\u001b[22m\r\r\n\u001b[19G\u001b[K                  \u001b[36m\u001b[2m\u2804\u001b[22m\u2880\u2840\u001b[39m                 \u001b[93m\u2880\u28c0\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u28a0\u28ba\u28d7\u2844\u001b[39m \u001b[37m\u280a\u2810\u2801\u2801\u001b[39m          \u001b[36m\u28f0\u28fd\u28d7\u2844\u001b[39m               \u001b[93m\u28f4\u28bb\u28cf\u2877\u001b[39m               \u001b[35m\u28a0\u28ba\u28d7\u2844\u001b[39m \u001b[37m\u280a\u2810\u2801\u2801\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2814\u283d\u282b\u2873\u001b[2m\u2810\u001b[22m\u001b[39m              \u001b[36m\u281e\u2818\u280b\u28af\u001b[39m               \u001b[93m\u2808\u283b\u280f\u001b[2m\u2809\u001b[22m\u001b[39m               \u001b[35m\u2839\u287f\u28bb\u285f\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m                                                            \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 Ctrl+D \u2026\u001b[22m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[impeccable] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  15% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b"]
