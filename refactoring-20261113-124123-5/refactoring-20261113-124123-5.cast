[150.684017, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[48G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- **Extraction pattern**: The refactoring identifies low-level operations (strip, split, filter) and\r\r\n\u001b[1G\u001b[K elevates them into descriptive helpers; this makes format\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[92m\u28e0\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2898\u28be\u28d7\u2844\u001b[39m             \u001b[36m\u001b[2m\u2802\u001b[22m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m      \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                                   \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2811\u2801\u282b\u2862\u001b[39m              \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m      \u001b[35m\u2899\u287f\u28bf\u284b\u001b[39m                                  \u001b[93m\u001b[2m\u2809\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n\u001b[21G\u001b[K                         \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[3