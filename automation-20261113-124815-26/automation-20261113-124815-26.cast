[30.690669, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Morse code encoder.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ MORSE_CODE_DICT = {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     'A': '.-', 'B': '-...', 'C': '-.-.', 'D': '-..', 'E': '.', 'F': '..-.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     'G': '--.', 'H': '....', 'I': '..', 'J': '.---', 'K': '-.-', 'L': '.-..',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     'M': '--', 'N': '-.', 'O': '---', 'P': '.--.', 'Q': '--.-', 'R': '.-.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     'S': '...', 'T': '-', 'U': '..-', 'V': '...-', 'W': '.--', 'X': '-..-',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     'Y': '-.--', 'Z': '--..', '0': '-----', '1': '.----', '2': '..---',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     '-': '-....-', '_': '..--.-', '\"': '.-..-.', '$': '...-..-', '@': '.--.-.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     ' ': '/'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ }\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ def encode_morse(text):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     \"\"\"Encode text to Morse code.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+14 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Cooking \u001b[2m1.8s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m            \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[55G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m            \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u25