[312.673501, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #include <stdio.h>\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ #include <stdlib.h>\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ #include <string.h>\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ #include <stdbool.h>\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ #define MAX_PATH 10000\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ #define MAX_GRID 30\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ typedef struct {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     int width, height;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     int grid[MAX_GRID][MAX_GRID];\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     int start_x, start_y;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     int end_x, end_y;\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m18+ } Maze;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ typedef struct {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+171 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Noodling \u001b[2m11.2s\