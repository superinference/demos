[55.157712, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+ class BottleneckPathFinder:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     \"\"\"Find the path between two nodes that maximizes the minimum edge weight.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     def __init__(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         self.graph: Dict[str, List[Tuple[str, int]]] = defaultdict(list)\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     def find_max_bottleneck_path(\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+         self, start: str, end: str\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     ) -> Tuple[Optional[List[str]], Optional[int]]:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+         \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         Find the path from start to end that maximizes the minimum edge weight.\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+138 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run the script:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-puGchn && python bottleneck_path.py\u001b[39m\r\r\n\u0