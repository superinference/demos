[67.164536, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+ import json\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ from collections import Counter\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ from statistics import mean\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ # --- Inline survey data -----------------------------------------------------\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ # Replace this string with your actual survey JSON. The report logic below\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     \"site\": \"Willow Creek Wetland\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     \"region\": \"Pacific Northwest\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     \"date\": \"2026-10-18\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     \"surveyors\": [\"A. Rivera\", \"J. Okafor\"],\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     \"area_hectares\": 42.5,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     \"observations\": [\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+       {\"species\": \"Great Blue Heron\", \"type\": \"bird\",    \"count\": 6,  \"status\": \"least_co\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+109 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run it to confirm it works:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Coalescing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K          \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m    \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m         \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K          \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m    \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                               \u001b[35m\u001b[2m\u2820\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m          \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[31G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                                              \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m            \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u