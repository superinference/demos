[47.798192, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ # Inline CSV dataset\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ csv_data = \"\"\"Product,Category,Units,Price\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ Apple,Fruit,150,0.99\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ Banana,Fruit,200,0.59\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ Orange,Fruit,120,0.89\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ Ground Beef,Meat,38,7.49\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ Salmon,Meat,25,12.99\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+ Cheddar Cheese,Dairy,60,5.99\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ Milk,Dairy,120,3.49\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ Yogurt,Dairy,85,4.99\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ Whole Wheat Bread,Bakery,110,2.99\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ Croissant,Bakery,75,1.49\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+33 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run the script:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(+-------------------------+---------------+----...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Crystallizing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[9