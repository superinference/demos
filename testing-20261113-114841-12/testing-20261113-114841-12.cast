[101.440394, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[101.440708, "o", "\u001b[29A\u001b[3G\u001b[KCase-insensitivity, out-of-range values, bad types, and invalid/non-canonical numerals.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mTest result (actual pytest output):\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K============================= 4051 passed in 1.73s =============================\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KExit code 0 \u2014 all tests passed.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The canonical-form check reuses `int_to_roman` as an oracle: rather than hand-coding a regex of\r\r\n\u001b[1G\u001b[Kvalid Roman grammar, we convert back and compare. This catches *all* malformed inputs with one line,\r\r\n\u001b[1G\u001b[K since there's exactly one canonical numeral per integer.\r\r\n\u001b[1G\u001b[K- Excluding `bool` matters because in Python `True` is an `int` (`isinstance(True, int)` is `True`),\r\r\n\u001b[1G\u001b[K so `True + 1 == 2`. Without the explicit `bool` guard, `int_to_roman(True)` would silently return\r\r\n\u001b[1G\u001b[K`\"I\"`.\r\r\n\u001b[1G\u001b[K- The round-trip parametrization turns one assertion into ~3999 independent test cases, giving\r\r\n\u001b[1G\u001b[Kexhaustive coverage of the whole domain for free.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: summary.md (24 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Forged for 1m 30s \u00b7 done 12:50 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mRoman Numerals Converter with\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: press Tab to open the inspector (Shift+Tab cycles back)\u001b[22m\r\r\n\u001b[20G\u001b[K                                     \u001b[93m\u2880\u28c0\u001b[39m\r\r\n\u001b[8G\u001b[K          \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m                \u001b[93m\u28f4\u28bb\u28cf\u2877\u001b[2m\u2824\u001b[22m\u001b[39m              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[8G\u001b[K          \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[93m\u2808\u283b\u280f\u001b[39m                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K   \u001b[32m\u001b[2m\u2808\u001b[22m\u001b[39m                                                       \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 Ctrl+D exit\u001b[22m              \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  10% \