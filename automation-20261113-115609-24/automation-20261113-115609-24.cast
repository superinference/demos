[128.106059, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[20G\u001b[K \u001b[32m\u28a0\u28da\u28d3\u2844\u001b[39m            \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[93m\u2874\u28fb\u28fb\u286c\u001b[39m               \u001b[35m\u2825\u28fa\u2892\u28ed\u001b[39m\r\r\n\u001b[20G\u001b[K \u001b[32m\u2890\u280d\u282b\u2862\u001b[2m\u2836\u001b[22m\u001b[39m          \u001b[36m\u001b[2m\u2804\u001b[22m\u287d\u2839\u280f\u28af\u001b[39m              \u001b[93m\u001b[2m\u2824\u001b[22m\u2869\u28af\u2805\u2875\u001b[39m               \u001b[35m\u28e3\u2857\u2818\u284e\u001b[39m \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K                                       \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;21