[303.100198, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[303.101073, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ \"\"\"Render the maze to a PNG so the colors are visible outside a terminal.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from PIL import Image\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ import maze\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ grid = maze.carve(seed=7)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ start = (1, 1)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ goal = (maze.W - 2, maze.H - 2)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ dist, path = maze.bfs(grid, start, goal)\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ img = Image.new(\"RGB\", (maze.W * SCALE, maze.H * SCALE))\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ px = img.load()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def put(x, y, color):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     for i in range(SCALE):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         for j in range(SCALE):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+             px[x * SCALE + i, y * SCALE + j] = color\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(wrote maze.png (816, 496) | path length: 373) 0.1s\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u001b[39m\u001b[2mfile_read({\"type\":\"image\",\"source\":{\"type\":\"base64\",\"medi...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Noodling \u001b[2m31.8s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K        \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m      \u001b[33m\u28e0\u28be\u2877\u28c4\u001b[39m                    \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m      \u001b[33m\u2819\u28be\u2877\u280b\u001b[39m                    \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[35G\u001b[K  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m                        \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r"]
