[35.26181, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[35.262306, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ def dijkstra(graph, start, goal):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     # Shortest tentative distance to each node, plus how we got there.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     dist = {node: float(\"inf\") for node in graph}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     prev = {node: None for node in graph}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     dist[start] = 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     visited = set()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     while len(visited) < len(graph):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         # Pick the unvisited node with the smallest known distance.\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         if current is None or dist[current] == float(\"inf\"):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+             break\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         visited.add(current)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         # Relax every edge leaving the current node.\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+         for neighbor, weight in graph[current].items():\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+             new_dist = dist[current] + weight\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+31 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Shortest path from A to E: A -> C -> B -> E) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Percolating \u001b[2m0.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[24G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m         \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                 \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[24G\u001b[K \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2804\u001b[22m\u001b[39m     \u001b[36m\u001b[2m\u2820\u001b[22m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m         \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                 \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[25G\u001b[K \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[35.351997, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[32m\u2880\u28fa\u28d3\u2840\u001b[39m  \u001b[37m\u280a\u2811\u001b[39m   \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m            \u001b[93m\u28c0\u28be\u28f7\u28c0\u001b[39m \u001b[37m\u2814\u2813\u281a\u2802\u001b[39m          \u001b[35m\u2880\u28fa\u28d3\u2840\u001b[39m  \u001b[37m\u280a\u2811\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u2814\u283d\u282b\u2862\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m           \u001b[93m\u001b[2m\u2812\u001b[22m\u2819\u28be\u2837\u280b\u001b[39m               \u001b[35m\u2819\u287f\u28bb\u284b\u001b[39m\r\r\n\u001b[73G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b