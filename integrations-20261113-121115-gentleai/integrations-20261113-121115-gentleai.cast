[100.068805, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[4G\u001b[K \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m         \u001b[32m\u2868\u287b\u2866\u2840\u001b[39m              \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m\r\r\n\u001b[4G\u001b[K\u001b[93m\u001b[2m\u2812\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m         \u001b[32m\u2808\u001b[2m\u2820\u001b[22m\u289f\u2885\u001b[39m              \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[8G\u001b[K \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m           \u001b[32m\u2801\u001b[39m                \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m           \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[100.117508, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u2502 \u001b[1mLead with the answer\u001b[22m    \u2502 Title states the outcome (\"check network latency in one command\"); fir \u2502\r\r\n\u001b[1G\u001b[K\u2502                         \u2502 st paragraph says what it does and who it helps before any detail.     \u2502\r\r\n\u001b[1G\u001b[K\u2502 \u001b[1mProgressive disclosure\u001b[22m  \u2502 Quick path (install + happy path) \u2192 Common options \u2192 Scripting \u2192 Exit  \u2502\r\r\n\u001b[1G\u001b[K\u2502                         \u2502 codes \u2192 edge-case verification.                                        \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mChunking\u001b[22m                \u2502 Short, single-purpose sections; no long flat lists.                    \u2502\r\r\n\u001b[1G\u001b[K\u2502 \u001b[1mSignposting\u001b[22m             \u2502 Clear ## headings label every zone.                                    \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mRecognition over recall\u001b[22m \u2502 Three tables (options, exit codes) + runnable examples + a verificatio \u2502\r\r\n\u001b[29G\u001b[Kn checklist instead of prose.                                          \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mReview empathy\u001b[22m          \u2502 Checklist and expected-output blocks let a reader confirm correctness  \u2502\r\r\n\u001b[29G\u001b[Kwithout reconstructing intent.                                         \u2502\r\r\n\u001b[1G\u001b[K\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe structure also matches the skill's default \u001b[1mDocumentation Shape\u001b[22m: outcome title \u2192 one-paragraph\r\r\n\u001b[1G\u001b[Kintro \u2192 Quick path \u2192 Details (as tables) \u2192 Checklist \u2192 Next step.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KOne small judgment call worth noting: the skill's template uses a numbered Quick path, but I used a\r\r\n\u001b[1G\u001b[Kcopy-paste command block instead. For a CLI tool, runnable commands are a stronger form of\r\r\n\u001b[1G\u001b[K\"recognition over recall\" than numbered prose \u2014 the reader can execute rather than translate. That's\r\r\n\u001b[1G\u001b[Kan intentional adaptation, which the skill explicitly permits (\"unless the repo already provides a\r\r\n\u001b[1G\u001b[Kstronger template\").\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNo ed\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mInvoke the cognitive-doc-desi\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;22"]
