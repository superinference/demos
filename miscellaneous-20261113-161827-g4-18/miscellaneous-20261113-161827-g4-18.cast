[66.982288, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[66.983697, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ \"\"\"Procedural fractal mountain landscape rendered as ASCII art.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ Pure standard library. The terrain is built with the midpoint-displacement\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ (diamond-square in 1D) algorithm, then composited into a scene with a starry\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ sky, layered mountain ridges, trees, and a reflecting lake.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ import math\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ def midpoint_displacement(width, roughness, height_scale, seed_low, seed_high):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     \"\"\"Return a height array of length `width` via 1D midpoint displacement.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     Start with two endpoints, repeatedly find the midpoint of every segment,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     set it to the average of its neighbours plus a random offset whose range\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     shrinks by `roughness` each pass. This self-similar refinement is what\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     gives the ridge its fractal, natural look.\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+129 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(+----------------------------------------------...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Coalescing \u001b[2m16.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[17G\u001b[K                                                         \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m   \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m                                 \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m         \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n\u001b[75G\u001b[K     "]
