[73.316494, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[21G\u001b[K \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m            \u001b[36m\u28a0\u28ff\u2844\u001b[32m\u28fa\u28d5\u286c\u001b[39m       \u001b[35m\u001b[2m\u2837\u001b[22m\u28a4\u287a\u28c3\u28c4\u001b[39m\r\r\n\u001b[21G\u001b[K \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m          \u001b[36m\u2879\u283b\u288b\u001b[32m\u285f\u283f\u2850\u001b[39m        \u001b[35m\u2859\u2867\u28da\u284b\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m    \u001b[36m\u001b[2m\u2804\u001b[32m\u283e\u001b[22m\u001b[39m          \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u