[86.614733, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ # quickping\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ Check network latency from the command line. Fast, minimal, readable.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ ```bash\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ $ quickping google.com\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ google.com: 12ms (avg over 5 pings)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ ```\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 5 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ # Linux\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ curl -L https://github.com/user/quickping/releases/latest/download/quickping-linux -o qui\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ chmod +x quickping\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ sudo mv quickping /usr/local/bin/\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+111 more lines)\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m2  [Auto-formatted]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588