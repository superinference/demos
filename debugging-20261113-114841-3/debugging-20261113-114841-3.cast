[216.096297, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K                                    \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[23G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m            \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[33m\u28f0\u28bf\u2866\u28c4\u001b[39m        \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u283e\u001b[22m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m              \u001b[33m\u2809\u283a\u28f7\u281f\u001b[39m      \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[27G\u001b[K\u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m        \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                   \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2