[147.268702, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u001b[1mOutput (13 combos, identical from both scripts):\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[Kcircle    red     -> a red circle: like a ripe apple\r\r\n\u001b[1G\u001b[Kcircle    yellow  -> a circle of unknown color      (fallback: unknown color)\r\r\n\u001b[1G\u001b[Ksquare    blue    -> a blue square: like a window\r\r\n\u001b[1G\u001b[Ktriangle  orange  -> a triangle of unknown color    (fallback: unknown color)\r\r\n\u001b[1G\u001b[Khexagon   red     -> an unknown shape                (fallback: unknown shape)\r\r\n\u001b[1G\u001b[K... (all 13 match)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mDiff:\u001b[22m empty \u2192 \u001b[1mNO DIFFERENCES, outputs match exactly\u001b[22m \u2705\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mLine counts:\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\r\n\u001b[1G\u001b[K\u2502 File                        