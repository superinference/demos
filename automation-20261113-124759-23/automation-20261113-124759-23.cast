[114.270403, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ def main():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     text = 'HELLO WORLD'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     print(f\"Original text: {text}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     print(f\"Decoded text: {decoded}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     if text == decoded:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         print(\"\\n\u2713 Round-trip successful!\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     else:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+         print(\"\\n\u2717 Round-trip failed!\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+2 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run main.py to verify the round-trip works:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Original text: HELLO WORLD) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Cooking \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[92m\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m               \u001b[36m\u