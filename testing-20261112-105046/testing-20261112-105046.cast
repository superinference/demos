[28.311882, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ from string_utils import normalize_whitespace\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ class NormalizeWhitespaceTests(unittest.TestCase):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     cases = [\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+         (\"   \\t\\n\", \"\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+         (\"one\\u00a0two\", \"one two\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+         (\" leading and trailing \", \"leading and trailing\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     def test_normalizes_representative_and_edge_cases(self):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         for value, expected in self.cases:\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n"]
[28.311977, "o", "\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(8/8 cases passed) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K- `string_utils.py` \u2014 self-contained `normalize_whitespace()` utility using only the standard\r\r\n\u001b[1G\u001b[Klibrary.\r\r\n\u001b[1G\u001b[K-\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m \u001b[22m\u001b[38;5;75m\u2191 51 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mIn the current directory, cre\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[92m\u28a0\u28fa\u28d7\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m             \u001b[36m\u2890\u2842\u001b[2m\u2820\u001b[22m\u001b[39m                                  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[92m\u2894\u281d\u282b\u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2809\u001b[22m\u001b[39m            \u001b[36m\u284d\u28a9\u001b[39m                                   \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[92m\u001b[2m\u2804\u001b[93m\u2824\u001b[22m\u001b[39m               \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b