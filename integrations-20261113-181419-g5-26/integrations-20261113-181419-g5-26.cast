[173.552434, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[21G\u001b[K \u001b[32m\u28ae\u28f3\u2897\u284d\u001b[39m         \u001b[36m\u001b[2m\u2820\u001b[22m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m              \u001b[33m\u28f4\u28bf\u2866\u28c0\u001b[39m             \u001b[35m\u28a0\u287a\u2887\u2846\u001b[39m\r\r\n\u001b[21G\u001b[K \u001b[32m\u2890\u281d\u283b\u28d3\u001b[2m\u2837\u001b[22m\u001b[39m         \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m          \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m   \u001b[33m\u2839\u287a\u2897\u280f\u001b[39m             \u001b[35m\u2889\u283f\u28be\u284d\u001b[39m  \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[23G\u001b[K\u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                   \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u