[86.797145, "o", "\u001b[29A\u001b[1G\u001b[KGenerated files:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 signal_garden.py\r\r\n\u001b[1G\u001b[K\u2022 test_signal_garden.py\r\r\n\u001b[1G\u001b[K\u2022 signal_garden_report.svg\r\r\n\u001b[E\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- Median and MAD remain stable when isolated spikes distort ordinary mean-and-standard-deviation\r\r\n\u001b[1G\u001b[Kstatistics.\r\r\n\u001b[1G\u001b[K- Drift detection uses the sensor\u2019s known noise floor because a long trend can otherwise inflate the\r\r\n\u001b[1G\u001b[K local MAD and conceal itself.\r\r\n\u001b[3G\u001b[KThe project is reproducible: the same seed produces identical telemetry and identical anomaly\r\r\n\u001b[1G\u001b[Klocations.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: included.md (60 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Forged for 1m 13s \u00b7 done 11:03 AM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[1.4m | 111022 tokens | $0.01] Done in 12 turns \u00b7 done 11:03 AM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[67G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;35mSignal Garden Observatory: Te\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[7G\u001b[K\u001b[2mPageUp and PageDown scroll back through the transcript\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[92m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2890\u2842\u2804\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2869\u288d\u001b[22m\u001b[39m                                  \u001b[93m\u001b[2m\u28f0\u001b[35m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[21G\u001b[K                                                     \u001b[93m\u001b[2m\u2819\u001b[35m\u282a\u282d\u282d\u2815\u2810\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[36m\u001b[2m Explorer  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
