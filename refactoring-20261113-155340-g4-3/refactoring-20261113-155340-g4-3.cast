[81.368102, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[KNow let's run the tests to confirm they pass:\r\r\n\u001b[1G\u001b[K\u001b[38;5;35m|\u001b[39m Running cd /tmp/ami-demo-KujIVj && python -m pyt \u00b7 72 chars \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m \u001b[22m\u001b[38;5;75m\u2191 63 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called app.py c\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[32m\u001b[2m\u2809\u001b[22m\u001b[39m       \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u284d\u28a9\u001b[39m                                 \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[20G\u001b[K       \u001b[32m\u001b[2m\u2824\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                               \u001b[35m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;