[146.974998, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\r\n\u001b[1G\u001b[K\u2502 Component         \u2502 How it works                                                                 \u2502\r\r\n\u001b[1G\u001b[K\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\r\n\u001b[1G\u001b[K\u2502 \u001b[1mSDFs\u001b[22m              \u2502 sd_sphere (distance to center minus radius) and sd_plane (signed height); sc \u2502\r\r\n\u001b[3G\u001b[K                  \u2502 ene() unions them with min                                                   \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mRaymarching\u001b[22m       \u2502 raymarch() sphere-traces: step along the ray by the current SDF value until  \u2502\r\r\n\u001b[3G\u001b[K                  \u2502 it's within SURF_EPS of a surface or escapes                                 \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mNormals\u001b[22m           \u2502 estimate_normal() uses the gradient of the SDF via central differences       \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mSoft shadows\u001b[22m      \u2502 soft_shadow() marches toward the light and tracks the \u001b[3mclosest approach ratio\u001b[23m \u2502\r\r\n\u001b[3G\u001b[K                  \u2502  k*d/t \u2014 near-misses produce penumbra instead of a hard 0/1 edge             \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mAmbient occlusion\u001b[22m \u2502 ambient_occlusion() samples the SDF at increasing offsets along the normal;  \u2502\r\r\n\u001b[3G\u001b[K                  \u2502 where geometry cr                                                            \u2502\r\r\n\u001b[E\u001b[20G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m2 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a self-contained Pytho\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;21