[226.791403, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 0  Created new file: /tmp/ami-demo-yCN1wP/probe.py\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m 1  Successfully wrote /tmp/ami-demo-yCN1wP/probe.py (new file, 17 lines)\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import yaml\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ tests = [\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3+     (\"python/tuple\",       \"v: !!python/tuple [1, 2, 3]\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+     (\"python/name sys\",    \"v: !!python/name:os.system\"),\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m 5+     (\"python/module os\",   \"v: !!python/module:os\"),\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     (\"python/object/new\",  \"v: !!python/object/new:complex [3, 4]\"),\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ ]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ for label, doc in tests:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     for loader in (\"FullLoader\", \"safe\"):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m10+         try:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m11+             if loader == \"FullLoader\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m12+                 d = yaml.load(doc, Loader=yaml.FullLoader)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m13+             else:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+                 d = yaml.safe_load(doc)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+             print(f\"{label:20} {loader:10} -> OK      {d!r}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+         except Exception as e:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+             print(f\"{label:20} {loader:10} -> BLOCKED ({type(e).__name__})\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\