[73.148777, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[1G\u001b[KUnit Converter Results\r\r\n\u001b[1G\u001b[K========================================\r\r\n\u001b[1G\u001b[K5 km = 3.107 mi\r\r\n\u001b[1G\u001b[K100 lb = 45.359 kg\r\r\n\u001b[1G\u001b[K36.6 C = 97.880 F\r\r\n\u001b[1G\u001b[K========================================\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mFiles Created\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[2G\u001b[K. \u001b[1mconversions.py\u001b[22m - Three conversion functions using standard conversion factors\r\r\n\u001b[1G\u001b[K2. \u001b[1mformatter.py\u001b[22m - A reusable formatter that creates \"X unit = Y.ZZZ unit\" strings with 3 decimal\r\r\n\u001b[1G\u001b[Kplaces\r\r\n\u001b[1G\u001b[K3. \u001b[1mconvert.py\u001b[22m - The main CLI that imports both modules and runs the three requested conversions\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KEach conversion is accurate:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 5 kilometers = 3.107 miles\r\r\n\u001b[1G\u001b[K\u2022 100 pounds = 45.359 kilograms\r\r\n\u001b[1G\u001b[K\u2022 36.6 Celsius = 97.880 Fahrenheit (normal human body temperature)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250