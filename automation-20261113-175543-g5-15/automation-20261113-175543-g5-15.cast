[137.422567, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[KDiscount_Percent |  20   |    0.00    |   35.00    |   12.25    |   10.00    |    9.59\r\r\n\u001b[1G\u001b[K-----------------------------------------------------------------------------------------\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe tool correctly:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 Identified all 4 numeric columns (skipped the non-numeric \"Product\" column)\r\r\n\u001b[3G\u001b[KCounted all 20 data rows\r\r\n\u001b[5G\u001b[Kmputed accurate min/max, mean, median, and standard deviation for each column\r\r\n\u001b[3G\u001b[KFormatted the output as a centered ASCII table\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The tool uses Python's built-in `statistics` module for median and stdev to avoid external\r\r\n\u001b[1G\u001b[Kdependencies\u2014simple, reliable, and sufficient for this use case\r\r\n\u001b[1G\u001b[K- Numeric detection via try-cast (`float()`) is flexible and handles various number formats\r\r\n\u001b[1G\u001b[Knaturally\r\r\n\u001b[1G\u001b[K- Using `defaultdict` to collect per-column values is cleaner than manual None-checking and makes\r\r\n\u001b[1G\u001b[Kthe code maintainable\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: files-created.md (40 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Crafted for 2m 6s \u00b7 done 6:59 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mcsvstats.py - CSV Column Stat\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: /model switches the active model mid-session\u001b[22m\r\r\n\u001b[18G\u001b[K                                       \u001b[93m\u2880\u28c0\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[93m\u28f4\u28bb\u28cf\u2877\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u001b[2m\u2820\u001b[22m\u2869\u288d\u001b[39m                \u001b[93m\u2808\u283b\u280f\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K \u001b[92m\u001b[2m\u2808\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r"]
