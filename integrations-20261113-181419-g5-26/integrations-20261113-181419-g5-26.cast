[159.16034, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[8G\u001b[K\u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2836\u001b[22m\u001b[39m                        \u001b[36m\u28a3\u28fb\u28f7\u2844\u001b[39m               \u001b[93m\u28aa\u2838\u2837\u2887\u001b[39m                            \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u2899\u287f\u28bf\u284b\u001b[39m                         \u001b[36m\u2879\u281c\u282f\u289e\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[93m\u28ef\u28f9\u2885\u2856\u001b[39m                            \u001b[32m\u2890\u281d\u282b\u2842\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m                          \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                   \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                                 \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;2