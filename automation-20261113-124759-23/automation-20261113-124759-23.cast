[202.604433, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502  10      '----.': '9', '.-.-.-': '.', '--..--': ',', '..--..': '?',\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m11      '.----.': \"'\", '-.-.-.': ';', '-.-.-': ':', '---...': '/',\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m12      '-..-.': '/', '..--.-': '_', '.-..-.': '\"', '-.--.': '(',\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13-     '-.--.-': ')', '.-.-.-': '.', ' ': ' '\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14- }\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16- CHAR_TO_MORSE = {v: k for k, v in MORSE_TO_CHAR.items()}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7- CHAR_TO_MORSE[' '] = '/'  # Space character maps to '/'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     '-.--.-': ')', '/': ' '\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ CHAR_TO_MORSE = {v: k for k, v in MORSE_TO_CHAR.items()}\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's test again:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Original text: HELLO WORLD) 0.0s\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KPerfect! The Morse code translator is now working. Let me verify all the files are in place:\r\r\n\u001b[E\u001b[15G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u001b[39m\u001b[2m-rw-rw-r-- 1 ccamacho ccamacho 566 Nov 13 13:49...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Cooking \u001b[2m