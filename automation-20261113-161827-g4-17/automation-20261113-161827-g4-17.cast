[173.816583, "o", "\u001b]2;\u2807 AMI \u00b7 Initialize a git repo in the current directory. Create a ...\u0007\u001b]2;\u280b AMI \u00b7 Git repo setup with hello.py and commits\u0007\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K                                                        \u001b[33m\u2880\u2840\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[92m\u28ba\u28d7\u2844\u001b[39m \u001b[37m\u280a\u2810\u2801\u2801\u001b[39m           \u001b[36m\u28a0\u28ff\u2844\u001b[39m               \u001b[33m\u28f4\u28bb\u28e7\u2840\u001b[39m               \u001b[35m\u28a0\u28ba\u28d7\u2844\u001b[2m\u2820\u001b[22m\u001b[37m\u280a\u2810\u2801\u2801\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[92m\u001b[2m\u2808\u001b[22m\u2814\u283d\u282b\u2873\u001b[39m                \u001b[36m\u287d\u283f\u28af\u001b[39m   \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m           \u001b[33m\u2808\u283b\u28a7\u281f\u001b[39m               \u001b[35m\u2839\u287f\u28bb\u285f\u001b[39m\r\r\n\u001b[21G\u001b[K \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m               \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                       \u001b[35m\u001b[2m\u2808\u001b[22m\u001b[39m\r\r\n\u001b[