[69.223302, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ {\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+   \"Widget A\": {\"Q1\": 12500, \"Q2\": 15800, \"Q3\": 14200, \"Q4\": 19300},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+   \"Widget B\": {\"Q1\":  8700, \"Q2\":  9200, \"Q3\": 11500, \"Q4\": 10400},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+   \"Widget C\": {\"Q1\": 21000, \"Q2\": 18600, \"Q3\": 23400, \"Q4\": 25100}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ \"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ def main():\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     data = json.loads(SALES_JSON)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     header = f\"{'Product':<12}\" + \"\".join(f\"{q:>10}\" for q in QUARTERS)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     header += f\"{'Total':>12}{'Best':>8}\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     sep = \"-\" * len(header)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+28 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Product Q1 Q2 Q3 Q4 ...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe script works. Here's the output:\r\r\n\u001b[1G\u001b[K```\r\r\n\u001b[1G\u001b[KProduct             Q1        Q2\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m \u001b[22m\u001b[38;5;75m\u2191 33 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called sales.py\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[38;5;248m401 \u00b7 C\u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  8% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u