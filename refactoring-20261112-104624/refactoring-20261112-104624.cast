[21.47084, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Demonstrate replacing duplicated record-formatting logic with a helper.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ records = [\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+     {\"name\": \"Ada\", \"score\": 98},\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     {\"name\": \"Linus\", \"score\": 91},\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     {\"name\": \"Grace\", \"score\": 95},\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ ]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     return \"\\n\".join(lines)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ def original_second(records):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     lines = []\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     for index, record in enumerate(records, start=1):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         lines.append(f\"{index}. {record['name']}: {record['score']}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+21 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25