[37.522908, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[37.523335, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+         if color == \"red\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+             return \"a red circle: like a ripe apple\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+         elif color == \"green\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+             return \"a green circle: like a lime\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+         elif color == \"blue\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+             return \"a blue circle: like a marble\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+         else:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+         elif color == \"green\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+             return \"a green square: like a tile\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+         elif color == \"blue\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+             return \"a blue square: like a window\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         else:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+             return \"a square of unknown color\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     elif shape == \"triangle\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+30 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25