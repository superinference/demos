[77.804791, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[77.805286, "o", "\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KUnsorted list:\r\r\n\u001b[1G\u001b[K[3, 79, 76, 14, 8, 91, 75, 72, 84, 16, 56, 54, 75, 35, 37, 52, 23, 76, 18, 68]\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KSorted list:\r\r\n\u001b[1G\u001b[K[3, 8, 14, 16, 18, 23, 35, 37, 52, 54, 56, 68, 72, 75, 75, 76, 76, 79, 84, 91]\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe quicksort implementation correctly sorted all 20 random integers in ascending order. The\r\r\n\u001b[1G\u001b[Kalgorithm uses the middle element as the pivot and partitions the array into three groups (left,\r\r\n\u001b[1G\u001b[Kmiddle with duplicates, right), then recursively sorts and combines them.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- **Three-way partition:** Separating equal elements prevents redundant recursive calls on\r\r\n\u001b[1G\u001b[Kduplicates, improving performance when the list has many repeated values.\r\r\n\u001b[1G\u001b[K- **Base case:** Arrays of length 0 or 1 are already sorted, so recursion terminates naturally\r\r\n\u001b[1G\u001b[Kwithout needing explicit empty checks.\r\r\n\u001b[1G\u001b[K- **Functional approach:** Using list comprehensions creates new lists rather than mutating the\r\r\n\u001b[1G\u001b[Koriginal, making the code clearer but using more memory than in-place quicksort variants.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Saut\u00e9ed for 1m 6s \u00b7 done 5:05 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mQuicksort Implementation Demo\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: the Usage inspector tab breaks down tokens and cost\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m    \u001b[36m\u2890\u2842\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m      \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m    \u001b[36m\u2869\u288d\u001b[39m                                   \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2808\u001b[22m\u001b[39m\r\r\n\u001b[50G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m                          \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 /help \u00b7 Ctrl+D exit\u001b[22m      \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  8% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39