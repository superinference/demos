[203.183934, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m5-     \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-     if not isinstance(records, list):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-         raise TypeError(\"records must be a list\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-     results = []\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10-\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 24 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     Validate that a field is a non-empty string, trim whitespace, and return it.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     Raises ValueError if empty or whitespace-only.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     _validate_required_field(record, field_name, record_type, str)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     trimmed = record.get(field_name).strip()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m0+     if len(trimmed) == 0:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m21+         raise ValueError(f\"{record_type} '{field_name}' cannot be whitespace-only\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  22  ... (+77 more added)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KPerfect! Now let's run the tests to verify everything still works:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(============================= test session star...) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Conjuring \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[2m\u2812\u001b[22m\u001b[39m         \u001b[36m\u2808\u28ca\u28fe\u2813\u001b[39m                                  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2836\u001b[22m\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m          \u001b[36m\u287d\u2890\u2887\u2861\u001b[2m\u2820\u001b[22m\u001b[39m                                 \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[79G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m6% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
