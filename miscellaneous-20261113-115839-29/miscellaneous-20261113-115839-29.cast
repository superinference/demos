29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m           \u001b[36m\u2890\u2842\u001b[39m                                   \u001b[35m\u282a\u2810\u2805\u2807\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[93m\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u282a\u282d\u282d\u2815\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m           \u001b[36m\u284d\u28a9\u001b[39m                                   \u001b[35m\u282a\u282d\u282d\u2815\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[93m\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[41G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                   \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m      \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[12G\u001b[K\u001b[32m\u001b[2ml\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.supe"]
[89.495647, "o", "rinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l\u001b]2;\u283c AMI \u00b7 Morse Code Encoder/Decoder Demo Script\u0007"]
[89.502826, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[89.502978, "o", "\u001b[29A\u001b[1G\u001b[K6. \u001b[1mSide-by-Side Table\u001b[22m \u2014 Shows original word \u2192 Morse \u2192 decoded word for all 7 words\r\r\n\u001b[1G\u001b[K7. \u001b[1mRound-Trip Verification\u001b[22m \u2014 \u001b[1mPASS \u2713\u001b[22m confirms perfect encoding\u2192decoding cycle\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe output demonstrates the full pipeline: plain text \u2192 Morse code \u2192 plain text, with a clean table\r\r\n\u001b[1G\u001b[Kand final verdict.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- **Round-trip encoding/decoding** requires both a forward dict and its reverse; dict comprehension\r\r\n\u001b[1G\u001b[Kmakes the reverse mapping trivial and less error-prone than manual creation\r\r\n\u001b[1G\u001b[K- **Word-level separators** (using \"/\" in the full Morse output) mirror Morse convention where\r\r\n\u001b[1G\u001b[Kspaces separate letters and slashes separate words \u2014 clarity in the encoded format\r\r\n\u001b[5G\u001b[KVerification by equality check** (original == decoded) is the gold standard for codec\r\r\n\u001b[1G\u001b[Kcorrectness; if even one character fails to round-trip, it immediately shows FAIL\r\r\n"]
[89.503014, "o", "\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: summary.md (21 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Saut\u00e9ed for 1m 16s \u00b7 done 1:00 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[1.5m | 26986 tokens | $0.02] Done in 3 turns \u00b7 done 1:00 PM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[7G\u001b[K\u001b[2mstart a line with ! to run a shell command\u001b[22m\r\r\n\u001b[1G\u001b[K                                                        \u001b[93m\u001b[2m\u2880\u2840\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2890\u2842\u001b[22m\u001b[39m                \u001b[93m\u001b[2m\u28f4\u28bb\u28e7\u2840\u2824\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2869\u288d\u001b[22m\u001b[39m                \u001b[93m\u001b[2m\u2808\u283b\u28a7\u281f\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[20G\u001b[K                                                       \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u2808\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[36m\u001b[2m Explorer  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
