[130.673126, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[130.673471, "o", "\u001b[29A\u001b[1G\u001b[K\u2022 \"Common Use Cases\" shows goals mapped to exact commands (copy-paste ready)\r\r\n\u001b[4G\u001b[KTroubleshooting\" gives symptoms and solutions without forcing users to remember context\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mChunking\u001b[22m: Each section has a single, clear purpose. Options are kept to 5 flags. Date format\r\r\n\u001b[1G\u001b[Kexamples are bulleted, not buried in prose.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mSignposting\u001b[22m: Headings scan quickly. The reader always knows whether they're in setup, reference, or\r\r\n\u001b[1G\u001b[Kproblem-solving mode.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe README is \u001b[1m75 lines\u001b[22m total\u2014concise enough to read in under 2 minutes, comprehensive enough to\r\r\n\u001b[1G\u001b[Kanswer 80% of questions without reading the code.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- Cognitive-load-optimized docs frontload actions over explanations; users scanning for \"how do\r\r\n\u001b[1G\u001b[KI...\" find their answer in the first table, not paragraph five\r\r\n\u001b[1G\u001b[K- Tables outperform prose for tool docs because they externalize memory\u2014users recognize their goal\r\r\n\u001b[1G\u001b[Kin the left column rather than recalling syntax from a wall of text\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: how-it-applies-the-skill-s-patterns.md (22 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Worked for 1m 59s \u00b7 done 7:09 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCLI tool README for logslice \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: click a \u25b6 row, or press Ctrl+T, to expand every component\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                                  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[40G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\r\r\n"]
