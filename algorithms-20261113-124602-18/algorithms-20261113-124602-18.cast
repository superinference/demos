[30.435332, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import math\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ import random\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ def estimate_e(trials):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     total = 0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     for _ in range(trials):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+         s = 0.0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+         count = 0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     return total / trials\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ def main():\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     trials = 5_000_000\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     estimate = estimate_e(trials)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     true_e = math.e\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+8 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Simmering \u001b[2m18.9s\u001b[22m\r\r\n\u001b[E\u001