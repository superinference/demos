[70.693787, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K \u001b[32m\u2884\u28e3\u280a\u001b[39m \u001b[37m\u2810\u2884\u2860\u280a\u001b[39m          \u001b[36m\u28a4\u28f8\u28d7\u2844\u001b[39m               \u001b[93m\u2874\u28bd\u28b0\u28ad\u001b[2m\u2812\u001b[22m\u001b[39m               \u001b[35m\u2884\u28e3\u280a\u001b[39m \u001b[37m\u2810\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u2809\u280a\u2862\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m          \u001b[36m\u2879\u281d\u282f\u289b\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[93m\u001b[2m\u2824\u001b[22m\u28f9\u287a\u28d7\u287e\u001b[39m               \u001b[35m\u2814\u280b\u288a\u2863\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m                     \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                    \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[2m.\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001