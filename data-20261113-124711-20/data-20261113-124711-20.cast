[101.372522, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m2-     print(\"\\n\" + \"=\" * 80)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3-     print(f\"{'Rank':<5} {'Drink':<15} {'Mean':<10} {'Median':<10} {'7-Day Trend':<20}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4-     print(\"=\" * 80)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-     for rank, (drink, mean, median, sales) in enumerate(stats_list, 1):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m57-         marker = \"\u2605\" if rank <= 3 else \" \"\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 9 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         marker = \"\u2605\" if rank <= 3 else \" \"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         spark = sparkline(sales)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m59+         print(f\"{marker:<3} {rank:<5} {drink:<15} {mean:<10.2f} {median:<10.1f} {spark}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m0+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m61+     print(\"=\" * 90 + \"\\n\")\r\r\n\u001b[7G\u001b[K\u001b[2m2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m3  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  64  if __name__ == \"__main__\":\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+10\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-10\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it again to show the final output with the \u2605 markers:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[