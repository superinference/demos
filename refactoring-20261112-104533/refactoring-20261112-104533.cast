[25.592272, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ \"\"\"Run both classifiers and compare their output.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ import subprocess\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ import sys\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+ SCRIPTS = (\"nested_classifier.py\", \"data_driven_classifier.py\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         capture_output=True,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         text=True,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     )\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     return result.stdout.strip().splitlines()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ nested, data_driven = (run(script) for script in SCRIPTS)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+12 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Cooking \u001b[2m8.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[2G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m            \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m           \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m              \u001b[36m\u001b[2m\u2820\u001b[22m\u2879\u282d\u283b\u282d\u288b\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m                 \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[35m\u001b[2m Hype  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
