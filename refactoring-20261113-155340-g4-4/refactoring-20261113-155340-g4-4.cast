[36.290715, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ _STATUS = {\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     100: '100 Continue',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     101: '101 Switching Protocols',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     200: '200 OK',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     201: '201 Created',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     204: '204 No Content',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+     301: '301 Moved',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+     302: '302 Found',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     304: '304 Not Modified',\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     500: '500 Internal Server Error',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     502: '502 Bad Gateway',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     503: '503 Service Unavailable',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ }\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ _CLASS = {1: 'Informational', 2: 'Success', 3: 'Redirect',\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m20+           4: 'Client Error', 5: 'Server Error'}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+10 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Conjuring \u001b[2m3.0s\u001b[22m\r\r\