[120.505753, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K-----------------------------------------------------------------------------------------\r\r\n\u001b[1G\u001b[K     Column      | Count |    Min     |    Max     |    Mean    |   Median   |  Std Dev\r\r\n\u001b[1G\u001b[K-----------------------------------------------------------------------------------------\r\r\n\u001b[1G\u001b[K   Units_Sold    |  20   |   54.00    |   312.00   |   147.45   |   139.50   |   70.66\r\r\n\u001b[1G\u001b[K     Price       |  20   |   12.75    |   145.00   |   49.77    |   35.50    |   37.71\r\r\n\u001b[1G\u001b[K    Revenue      |  20   |  3000.00   |  11020.00  |  5535.72   |  5305.72   |  2141.11\r\r\n\u001b[1G\u001b[KDiscount_Percent |  20   |    0.00    |   35.00    |   12.25    |   10.00    |    9.59\r\r\n\u001b[1G\u001b[K-----------------------------------------------------------------------------------------\r\r\n\u001b[19G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m6 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python command-line \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[92m\u289b\u28d3\u28e1\u001b[93m\u28f0\u001b[37m\u2808\u2801\u2801\u2890\u001b[39m         \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u001b[2m\u2820\u001b[22m\u289b\u28d3\u28e1\u001b[39m \u001b[37m\u2808\u2801\u2801\u2890\u001b[39m\r\r\n\u001b[16G\u001b[K  \u001b[92m\u2814\u281d\u282b\u2863\u001b[93m\u2819\u28be\u001b[37m\u2810\u2808\u001b[39m          \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m                                \u001b[35m\u2819\u285f\u28ab\u2843\u001b[39m  \u001b[37m\u2810\u2808\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[92m\u001b[2m\u2802\u001b[22m\u001b[39m  \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                    \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[21G\u001b[K\u001b[38;5;248m7k \u00b7 Ctrl+B bg\u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
