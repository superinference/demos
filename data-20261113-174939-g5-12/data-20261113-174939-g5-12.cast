[50.971051, "o", "\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def parse(data):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     reader = csv.DictReader(io.StringIO(data))\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     rows = []\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     for row in reader:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+50 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(+---------------+-------------+----------+-------+) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Percolating \u001b[2m15.9s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[43G\u001b[K\u001b[93m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[76G\u001b[K\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;