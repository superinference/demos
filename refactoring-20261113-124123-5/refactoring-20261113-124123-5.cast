[57.052122, "o", "\u001b[29A\u001b[E\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mTest suite for config_parser.py\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mCompares outputs of original and refactored versions side-by-side.\r\r\n\u001b[E\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m from config_parser import parse_config, parse_config_refactored\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mimport json\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mport = 5432\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m; this is a comment\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22muser = admin\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mpassword = secret\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m[app]\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mdebug = true\r\r\n\u001b[17G\u001b[K\u001b[2m00 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Noodling \u001b[2m4.5s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35