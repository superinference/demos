[49.864884, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     Sorts an array using the quicksort algorithm.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     Uses the last element as pivot.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     if len(arr) <= 1:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         return arr\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     # Partition: elements less than pivot, equal to pivot, greater than pivot\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     less = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     equal = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     greater = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     for element in arr:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         if element < pivot:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+26 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run the file:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Unsorted list:) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Crystallizing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[47G\u001b[K\u001b[93m\u001b[39m\u001b[36m\u