[71.424723, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[KA few design choices worth noting:\r\r\n\u001b[1G\u001b[K\u2022 data.json \u2014 the inline JSON, written verbatim.\r\r\n\u001b[3G\u001b[K\u001b[1mstatus.replace(\"_\", \" \").title()\u001b[22m turns the raw enum on_track into human-readable On Track, keeping\r\r\n\u001b[1G\u001b[K the data machine-friendly while the display is people-friendly.\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mfilled = round(bar_len * completion / 100)\u001b[22m scales the percentage onto a fixed 20-char bar,\r\r\n\u001b[1G\u001b[Kdecoupling the visual width from the data value.\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mpad = max(len(m[\"name\"]) for m in data[\"team\"])\u001b[22m computes column alignment dynamically, so it stays\r\r\n\u001b[1G\u001b[K t\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[21G\u001b[K\u001b[38;5;248m5 \u00b7 \u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;