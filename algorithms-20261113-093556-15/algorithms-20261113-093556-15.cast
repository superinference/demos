[33.952556, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ def coin_change(coins, amount):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     INF = float(\"inf\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     # dp[a] = min coins to make amount a\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     dp = [0] + [INF] * amount\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     # last_coin[a] = coin used to reach the optimal dp[a], for reconstruction\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     last_coin = [None] * (amount + 1)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     for a in range(1, amount + 1):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         for c in coins:\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     return dp, last_coin\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def reconstruct(last_coin, amount):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     coins_used = []\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     a = amount\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     while a > 0:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+32 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Coins available: [1, 5, 10, 25]) 0.1s\u001b[22m\r\r\n\u001b[1