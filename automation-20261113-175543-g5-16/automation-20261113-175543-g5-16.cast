[42.21027, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Unit conversion helpers for length, weight, and temperature.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ # Length conversions (all to/from meters as base)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ LENGTH_TO_METERS = {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     'km': 1000,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     'kilometers': 1000,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     'm': 1,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     'meters': 1,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     'miles': 1609.34,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     'in': 0.0254,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ }\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ # Weight conversions (all to/from kilograms as base)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ WEIGHT_TO_KG = {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     'kg': 1,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     'kilograms': 1,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+96 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25