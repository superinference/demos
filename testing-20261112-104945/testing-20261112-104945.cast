[25.376171, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;35m/\u001b[39m Running python -c 'import test_slugify; failed=0 \u00b7 450 chars \u001b[2m1.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[3G\u001b[K\u001b[33m\u28e0\u28be\u2877\u28c4\u001b[39m           \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m                                 \u001b[35m\u001b[2m\u2812\u001b[22m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[35m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[3G\u001b[K\u001b[33m\u2819\u28be\u2877\u280b\u001b[39m \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m         \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m              \u001b[36m\u001b[2m\u2820\u001b[22m\u287d\u2839\u280f\u28af\u001b[39m                                  \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[3G\u001b[K\u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m                \u001b[32m\u001b[2m\u2809\u001b[22m\u001b[39m                                                        \u001b[35m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[33m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[38;5;248m31.0 tps \u00b7 \u219118k \u2193443 \u00b7 Ctrl+B bg\u001b[39m                \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;21