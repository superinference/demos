[33.125101, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import json\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ with open(\"data.json\") as f:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+     data = json.load(f)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ regions = data[\"regions\"]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ print(f\"Sales Report - {data['company']} - {data['quarter']}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ print(\"=\" * 60)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ total_units = 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ for r in regions:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     total_revenue += r[\"revenue\"]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     total_units += r[\"units\"]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     print(f\"{r['name']:<16}{'$' + format(r['revenue'], ','):>15}\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+           f\"{format(r['units'], ','):>12}{r['growth'] * 100:>9.1f}%\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+4 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\