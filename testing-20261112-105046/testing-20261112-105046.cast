[28.547527, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     cases = [\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+         (\"   \\t\\n\", \"\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+         (\"one\\u00a0two\", \"one two\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+         (\" leading and trailing \", \"leading and trailing\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     def test_normalizes_representative_and_edge_cases(self):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         for value, expected in self.cases:\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(8/8 cases passed) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 string_utils.py \u2014 self-contained normalize_whitespace() utility using only the standard library.\r\r\n\u001b[1G\u001b[K\u2022 test_string_utils.py \u2014 parameterized-style unittest coverage for representative inputs, whitespace\r\r\n\u001b[1G\u001b[K variants, empty strings, Unicode whitespace, and invalid input.\r\r\n\u001b[1G\u001b[K\