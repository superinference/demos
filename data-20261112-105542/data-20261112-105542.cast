[19.968881, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m16+ }\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+ header_line = \" | \".join(header.ljust(widths[header]) for header in headers)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+ separator = \"-+-\".join(\"-\" * widths[header] for header in headers)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ print(header_line)\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+3 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(name | department | score) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated and ran csv_summary.py. Final output:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[Kname  | department  | score\r\r\n\u001b[1G\u001b[K------+-------------+------\r\r\n\u001b[1G\u001b[KAvery | Engineering | 94\r\r\n\u001b[1G\u001b[KBlair | Design      | 88\r\r\n\u001b[1G\u001b[KCasey | Marketing   | 91\r\r\n\u001b[1G\u001b[KDrew  | Support     | 85\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The script uses `csv.DictReader`\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2