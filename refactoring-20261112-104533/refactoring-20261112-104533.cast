[25.468131, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ def classify(value):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     if value == \"apple\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+         if value in (\"apple\", \"pear\"):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+             return \"fruit\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+                 return \"vegetable\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+             return \"food\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+         else:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+             if value == \"salmon\":\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+                 if value in (\"salmon\", \"tuna\"):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+                     return \"fish\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+                 return \"animal\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+12 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m[Checkpoint cp-1794480367845-1: /tmp/ami-demo-FP4nl5/nested_classifier.py, \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m/tmp/ami-demo-FP4nl5/data_driven_classifier.py]\u001b[22m\r\r\n\u001b[E\u001b[17G\u001b[K\u001b[38;5;167m\u001b[39m\u001b[1m\u001b[38;5;167m\u001b[39m\u001b[22m\u001b[2m\u001b[22m\u001b[38;5;243mdata_driven_classifier.py\u001b[39m\r\r\n\u001b[13G\u001b[K\u001b[38;5;167m\u001b[39mdata_driven_classifier.py \u001b[2m8.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[3G\u001b[K               \u001b[32m\u2880\u28ff\u28d7\u28e2\u001b[2m\u2812\u001b[22m\u001b[37m\u28d4\u28f7\u28fe\u28e2\u001b[39m          \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m              \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m             \u001b[35m\u2880\u28ff\u28d7\u28e2\u001b[39m \u001b[37m\u28d4\u28f7\u28fe\u28e2\u001b[39m\r\r\n\u001b[3G\u001b[K               \u001b[32m\u2815\u281f\u282b\u2842\u001b[39m \u001b[37m\u2801\u2809\u2809\u001b[39m          \u001b[36m\u001b[2m\u2820\u001b[22m\u2879\u282d\u283b\u282d\u288b\u001b[39m              \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m            \u001b[35m\u2811\u285f\u28bb\u284b\u001b[2m\u2809\u001b[22m\u001b[37m\u2801\u2809\u2809\u001b[39m\r\r\n\u001b[3G\u001b[K                 \u001b[32m\u001b[2m\u2809\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
