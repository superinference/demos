off-by-one bug fix\u0007\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[38G\u001b[K\u001b[36m\u2880\u2840\u001b[39m\r\r\n\u001b[14G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[92m\u2820\u289a\u28d7\u2845\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m          \u001b[36m\u28f0\u28fd\u28d7\u2844\u001b[39m                                  \u001b[35m\u2820\u289a\u28d7\u2845\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[14G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[92m\u2814\u283d\u282b\u2873\u001b[39m \u001b[37m\u2808\u2801\u001b[39m            \u001b[36m\u281e\u2818\u280b\u28af\u001b[39m                                  \u001b[35m\u2839\u287f\u28ab\u2857\u001b[39m \u001b[37m\u2808\u2801\u001b[39m\r\r\n\u001b[23G\u001b[K\u001b[92m\u001b[2m\u001b[22m\u001b[39m\r\r\n\u001b[14G\u001b[K\u001b[92m\u001b[2mi\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u25