[88.221526, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mWhat it produces\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mStarry sky\u001b[22m with *, ., + stars at varied densities plus a crescent moon ) upper-right\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mThree layered mountain ridges\u001b[22m generated by midpoint displacement \u2014 far ridges higher/fainter (^\r\r\n\u001b[1G\u001b[Kcrests, ` fill), near ridges denser (#/%), overdrawn front-to-back for depth\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mTrees\u001b[22m (T \u03a8 \u2660 \u2191) scattered on crest lines\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mLake\u001b[22m below the horizon that mirrors the terrain above it (^\u2192v, /\u2192\\), dimmed and rippled with ~ for\r\r\n\u001b[1G\u001b[K a reflection effect\r\r\n\u001b[E\u001b[1G\u001b[KEach run reseeds randomly, so you get a new mountain every time.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mHow the fractal core works\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe midpoint_displacement function is the heart of it:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K1. Start with two random endpoint heights on a power-of-two+1 grid.\r\r\n\u001b[1G\u001b[K2. Repeatedly set each segment's midpoint to the \u001b[1maverage of its neighbours plus a random jitter\u001b[22m.\r\r\n\u001b[1G\u001b[K3. \u001b[1mShrink the jitter range by roughness each pass\u001b[22m \u2014 large early displacements make the big peaks,\r\r\n\u001b[1G\u001b[Ktiny later ones add fine detail.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThat sh\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a self-contained Pytho\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[88.282795, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[22G\u001b[K\u001b[32m\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2868\u287b\u2866\u2840\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                                 \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[39m\u001b[32m\u2885\u001b[39m                \u001b[36m\u284d\u28a9\u001b[39m  \u001b[35m\u2899\u287f\u28bf\u284b\u001b[39m                                 \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n\u001b[41G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m                                   \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[88.341792, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[8G\u001b[Krinking-jitter recursion is what produces stat\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[3G\u001b[K\u001b[38;5;248m3.0 tps \u00b7 \u219122k \u21931.7k \u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u