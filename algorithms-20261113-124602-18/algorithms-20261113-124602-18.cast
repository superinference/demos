[48.731734, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import math\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ import random\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ def estimate_e(trials):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     total = 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     for _ in range(trials):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         s = 0.0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         count = 0\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     return total / trials\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def main():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     trials = 5_000_000\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     estimate = estimate_e(trials)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     true_e = math.e\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+8 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Trials: 5,000,000) 1.4s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m1.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[6G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m                      \u001b[