[144.510514, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[21G\u001b[K                \u001b[36m\u28e0\u28b8\u28f3\u286e\u001b[32m\u28fa\u28d7\u2840\u001b[39m        \u001b[35m\u281e\u28ba\u28a2\u28ae\u001b[93m\u2840\u282a\u28b6\u2814\u001b[39m\r\r\n\u001b[21G\u001b[K                \u001b[36m\u287c\u2856\u284e\u288b\u001b[32m\u281d\u282b\u2842\u001b[39m        \u001b[35m\u289f\u283d\u282a\u28db\u001b[93m\u28e3\u28b7\u28b5\u2849\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K                   \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m           \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[2my\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;21