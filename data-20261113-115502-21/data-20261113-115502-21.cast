[55.403548, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m14+   {\"volcano\": \"Pinatubo\",       \"year\": 1991, \"country\": \"Philippines\",    \"vei\": 6, \"dea\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+   {\"volcano\": \"St. Helens\",     \"year\": 1980, \"country\": \"United States\",  \"vei\": 5, \"dea\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+ ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ \"\"\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ def banner(text):\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+40 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KDone. volcano_report.py is created and runs cleanly \u2014 output shown above.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe report has three parts as requested:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mTitle banner\u001b[22m centered in a 72-char frame\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mTable\u001b[22m sorted by deaths descending with rank, volcano, year, country, VEI, and comma-formatted\r\r\n\u001b[1G\u001b[Kdeaths\r\r\n\u001b[3G\u001b[K\u001b[1mASCII bar chart\u001b[22m where each bar is scaled relative to Tambora (the max, which fills all 40 chars)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python script called\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n"]
