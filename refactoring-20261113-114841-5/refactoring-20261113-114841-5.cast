[303.416256, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ \"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+ Before/After Comparison Report: Original vs Refactored Recipe Scorer\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3+ \"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+ import inspect\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+ from recipe_scorer import (\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+     score_recipes,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+     score_recipes_refactored,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     SAMPLE_RECIPES,\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m14+     compute_nutrient_scores,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     compute_overall_score,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     format_summary,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ )\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ def count_function_lines(func):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+191 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Simmering \u001b[2m14.1s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u25