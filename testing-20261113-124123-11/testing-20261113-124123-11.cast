[83.079331, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     def test_intervals_with_clear_overlap(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         \"\"\"Two intervals with obvious overlap\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+         assert overlaps(1, 2, 3, 4) is False\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     def test_no_overlap_b_before_a(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         \"\"\"Interval B is completely before A\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         assert overlaps(3, 4, 1, 2) is False\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+94 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run the tests to find the bug:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(============================= test session star...) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KPerfect! I found 4 failing tests. Let me analyze the issues:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K1. **Zero-length intervals at\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u