[44.661536, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   0  Created new file: /tmp/ami-demo-bhk4En/test_pq.py\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502   1  Successfully wrote /tmp/ami-demo-bhk4En/test_pq.py (new file, 17 lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ from pq import PriorityQueue\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3+ pq = PriorityQueue()\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+ # Insert tasks with priorities\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ priorities = [3, 15, 100, 7, 42]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ for p in priorities:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     pq.insert(p, f\"task_{p}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     print(f\"Inserted task with priority {p}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+ print(\"\\nPopping tasks (should pop highest priority first):\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+ while True:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+     item = pq.pop_highest()\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     if item is None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         break\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     priority, task_name = item\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     print(f\"Popped: priority={priority}, task={task_name}\")\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Noodling \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2804\u001b[22m\u001b[39m         \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u2894\u281d\u282b\u2862