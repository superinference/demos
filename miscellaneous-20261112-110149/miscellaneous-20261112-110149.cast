[81.768642, "o", "\u001b[29A\u001b[1G\u001b[K  \u25e6 Air Pressure\r\r\n\u001b[1G\u001b[K\u2022 Robust anomaly detection using:\r\r\n\u001b[1G\u001b[K  \u25e6 Median and MAD-based modified z-scores for spikes\r\r\n\u001b[1G\u001b[K  \u25e6 Median-window trend comparison for drift\r\r\n\u001b[1G\u001b[K\u2022 Polished dark-theme SVG visualization with:\r\r\n\u001b[1G\u001b[K  \u25e6 Sensor traces\r\r\n\u001b[1G\u001b[K  \u25e6 Spike markers\r\r\n\u001b[5G\u001b[KDrift markers\r\r\n\u001b[6G\u001b[Kensor statistics and legend\r\r\n\u001b[1G\u001b[K\u2022 Concise terminal dashboard\r\r\n\u001b[1G\u001b[K\u2022 Six automated tests covering:\r\r\n\u001b[1G\u001b[K  \u25e6 Deterministic generation\r\r\n\u001b[6G\u001b[KAD robustness\r\r\n\u001b[5G\u001b[KSpike detection\r\r\n\u001b[1G\u001b[K  \u25e6 Drift detection\r\r\n\u001b[12G\u001b[Kfixture coverage\r\r\n\u001b[6G\u001b[KVG generation\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mFinal report\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K```text\r\r\n\u001b[1G\u001b[KSIGNAL G\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mIn this empty current directo\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[92m\u284e\u2889\u288b\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m        \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[36m\u28ff\u28d2\u2844\u001b[39m                                 \u001b[35m\u284e\u2889\u288b\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2808\u281d\u280b\u2843\u001b[2m\u2804\u001b[22m\u001b[37m\u2808\u281d\u2809\u2801\u001b[39m       \u001b[93m\u001b[2m\u2812\u001b[22m\u2819\u28be\u2877\u280b\u001b[36m\u283f\u2809\u28af\u001b[39m                                 \u001b[35m\u2808\u285f\u288b\u2843\u001b[39m \u001b[37m\u2808\u281d\u2809\u2801\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m     \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
