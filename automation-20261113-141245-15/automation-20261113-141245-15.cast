0\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python command-line \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n                  \u001b[32m\u2880\u2840\u001b[39m  \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                                                          \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n                 \u001b[32m\u2830\u28fd\u28ef\u2806\u001b[39m                \u001b[36m\u28a0\u28ff\u2844\u001b[39m           \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                        \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m\r\r\n                 \u001b[32m\u2828\u280a\u2811\u2805\u001b[39m                \u001b[36m\u2879\u283b\u288b\u001b[39m           \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m                      \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n                                        \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m           \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m                 "]
