[20.506993, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Minimum-coin change using dynamic programming.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ from math import inf\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ def minimum_coins(coins: list[int], amount: int) -> tuple[int, list[int]]:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     \"\"\"Return the minimum coin count and one optimal combination.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     if amount < 0:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+         raise ValueError(\"amount must be non-negative\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     choices: list[int | None] = [None] * (amount + 1)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     dp[0] = 0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     for current_amount in range(1, amount + 1):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         for coin in coins:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+             if coin <= current_amount and dp[current_amount - coin] + 1 < dp[current_amou\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+                 dp[current_amount] = dp[current_amount - coin] + 1\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+40 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Tinkering \u001b[2m6.3s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[2m\u2812\u001b[22m\u001b[39m                       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[93m\u2839\u287a\u2897\u280f\u001b[39m                        \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
