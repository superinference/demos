[71.009602, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     201: '201 Created',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     204: '204 No Content',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     301: '301 Moved',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     302: '302 Found',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     304: '304 Not Modified',\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     500: '500 Internal Server Error',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     502: '502 Bad Gateway',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     503: '503 Service Unavailable',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ _CLASS = {1: 'Informational', 2: 'Success', 3: 'Redirect',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+           4: 'Client Error', 5: 'Server Error'}\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+10 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow I'll run both, save outputs, and diff.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Error: Blocked: unquoted redirect operators det...) 0.0s\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Conjuring \u001b[2m17.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[16G\u001b[K \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m           \u001b[33m\u28c0\u28be\u28f3\u28c0\u001b[39m  \u001b[37m\u280a\u2811\u001b[39m             \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[16G\u001b[K \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m               \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m           \u001b[33m\u2819\u28be\u2877\u280b\u001b[2m\u2804\u001b[22m\u001b[39m                \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[20G\u001b[K                 \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
