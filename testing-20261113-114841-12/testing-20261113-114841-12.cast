[82.300064, "o", "\u001b[29A\u001b[1G\u001b[KDone. Both files are created and the full suite passes.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mSummary\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mroman_numerals.py\u001b[22m \u2014 two converters over the classic range 1\u20133999:\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 int_to_roman(number) \u2014 greedy subtraction over a value\u2192symbol table; raises TypeError for non-ints\r\r\n\u001b[1G\u001b[K (and explicitly rejects bool), ValueError for out-of-range.\r\r\n\u001b[1G\u001b[K\u2022 roman_to_int(roman) \u2014 right-to-left scan with the subtractive rule, then \u001b[1mround-trips through \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[1mint_to_roman to reject non-canonical forms\u001b[22m like IIII, VV, IC.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mtest_roman_numerals.py\u001b[22m \u2014 parametrized pytest suite:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 15 standard value\u2194numeral pairs (including all the requested ones), tested in both directions.\r\r\n\u001b[1G\u001b[K\u2022 test_round_trip over the entire 1\u20133999 range (the bulk of the 4051 passing tests).\r\r\n\u001b[1G\u001b[K\u2022 Case-insensitivity, out-of-range values, bad types, and invalid/non-canonical numerals.\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mTest result (actual pytest output):\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K============================= 4051 passed in 1.73s =============================\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KExit\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mIn this empty directory, writ\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[22G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u2885\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m      \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2868\u287b\u001b[2m\u2804\u001b[22m\u2801\u001b[39m                \u001b[36m\u284d\u28a9\u001b[39m      \u001b[35m\u2899\u287f\u28bf\u284b\u001b[39m \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m  \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[47G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m   \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
