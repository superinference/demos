[150.082393, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[5G\u001b[K\u001b[1mRefactored parse_config_refactored()\u001b[22m: Uses four small helpers to eliminate duplication:\r\r\n\u001b[1G\u001b[K    \u25aa skip_comments(text, char) \u2014 Filter out blanks and comment lines\r\r\n\u001b[3G\u001b[K  \u25aa parse_kv_line(line, strip_quotes) \u2014 Parse key=value pairs\r\r\n\u001b[7G\u001b[Kis_section_header(line) \u2014 Detect [section] headers\r\r\n\u001b[7G\u001b[Kextract_section_name(line) \u2014 Extract section name\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K2. \u001b[1mtest_config_parser.py\u001b[22m (119 lines)\r\r\n\u001b[1G\u001b[K  \u25e6 Tests all three formats (INI, TOML, ENV) with realistic sample configs\r\r\n\u001b[1G\u001b[K  \u25e6 Compares outputs side-by-side in a table format\r\r\n\u001b[5G\u001b[KVerifies original and refactored versions produce \u001b[1midentical results\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K3. \u001b[1mREFACTORING_SUMMARY.md\u001b[22m \u2014 Documents the problem, solution, and benefits\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mTest Results\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KTests passed: 3/3\r\r\n\u001b[1G\u001b[K\u2713 All tests passed! Original and refactored versions produce identical outputs.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KEach format (INI, TOML, ENV) was tested and all three show \u2713 MATCH, confirming the refactoring\r\r\n\u001b[1G\u001b[Kpreserves behavior while improving code quality.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[92m\u2828\u287b\u2866\u2840\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                             \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[92m\u001b[2m\u2802\u001b[22m\u289f\u2805\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m         \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2802\u001b[22m\u001b[39m                            \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n\u001b[50G\u001b[K\u001b[92m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m                                    \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u00