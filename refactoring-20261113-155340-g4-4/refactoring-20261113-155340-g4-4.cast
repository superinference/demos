[36.219539, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+         if code == 100:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+             return '100 Continue'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+         elif code == 101:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+             return '101 Switching Protocols'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+         else:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+             return str(code) + ' Informational'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     elif code < 300:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+         elif code == 204:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+             return '204 No Content'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+         else:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+             return str(code) + ' Success'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     elif code < 400:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+         if code == 301:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+             return '301 Moved'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+32 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m[Checkpoint cp-1794585317277-1: /tmp/ami-demo-lGffZ4/nested.py, /tmp/ami-