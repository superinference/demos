[41.890065, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2880\u28ba\u28d3\u2840\u001b[39m \u001b[37m\u2810\u2801\u2808\u001b[39m            \u001b[36m\u2890\u2842\u001b[39m                \u001b[33m\u2880\u2874\u28ff\u28a6\u2840\u001b[39m              \u001b[35m\u2880\u28ba\u28d3\u2840\u001b[39m \u001b[37m\u2810\u2801\u2808\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2814\u283d\u282a\u2862\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u284d\u28a9\u001b[39m              \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[33m\u2808\u2813\u28bf\u287e\u2801\u001b[39m              \u001b[35m\u2819\u287f\u28ba\u284b\u001b[39m\r\r\n\u001b[40G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m                  \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b