[92.959861, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m             \u001b[32m\u2880\u28ba\u28d3\u28c0\u001b[39m \u001b[37m\u2808\u2809\u2809\u001b[39m           \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                                 \u001b[35m\u2880\u28ba\u28d3\u28c0\u001b[39m \u001b[37m\u2808\u2809\u2809\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m             \u001b[32m\u2814\u281d\u282b\u2863\u001b[39m               \u001b[36m\u287d\u2809\u283f\u2809\u28af\u001b[39m                                 \u001b[35m\u2819\u285f\u28bb\u284b\u001b[39m \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[5G\u001b[K\u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m              \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                 \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[92.996864, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[92.997055, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ priorities = [3, 15, 100, 7, 42]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ for p in priorities:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     pq.insert(p, f\"task_{p}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     print(f\"Inserted task with priority {p}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+ print(\"\\nPopping tasks (should pop highest priority first):\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+ while True:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+     item = pq.pop_highest()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     if item is None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         break\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     priority, task_name = item\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     print(f\"Popped: priority={priority}, task={task_name}\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KRun the buggy version to show the wrong output:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Inserted task with priority 3) 0.1s\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KPerfect! The output is clearly wrong. It's popping in the order: 7, 42, 3, 15, 100 instead of 100,\r\r\n\u001b[1G\u001b[K42, 15, 7, 3.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K**The bug\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[38;5;248m21 \u00b7 Ctrl+B bg\u001b[39m   \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \