[52.866231, "o", "\u001b[29A\u001b[E\u001b[17G\u001b[K\u001b[2m\u001b[22mpytest\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m from utils import slugify\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mclass TestSlugify:\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m\"\"\"Parametrized test suite for the slugify function.\"\"\"\r\r\n\u001b[E\u001b[14G\u001b[K\u001b[2m\u001b[22m@pytest.mark.parametrize(\"input_text,expected\", [\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    # Normal strings\r\r\n\u001b[E\u001b[18G\u001b[K\u001b[2m\u001b[22m# Unicode and accented characters\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m         (\"Caf\u00e9\", \"caf\"),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    (\"\u00dcber Cool\", \"ber-cool\"),\r\r\n\u001b[18G\u001b[K\u001b[2m\u001b[22m(\"\u041c\u043e\u0441\u043a\u0432\u0430\", \"\"),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    (\"Hello \u4f60\u597d\", \"hello\"),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    (\"Na\u00efve r\u00e9sum\u00e9\", \"nave-rsum\"),\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[17G\u001b[K\u001b[2m08 more lines)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Marinating \u001b[2m6.6s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file utils.py with a\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m       \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m   \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m       \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[52G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m                       \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u