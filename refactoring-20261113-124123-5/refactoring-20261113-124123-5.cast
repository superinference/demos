[150.563313, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500.\r\r\n\u001b[1G\u001b[K  \u2022 \u001b[1mExtraction pattern\u001b[22m: The refactoring identifies low-level operations (strip, split, filter) and\r\r\n\u001b[1G\u001b[Kelevates them into\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[92m\u2828\u287b\u2866\u2840\u001b[39m \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                                 \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[92m\u001b[39m \u001b[92m\u289f\u2805\u001b[39m               \u001b[36m\u2879\u282d\u283b\u282d\u288b\u001b[39m       \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m                                 \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n\u001b[38G\u001b[K\u001b[92m\u001b[39m\u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                                  \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.