[296.927108, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[Kconfig = yaml.load(f, Loader=yaml.Loader)   # VULNERABLE\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe yaml.Loader (and the pre-5.1 default of bare yaml.load()) honors special tags like\r\r\n\u001b[1G\u001b[K!!python/object/apply, which lets a YAML file \u001b[3mconstruct arbitrary Python objects and call functions\u001b[23m\r\r\n\u001b[1G\u001b[Kduring parsing.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mThe attack payload (config.yaml)\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[Kdebug: !!python/object/apply:os.system [\"echo PWNED_BY_YAML_ATTACK > .../pwned.txt\"]\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mProof it fired (vulnerable version):\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KLoaded settings:\r\r\n\u001b[1G\u001b[K{'app_name': 'demo', 'debug': 0}\r\r\n\u001b[1G\u001b[Kpwned.txt contents:\r\r\n\u001b[1G\u001b[KPWNED_BY_YAML_ATTACK      \u2190 os.system executed during parsing\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mThe fix\u001b[22m\r\r\n\u001b[1G\u001b[Kconfig = yaml.safe_load(f)   # FIXED\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K`safe_load` uses `SafeLoader`, which only builds pl\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[21G\u001b[K\u001b[38;5;248m6k \u2026\u001b[39m           \u001b[33m\u26a1auto \u