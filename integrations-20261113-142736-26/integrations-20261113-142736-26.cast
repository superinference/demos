[136.777675, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[2G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m                          \u001b[35m\u2884\u28da\u28b1\u28d7\u001b[39m \u001b[36m\u28ee\u28fa\u28dd\u2857\u001b[2m\u2804\u001b[22m\u001b[39m                  \u001b[32m\u28a0\u28db\u28d7\u2840\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                          \u001b[35m\u2851\u285e\u2897\u2809\u001b[2m\u2836\u001b[22m\u001b[36m\u281d\u2895\u283f\u288b\u001b[39m                   \u001b[32m\u2898\u281d\u282b\u2842\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[5G\u001b[K\u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m                          \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m       \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[11G\u001b[K\u001b[35m\u001b[2me\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;