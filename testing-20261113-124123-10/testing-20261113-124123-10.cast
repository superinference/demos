[155.16298, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[155.163147, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[1m\u001b[3mtest_roman.py\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K30 comprehensive pytest tests organized in 3 classes:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K1. \u001b[1mTestIntToRoman\u001b[22m (12 tests):\r\r\n\u001b[1G\u001b[K  \u25e6 Boundary values (1, 3999)\r\r\n\u001b[1G\u001b[K  \u25e6 All six subtractive forms (4\u2192IV, 9\u2192IX, 40\u2192XL, 90\u2192XC, 400\u2192CD, 900\u2192CM)\r\r\n\u001b[1G\u001b[K  \u25e6 Common values\r\r\n\u001b[1G\u001b[K  \u25e6 Error cases (out of range, non-integer)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K2. \u001b[1mTestRomanToInt\u001b[22m (14 tests):\r\r\n\u001b[5G\u001b[KSame boundary and subtractive coverage\r\r\n\u001b[6G\u001b[Kase-insensitive parsing\r\r\n\u001b[5G\u001b[KValidation of invalid formats (IIII, VV)\r\r\n\u001b[1G\u001b[K  \u25e6 Error cases (empty, invalid chars, non-string)\r\r\n\u001b[1G\u001b[K\r\r\n"]
[155.163164, "o", "\u001b[1G\u001b[K3. \u001b[1mTestRoundTrip\u001b[22m (4 tests):\r\r\n\u001b[5G\u001b[KBoundaries, subtractive forms\r\r\n\u001b[1G\u001b[K  \u25e6 Every 7th number in range (571 values)\r\r\n\u001b[3G\u001b[K\u25e6 Specific interesting values\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K### Test Results\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python module roman.\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
