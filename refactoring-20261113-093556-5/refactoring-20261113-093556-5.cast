[161.3501, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[161.350485, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1- import re\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2- import logging\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4- logging.basicConfig(level=logging.ERROR)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5- logger = logging.getLogger(__name__)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6-\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7-\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m 8- def process_records(records):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9-     \"\"\"Process a list of records and validate each field.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m10-     results = []\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 24 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     \"\"\"Validate that email is a string matching standard email format.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     return isinstance(email, str) and re.match(r'^[\\w\\.-]+@[\\w\\.-]+\\.\\w+$', email)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ def _is_valid_age(age):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     \"\"\"Validate that age is an integer between 0 and 150 inclusive.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m21+     return isinstance(age, int) and 0 <= age <= 150\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  22  ... (+41 more added)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Tinkering \u001b[2m19.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[21G\u001b[K\u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m             \u001b[92m\u28a0\u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[93m\u001b[39m              \u001b[92m\u2894\u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[39G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m                                      \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[92m\u001b[2m Mentor  \u258c\u001b[22m\u001b[39m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m2% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[3