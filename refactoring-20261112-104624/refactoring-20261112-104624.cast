[23.120462, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ \"\"\"Demonstrate replacing duplicated record-formatting logic with a helper.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ records = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     {\"name\": \"Ada\", \"score\": 98},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     {\"name\": \"Linus\", \"score\": 91},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     {\"name\": \"Grace\", \"score\": 95},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     return \"\\n\".join(lines)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def original_second(records):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     lines = []\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     for index, record in enumerate(records, start=1):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         lines.append(f\"{index}. {record['name']}: {record['score']}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+21 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Original and refactored outputs match: True) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Percolating \u001b[2m1.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[21G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m   \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m    \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[93m\u001b[2m\u2809\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m   \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2820\u001b[22m\u001b[39m   \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[29G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[35m\u001b[2m Hype  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
