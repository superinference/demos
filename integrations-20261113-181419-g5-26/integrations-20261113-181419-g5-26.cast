[215.968329, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[32m\u2884\u28e3\u280a\u001b[39m \u001b[37m\u2810\u2884\u2860\u280a\u001b[39m          \u001b[36m\u28f9\u287a\u287d\u2844\u001b[39m                 \u001b[33m\u288e\u28b3\u2880\u001b[39m  \u001b[37m\u2846\u28b1\u001b[39m           \u001b[35m\u2884\u28e3\u280a\u001b[39m \u001b[37m\u2810\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u2809\u280a\u2862\u001b[2m\u2836\u001b[22m\u001b[37m\u2814\u2801\u2808\u2822\u001b[39m          \u001b[36m\u2858\u280d\u287f\u288b\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[33m\u28be\u2867\u2803\u001b[39m  \u001b[37m\u289c\u2864\u001b[39m          \u001b[35m\u2814\u280b\u288a\u2863\u001b[2m\u2837\u001b[22m\u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[38G\u001b[K\u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                     \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216