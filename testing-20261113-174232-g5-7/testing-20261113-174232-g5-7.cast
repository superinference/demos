[83.363707, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ def test_division_by_zero():\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     \"\"\"Test that division by zero returns None.\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     assert safe_divide(10, 0) is None\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     assert safe_divide(0, 0) is None\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+     assert safe_divide(-5, 0) is None\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+9 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mStep 3: Run tests to show failures\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(============================= test session star...) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KPerfect! The tests show the exact bugs:\r\r\n\u001b[E\u001b[1G\u001b[K1. \u001b[1mZeroDivisionError\u001b[22m when dividing by zero (expected None)\r\r\n\u001b[1G\u001b[K2. \u001b[1mTypeError\u001b[22m when given non-numeric inputs (expected None)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K##\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2