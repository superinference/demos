[79.433033, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ # quickping\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ A lightweight network latency checker that shows you response times instantly.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ ```bash\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ quickping google.com\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ ```\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ ## Quick start\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 5 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ # Check a single host\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ quickping example.com\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ # Monitor continuously\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ quickping -c example.com\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ ```\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+57 more lines)\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m2  [Auto-formatted]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u00