[252.050521, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2880\u28ba\u28d3\u2840\u001b[2m\u2837\u001b[22m\u001b[37m\u2811\u001b[39m  \u001b[37m\u2808\u001b[39m          \u001b[36m\u2822\u28e2\u28be\u2844\u001b[39m               \u001b[93m\u28e0\u28fe\u2877\u28c4\u001b[39m              \u001b[35m\u001b[2m\u2837\u001b[22m\u2880\u28ba\u28d3\u2840\u001b[39m \u001b[37m\u2811\u001b[39m  \u001b[37m\u2808\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2814\u281d\u282b\u2862\u001b[39m               \u001b[36m\u28f3\u2818\u282f\u288f\u001b[39m               \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m               \u001b[35m\u2819\u285f\u28bb\u284b\u001b[39m\r\r\n\u001b[21G\u001b[K                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u