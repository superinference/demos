[49.848023, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+ \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ from itertools import permutations\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     # Extract unique letters: E, A, T, H, P, L\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     letters = ['E', 'A', 'T', 'H', 'P', 'L']\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     # Try all permutations of 6 unique digits from 0-9\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+     for perm in permutations(range(10), 6):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         # Create a mapping\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         mapping = dict(zip(letters, perm))\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+65 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-8GPxcR && python crypto.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-8GPxcR && python crypto.py \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E