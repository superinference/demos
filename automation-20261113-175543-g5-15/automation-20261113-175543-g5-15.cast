[119.195822, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(-----------------------------------------------...) 0.0s\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KExcellent! Both files are created and working. Here's what was created:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mFiles Created\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1m\u001b[3mcsvstats.py\u001b[22m \u2013 A command-line statistics tool\u001b[23m\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 Reads CSV files and computes stats for all numeric columns\r\r\n\u001b[1G\u001b[K\u2022 Computes: count, min, max, mean, median, and standard deviation\r\r\n\u001b[1G\u001b[K\u2022 Outputs a nicely formatted ASCII table\r\r\n\u001b[1G\u001b[K\u2022 Handles non-numeric columns gracefully (skips them)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3msales_data.csv\u001b[22m \u2013 Sample dataset\u001b[23m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[3G\u001b[K5 columns: Product (non-numeric), Units_Sold, Price, Revenue, and Discount_Percent\r\r\n\u001b[3G\u001b[K20 rows of realistic e-commerce data with various product categories (Widgets, Gadgets, Tools,\r\r\n\u001b[1G\u001b[KPremium items)\r\r\n\u001b[1G\u001b[K\u001b[1mResults\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KRunning `python\r\r\n\u0