[11.055352, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > Write a Python script called crypto.py that solves the cryptarithmetic puzzle EAT + THAT = APPLE,\u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m where each letter stands for a unique digit (0-9) and leading letters E, T, A cannot be zero. Find \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255mand print all valid digit assignments, show the completed equation for each, and explain in a short \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255mparagraph how the solver explored the search space. Then run it. \u001b[39m\u001b[49m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m Crystallizing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500 \u001b[22m\u001b[1m\u001b[38;5;35m\u2713 Pasted 361 chars\u001b[22m\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mWrite a Python script called \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[33m\u001b[2m\u2802\u001b[22m\u28e0\u28be\u2877\u28c4\u001b[39m \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[16G\u001b[K\u001b[32m\u001b[2m\u2812\u001b[22m\u001b[39m \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u287d\u2839\u280f\u28af\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[33m\u2819\u28be\u2877\u280b\u001b[39m              \u001b[35m\u001b[2m\u2809\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[19G\u001b[K                  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                    \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[35m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[16G\u001b[K\u001b[32m\u001b[2me\u258c\u001b[22m\u001b[39m\r\r\n"]
