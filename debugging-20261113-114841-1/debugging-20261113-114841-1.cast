[67.860112, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+ # Embedded YAML recipe\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ RECIPE_YAML = \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ name: Classic Pancakes\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ servings: 4\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ ingredients:\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+   - amount: \"2\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     name: \"eggs\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+   - amount: \"1 1/4 cups\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     name: \"milk\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+   - amount: \"1/3 cup\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     name: \"melted butter\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+   - amount: \"2 tbsp\"\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+80 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it with multiplier 2.5 to trigger the bug:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-OoRbX0 && python recipe_scaler.py 2.5\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-OoRbX0 && python recipe_scaler.py 2.5 \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E