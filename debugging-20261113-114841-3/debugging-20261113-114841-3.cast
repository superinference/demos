[228.680272, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[27G\u001b[K\u001b[32m\u2893\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[37m\u2844\u2831\u001b[39m   \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m           \u001b[93m\u28c4\u28bf\u28ff\u28e2\u001b[39m \u001b[37m\u2854\u28c5\u2876\u28c2\u001b[39m           \u001b[35m\u28ce\u2893\u001b[39m \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[37m\u2844\u2831\u001b[39m\r\r\n\u001b[24G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[32m\u28bc\u2827\u2842\u001b[39m  \u001b[37m\u289c\u2864\u001b[39m   \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m           \u001b[93m\u2811\u28bf\u283b\u280b\u001b[39m \u001b[37m\u2811\u281f\u2838\u2802\u001b[39m           \u001b[35m\u28fe\u28a7\u2843\u001b[39m  \u001b[37m\u289c\u2864\u001b[39m\r\r\n\u001b[29G\u001b[K \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m     \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                       \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;