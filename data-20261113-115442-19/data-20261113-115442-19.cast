[51.432744, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ Volcanic Eruptions Table\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ Displays historical volcanic eruption data in a formatted table.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ import csv\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ from io import StringIO\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ Laki,1783,6,9350,Iceland\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ Unzen,1792,2,15000,Japan\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ Tambora,1815,7,71000,Indonesia\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ Krakatoa,1883,6,36000,Indonesia\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ Santa Maria,1902,6,6000,Guatemala\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ Mount Pel\u00e9e,1902,4,29000,Martinique\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ Mount St. Helens,1980,5,57,USA\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+126 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2