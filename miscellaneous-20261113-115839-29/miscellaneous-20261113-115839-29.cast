[33.742306, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Morse code encoding/decoding demo with round-trip verification.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ # Full Morse code dictionary (A-Z and 0-9)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ MORSE_DICT = {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     'A': '.-',    'B': '-...',  'C': '-.-.',  'D': '-..',   'E': '.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     'F': '..-.',  'G': '--.',   'H': '....',  'I': '..',    'J': '.---',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     'K': '-.-',   'L': '.-..',  'M': '--',    'N': '-.',    'O': '---',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     'P': '.--.',  'Q': '--.-',  'R': '.-.',   'S': '...',   'T': '-',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ }\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ # Reverse mapping for decoding\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ REVERSE_MORSE = {v: k for k, v in MORSE_DICT.items()}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ def encode_word_to_morse(word: str) -> str:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+60 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Conjuring \u001b[2m4.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m          \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m          \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                           \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
