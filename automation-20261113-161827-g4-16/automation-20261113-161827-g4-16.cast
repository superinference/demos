[59.20394, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[KNow let me run the three conversions.\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u2880\u28ba\u28d3\u28c0\u001b[39m \u001b[37m\u2808\u2809\u2809\u001b[39m            \u001b[36m\u2890\u2842\u001b[39m                      \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m         \u001b[35m\u2880\u28ba\u28d3\u28c0\u001b[39m \u001b[37m\u2808\u2809\u2809\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2814\u281d\u282b\u2863\u001b[2m\u2804\u001b[22m\u001b[39m               \u001b[36m\u2869\u288d\u001b[39m   \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                  \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m         \u001b[35m\u2819\u285f\u28bb\u284b\u001b[39m\r\r\n\u001b[65G\u001b[K\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m         \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m    \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248m22.0 tps \u00b7 \u21919.5k \u21931.0k \u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25