[30.459058, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[30.459774, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Temperature conversion functions with duplicated validation logic.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ def celsius_to_fahrenheit(celsius):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     \"\"\"Convert Celsius to Fahrenheit.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     Args:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+         celsius: Temperature in Celsius (must be >= -273.15)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+         TypeError: If input is not a number\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+         ValueError: If input is below absolute zero\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     # Duplicated validation logic\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     if not isinstance(celsius, (int, float)):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+         raise TypeError(f\"Input must be a number, got {type(celsius).__name__}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     if celsius < -273.15:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+50 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Tinkering \u001b[2m1.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m            \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2804\u001b[22m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m             \u001b[93m\u001b[2m\u2824\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m            \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[59G\u001b[K  \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580