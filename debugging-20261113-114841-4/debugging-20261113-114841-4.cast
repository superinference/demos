[75.759062, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ YAML Deserialization Vulnerability Demonstration\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ This demonstrates CVE-like behavior in yaml.load() vs yaml.safe_load()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ import os\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+ import sys\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ from pathlib import Path\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ args: ['echo \"System compromised via YAML deserialization\" > PWNED.txt']\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ \"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ def cleanup():\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+     \"\"\"Remove any existing PWNED.txt file\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     pwned_file = Path(\"PWNED.txt\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     if pwned_file.exists():\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+177 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m43.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[16G\u001b[K         \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m      \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                      \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K  