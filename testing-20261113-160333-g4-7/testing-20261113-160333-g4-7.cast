[48.009229, "o", "\u001b[29A\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mimport pytest\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mfrom utils import parse_range\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mclass TestParseRange:\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m     \"\"\"Test suite for parse_range function.\"\"\"\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mdef test_normal_positive_range(self):\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m         \"\"\"Should parse normal positive ranges like '1-5'.\"\"\"\r\r\n\u001b[14G\u001b[K\u001b[2m4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         assert parse_range('0-9') == (0, 9)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     def test_larger_numbers(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         \"\"\"Should parse ranges with larger numbers.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         assert parse_range('100-500') == (100, 500)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     def test_same_start_and_end(self):\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+47 more lines)\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[38;5;243m\u001b[39m\u001b[2m\u001b[22m\u001b[38;5;35m20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Marinating \u001b[2m2.1s\u001b[22m\r\r\n"]
[48.009277, "o", "\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file utils.py with a\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[20G\u001b[K\u001b[93m\u001b[39m     \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[39m                              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m    \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u2869\u288d\u001b[39m                              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                   \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m