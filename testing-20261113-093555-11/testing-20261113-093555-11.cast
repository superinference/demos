[51.811348, "o", "\u001b[29A\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mimport pytest\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mfrom utils import parse_duration\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mclass TestParseDurationBasic:\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m\"\"\"Basic happy-path tests\"\"\"\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mdef test_hours(self):\r\r\n\u001b[18G\u001b[K\u001b[2m\u001b[22massert parse_duration('3h') == 3 * 3600\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m     def test_seconds(self):\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    assert parse_duration('120s') == 120\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mdef test_single_unit(self):\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m         assert parse_duration('1h') == 3600\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    assert parse_duration('1m') == 60\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    assert parse_duration('1s') == 1\r\r\n\u001b[16G\u001b[K\u001b[2m86 more lines)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Simmering \u001b[2m4.2s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file utils.py with a\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[20G\u001b[K\u001b[93m\u001b[39m     \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m                             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m    \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m        \u001b[36m\u2879\u281d\u282f\u288b\u001b[2m\u2820\u001b[22m\u001b[39m                            \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[29G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;2