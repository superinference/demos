[47.860472, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[47.861101, "o", "\u001b[29A\u001b[E\u001b[13G\u001b[K\u001b[2m\u001b[22mCommand-line interface for unit converter.\"\"\"\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m import argparse\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mfrom conversions import CONVERSIONS\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m def parse_args():\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m     \"\"\"Parse command-line arguments.\"\"\"\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m    parser = argparse.ArgumentParser(\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m  - Distance: km \u2194 miles\r\r\n\u001b[12G\u001b[K\u001b[2m\u001b[22m- Weight:   kg \u2194 lbs\r\r\n\u001b[12G\u001b[K\u001b[2m\u001b[22m- Temperature: C \u2194 F\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m Examples:\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m  python main.py 100 km miles\r\r\n\u001b[12G\u001b[K\u001b[2m\u001b[22mpython main.py 70 kg lbs\r\r\n\u001b[16G\u001b[K\u001b[2m31 more lines)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Conjuring \u001b[2m0.2s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a small command-line u\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u001b[39m       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m       \u001b[32m\u001b[2m\u2820\u001b[22m\u2894\u281d\u282b\u2862\u001b[39m        \u001b[36m\u287d\u2839\u280f\u28af\u001b[2m\u2802\u001b[22m\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m       \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m       \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588