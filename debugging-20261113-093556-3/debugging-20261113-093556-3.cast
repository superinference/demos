[251.61873, "o", "\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 serve_file.py \u2014 the file server (now hardened)\r\r\n\u001b[1G\u001b[K\u2022 test_serve_file.py \u2014 3 tests\r\r\n\u001b[1G\u001b[K\u2022 data/greeting.txt \u2014 sample legitimate file\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mThe vulnerability (as requested, then fixed)\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe original used os.path.join(DATA_DIR, filename) with no validation. I confirmed it was\r\r\n\u001b[1G\u001b[Kexploitable \u2014 python3 serve_file.py ../../../../etc/passwd dumped real /etc/passwd contents. This is\r\r\n\u001b[1G\u001b[K\u001b[1mCWE-22 Path Traversal\u001b[22m.\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mThe fix\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[Krequested = os.path.realpath(os.path.join(DATA_DIR, filename))\r\r\n\u001b[1G\u001b[Kif os.path.commonpath([DATA_DIR, requested]) != DATA_DIR:\r\r\n\u001b[1G\u001b[K    raise PathTraversalError(...)\r\r\n\u001b[1G\u001b[Krealpath collapses ../ and resolves symlinks to a canonical absolute path; commonpath then enforces\r\r\n\u001b[1G\u001b[Kthat the result is genuinely \u001b[3minside\u001b[23m DATA_DIR.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mTest results\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K```\r\r\n\u001b[2G\u001b[Kest_leg\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called serve_fi\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
