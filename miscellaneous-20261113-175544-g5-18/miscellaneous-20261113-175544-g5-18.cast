[143.612012, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502    1  Successfully edited /tmp/ami-demo-GZFOap/raymarch.py\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m103  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m104  \u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m5  def render():\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m106-     cam = (0.0, 1.2, 5.0)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m107-     target = (0.0, 0.0, 0.0)\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m+     cam = (0.0, 1.6, 4.5)\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m+     target = (0.0, -0.1, 0.0)\r\r\n\u001b[6G\u001b[K\u001b[2m108      light_pos = (4.0, 5.0, 3.0)\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m109  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m10      # Build a simple camera basis.\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%####...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe raymarcher renders correctly. You can see both spheres (large one left-of-center, smaller one\r\r\n\u001b[1G\u001b[Kright), their soft contact shadows cast onto the ground plane, and ambient-occlusion darkening where\r\r\n\u001b[1G\u001b[Kthe spheres meet the floor.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mWhat's in raymarch.py\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K| Component\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m \u001b[22m\u001b[38;5;75m\u2191 57 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a self-contained Pytho\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
