[206.657957, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K \u001b[92m\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u001b[2m\u001b[22m\u28a0\u28fa\u2877\u2843\u001b[39m              \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m        \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[33m\u2880\u2874\u28ff\u28a6\u2840\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2890\u281d\u2808\u2802\u001b[39m             \u001b[36m\u001b[2m\u2804\u001b[22m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m        \u001b[35m\u2899\u287f\u28bf\u284b\u001b[39m \u001b[33m\u2808\u2897\u283f\u287a\u2801\u001b[39m\r\r\n\u001b[39G\u001b[K \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m           \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[13G\u001b[K\u001b[36m\u001b[2mo\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38