[24.272092, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ from typing import List, Union\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ @dataclass(frozen=True)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ class Token:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     kind: str\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     tokens: List[Token] = []\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     index = 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     while index < len(source):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         character = source[index]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         if character.isspace():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+             index += 1\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         elif character.isdigit():\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+125 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Expression Result) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated arithmetic_demo.py in the current directory. It includes:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K- Tokenizer\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m                                   \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m                                   \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[2G\u001b[K\u001b[38;5;248m86.0 tps \u00b7 \u219114k \u21931.1k \u00b7 Ctrl+B bg\u001b[39m               \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
