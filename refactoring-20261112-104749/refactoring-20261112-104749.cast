[20.242, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from concurrent.futures import ThreadPoolExecutor\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ from time import perf_counter, sleep\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ TASK_COUNT = 12\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ SLEEP_SECONDS = 0.05\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     return task_id, checksum\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def main() -> None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     start = perf_counter()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     serial_results = [task(task_id) for task_id in range(TASK_COUNT)]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     serial_seconds = perf_counter() - start\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+18 more lines)\u001b[22m\r\r\n"]
[20.242104, "o", "\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mpython3 \"/tmp/ami-demo-oDujj8/parallel_demo.py\"\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\\\u001b[39m bash python3 \"/tmp/ami-demo-oDujj8/parallel_demo.py\" \u001b[2m0.9s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[32m\u2880\u28fa\u28d7\u28c0\u001b[39m \u001b[37m\u2814\u2813\u281a\u2802\u001b[39m  \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m               \u001b[35m\u2880\u28fa\u28d7\u28c0\u001b[39m \u001b[37m\u2814\u2813\u281a\u2802\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u2814\u281f\u282b\u2862\u001b[39m \u001b[32m\u001b[2m\u2824\u001b[22m\u001b[39m     \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m               \u001b[35m\u2819\u285f\u28bb\u284b\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u001b[2m\u2812\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                        \u001b[35m\u001b[2m\u2809\u001b[22m\u001b[39m   \u001b[35m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m                         \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u