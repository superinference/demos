[210.844992, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[24G\u001b[K \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u2830\u28fa\u2817\u28d4\u001b[39m               \u001b[33m\u28cb\u28df\u2869\u28b0\u001b[39m       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[24G\u001b[K \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m     \u001b[36m\u001b[2m\u2802\u001b[22m\u2828\u2819\u288f\u288e\u001b[39m               \u001b[33m\u2871\u2810\u281d\u280d\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[26G\u001b[K              \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m               \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m            \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[15G\u001b[K\u001b[35m\u001b[2mr\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u