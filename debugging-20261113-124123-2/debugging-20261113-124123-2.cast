[60.580645, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[60.580928, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ pq = PriorityQueue()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ # Insert tasks with priorities\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ priorities = [3, 15, 100, 7, 42]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ for p in priorities:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     pq.insert(p, f\"task_{p}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     print(f\"Inserted task with priority {p}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m0+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ print(\"\\nPopping tasks (should pop highest priority first):\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ while True:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     item = pq.pop_highest()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     if item is None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         break\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     priority, task_name = item\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m17+     print(f\"Popped: priority={priority}, task={task_name}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KRun the buggy version to show the wrong output:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Inserted task with priority 3) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Noodling \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[53G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m                                \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[E\u001b[28G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                      \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m                                   \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
