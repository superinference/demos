[26.563544, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Deterministic terminal mystery: solve a culprit hidden in a star graph.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ from __future__ import annotations\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ from dataclasses import dataclass\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ import re\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ from collections import deque\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     \"LINK: Altair -> Deneb\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     \"LINK: Sirius -> Polaris\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     \"LINK: Deneb -> Rigel\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     \"LINK: Rigel -> Betelgeuse\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     \"LINK: Polaris -> Betelgeuse\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     \"TARGET: the last star on the linked trail from Vega\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ )\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+97 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;136m\u001b[39mHyperspacing \u001b[2m12.6s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K\u001b[93m\u001b[39m           \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m     \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                                 \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u001b[39m           \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m   \u001b[36m\u287d\u2809\u283f\u2809\u28af\u001b[39m                                 \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                   \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m    \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[35m\u001b[2m Hype  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
