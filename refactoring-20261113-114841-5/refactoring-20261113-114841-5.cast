[186.798712, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m  2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m328      {\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m329          'name': 'Almond Butter Smoothie',\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m330          'servings': 1,\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m331-         'ingredients': ['2 tbsp almond butter', '200 ml milk', '1 banana', '0.5 oz honey\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m332-         'protein_g': 10.0,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m333-         'fat_g': 12.0,\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m334-         'carbs_g': 35.0,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m335-         'fiber_g': 3.0,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m336-     },\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502       ... 45 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m354+     },\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m355+     {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m356+         'name': 'Chocolate Avocado Mousse',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m357+         'servings': 2,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m358+         'ingredients': ['150 g avocado', '2 oz dark chocolate', '1 cup almond milk', '1\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  359          'protein_g': 6.0,\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  360          'fat_g': 18.0,\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  361          'carbs_g': 22.0,\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+28\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-28\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25