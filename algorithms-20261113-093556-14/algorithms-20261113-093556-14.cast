[81.750187, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[20G\u001b[K\u001b[32m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2828\u287b\u2866\u2840\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                                \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[39m\u001b[32m\u2805\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m    \u001b[35m\u2899\u287f\u28bf\u284b\u001b[39m \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m                              \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n\u001b[43G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m  \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[81.750396, "o", "\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[81.824039, "o", "\u001b]2;\u2b22 AMI \u00b7 Dijkstra's Algorithm: Shortest Path Implementation\u0007"]
[81.825745, "o", "\u001b]7501;waiting\u0007"]
[81.83657, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[81.836877, "o", "\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mGraph class\u001b[22m: Uses an adjacency list (defaultdict) to store weighted edges\r\r\n\u001b[3G\u001b[K\u001b[1mDijkstra's algorithm\u001b[22m: Uses a min-heap priority queue to efficiently select the next closest\r\r\n\u001b[1G\u001b[Kunvisited node, maintaining distances and previous node pointers to reconstruct the path\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mSample graph\u001b[22m: 6 nodes (A-F) with 8 directed edges of varying weights\r\r\n\u001b[3G\u001b[K\u001b[1mOutput\u001b[22m: Displays all edges, then computes and displays the shortest path A \u2192 F\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mResult:\u001b[22m The shortest path from A to F is \u001b[1mA \u2192 B \u2192 D \u2192 F\u001b[22m with a total cost of \u001b[1m15\u001b[22m (weights: 4 + 5 + 6).\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe algorithm works correctly because Dijkstra's algorithm greedily selects the closest unvisited\r\r\n\u001b[1G\u001b[Knode at each step, which guarantees the shortest path for graphs with non-negative weights.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- Dijkstra's algorithm uses a priority queue (min-heap) to always process the closest unvisited node\r\r\n\u001b[1G\u001b[K first, ensuring greedy selection yields the global optimum for non-negative weights\r\r\n\u001b[1G\u001b[K- The path reconstruction works backward from the end node using the `previous` pointers built\r\r\n\u001b[1G\u001b[Kduring exploration, then reversed to get the forward path\r\r\n\u001b[1G\u001b[K- This implementation is O((V + E) log V) where V = nodes and E = edges, efficient for sparse graphs\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Brewed for 1m 10s \u00b7 done 10:37 AM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mDijkstra's Algorithm: Shortes\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: --skill <name> pins a skill stance (e.g. pentest, swebench)\u001b[22m\r\r\n\u001b[18G\u001b[K                                       \u001b[93m\u2880\u28e0\u2840\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[93m\u28f4\u28bb\u28e7\u281f\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m \u001b[32m\u001b[2m\u2808\u001b[22m\u001b[39m              \u001b[36m\u2869\u288d\u001b[39m                \u001b[93m\u2808\u283b\u2807\u001b[39m                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u001b[2m"]
