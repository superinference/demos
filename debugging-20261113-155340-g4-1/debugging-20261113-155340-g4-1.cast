[44.117084, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ numbers = [float(x) for x in data]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+ # Compute mean and median\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+ mean = statistics.mean(numbers)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+ median = statistics.median(numbers)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ print(f\"Mean: {mean}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ print(f\"Median: {median}\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow create data.txt:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m[Checkpoint cp-1794585320350-2: /tmp/ami-demo-sRHDi2/data.txt]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25bc \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan file_edit(/tmp/ami-demo-sRHDi2/data.txt) +1 -0 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K  \u001b[38;5;35m\u2713\u001b[39m \u001b[1m\u001b[38;5;167mfile_edit\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243m/tmp/ami-demo-sRHDi2/data.txt\u001b[39m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;35m(+1)\u001b[39m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;35m51 tok\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u23bf  diff \u00b7 \u001b[1m\u001b[38;5;75m/tmp/ami-demo-sRHDi2/data.txt\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m0  Created new file: /tmp/ami-demo-sRHDi2/data.txt\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m1  Successfully wrote /tmp/ami-demo-sRHDi2/data.txt (new file, 1 lines)\u001b[22m\r\r\