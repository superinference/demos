[98.390281, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4- # 20 daily temperature data points (in Fahrenheit)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5- temperatures = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-     72, 75, 68, 71, 76, 79, 81, 78, 74, 70,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-     69, 73, 77, 80, 82, 75, 72, 71, 76, 78\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8- ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 50 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m0+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ # Print formatted table\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ print(f\"{'Statistic':<20} | {'Value':<40}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ print(\"-\" * 65)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ for stat, value in summary_data:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     print(f\"{stat:<20} | {value:<40}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m37+ print(\"=\" * 65)\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+36\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-30\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Noodling \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[28G\u001b[K\u001b[32m\u28a0\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m   \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u2894\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m   \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[29G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[35G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001