[48.43961, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         window = nums[i:i + k]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         result.append(max(window))\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     return result\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ def run_tests():\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         ([4, 2, 12, 11, -5], 2, [4, 12, 12, 11]),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     all_pass = True\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     for nums, k, expected in cases:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         actual = sliding_window_max(nums, k)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+         status = \"PASS\" if actual == expected else \"FAIL\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         if actual != expected:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+7 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it to observe the failure:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(FAIL: sliding_window_max([1, 3, -1, -3, 5, 3, 6...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Tinkering \u001b[2m0.0s\u001b[22m\r"]
[48.439627, "o", "\r\n\u001b[E\u001b[E\u001b[E\u001b[77G\u001b[K\u001b[93m\u001b[39m\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[29G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m       \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                      \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
