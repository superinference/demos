[49.282626, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[KNow the test file capturing current output\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[4G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m          \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[4G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m       \u001b[32m\u001b[2m\u2820\u001b[22m\u2894\u281d\u282b\u2862\u001b[39m              \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m                                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[5G\u001b[K\u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m               \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                    \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248m13.0 tps \u00b7 \u21919.6k \u2193491 \u00b7\u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u