[20.815861, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ from time import perf_counter\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def has_duplicates_slow(values):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     for index, value in enumerate(values):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         for previous in values[:index]:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+             if value == previous:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+                 return True\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     return False\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ def main():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     values = list(range(12000)) + [11999]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     start = perf_counter()\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     slow_result = has_duplicates_slow(values)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(before: 0.769951s | after: 0.000372s | speedup:...) 0.8s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Noodling \u001b[2m0.6s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                   \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                   \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[70G\u001b[K\u001b[36m\u001b[2m\u001b[22m\u001b[39m\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
