[34.511572, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[34.51264, "o", "\u001b[29A\u001b[8G\u001b[K\u001b[2m\u001b[22m+     with ThreadPoolExecutor(max_workers=min(TASK_COUNT, 4)) as executor:\r\r\n\u001b[6G\u001b[K\u001b[2m24          threaded_results = list(executor.map(task, range(TASK_COUNT)))\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m5      threaded_seconds = perf_counter() - start\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m6  \u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Results match: yes | serial: 0.607s | threads: ...) 0.8s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated and ran /tmp/ami-demo-oDujj8/parallel_demo.py.\r\r\n\u001b[1G\u001b[KFinal result:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KResults match: yes | serial: 0.607s | threads: 0.154s | speedup: 3.94x\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[E\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- `ThreadPoolExecutor` is effective here because each task spends time sleeping, allowing other\r\r\n\u001b[1G\u001b[Kthreads to run.\r\r\n\u001b[1G\u001b[K- `executor.map` preserves input order, making direct result comparison with the serial version\r\r\n\u001b[1G\u001b[Kstraightforward.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Brewed for 23s \u00b7 done 10:48 AM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate parallel_demo.py Threa\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: /provision spins up a remote GPU pod to run on\u001b[22m\r\r\n\u001b[19G\u001b[K                                      \u001b[93m\u2880\u2840\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n"]
