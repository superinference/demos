[49.826238, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import math\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ import random\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ NEEDLES = 500_000\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ LENGTH = 1.0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ SPACING = 1.0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ def simulate(n, length=LENGTH, spacing=SPACING):\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         center = random.uniform(0, spacing / 2.0)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         angle = random.uniform(0, math.pi / 2.0)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         if center <= half * math.sin(angle):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+             crossings += 1\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     return crossings\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+23 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Buffon's Needle - Monte Carlo estimation of pi) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Hyperspacing \u001b[2m16.8s\u001b[22m\r\r\n\u001b[E\