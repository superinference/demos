[98.334903, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5- temperatures = [\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6-     72, 75, 68, 71, 76, 79, 81, 78, 74, 70,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-     69, 73, 77, 80, 82, 75, 72, 71, 76, 78\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8- ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9-\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 50 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m30+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m31+ # Print formatted table\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m32+ print(f\"{'Statistic':<20} | {'Value':<40}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m33+ print(\"-\" * 65)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m34+ for stat, value in summary_data:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     print(f\"{stat:<20} | {value:<40}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ print(\"=\" * 65)\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+36\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-30\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-u9tw2y && python stats.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-u9tw2y && python stats.py \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python file stats.py\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[28G\u001b[K\u001b[32m\u2880\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[37m\u2809\u2809\u2801\u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u2880\u28ba\u28d3\u2840\u001b[39m \u001b[37m\u2809\u2809\u2801\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u2814\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m   \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                                \u001b[35m\u2819\u287f\u28ba\u284b\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[29G\u001b[K\u001b[32m\u001b[2m\u2812\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n"]
