[184.888274, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[19G\u001b[KMultiply::test_multiply_by_one PASSED                  [ 64%]\r\r\n\u001b[19G\u001b[KMultiply::test_multiply_floats PASSED                  [ 68%]\r\r\n\u001b[19G\u001b[KDivide::test_divide_positive_numbers PASSED            [ 72%]\r\r\n\u001b[19G\u001b[KDivide::test_divide_negative_numbers PASSED            [ 76%]\r\r\n\u001b[19G\u001b[KDivide::test_divide_mixed_signs PASSED                 [ 80%]\r\r\n\u001b[19G\u001b[KDivide::test_divide_with_remainder PASSED              [ 84%]\r\r\n\u001b[19G\u001b[KDivide::test_divide_zero_numerator PASSED              [ 88%]\r\r\n\u001b[19G\u001b[KDivide::test_divide_by_zero PASSED                     [ 92%]\r\r\n\u001b[39G\u001b[Kfloats PASSED                      [ 96%]\r\r\n\u001b[39G\u001b[Kby_one PASSED                      [100%]\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K============================== 25 passed in 0.02s ==============================\r\r\n\u001b[1G\u001b[K\u001b[1mSummary\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mcalc.py\u001b[22m contains four functions:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 add(a, b) - adds two numbers\r\r\n\u001b[1G\u001b[K\u2022 subtract(a, b) - subtracts b from a\r\r\n\u001b[3G\u001b[Kmultiply(a, b) - multiplies two numbers\r\r\n\u001b[3G\u001b[Kdivide(a, b) - divides a 