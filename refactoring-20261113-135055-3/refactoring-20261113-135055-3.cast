[33.635814, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ def process_records(records):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     results = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     # pending block\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     pending = [r for r in records if r[\"status\"] == \"pending\"]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     count = len(pending)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     total_value = sum(r[\"value\"] for r in pending)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     avg_value = total_value / count if count else 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     results.append({\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     })\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     # active block\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     active = [r for r in records if r[\"status\"] == \"active\"]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     count = len(active)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     total_value = sum(r[\"value\"] for r in active)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     avg_value = total_value / count if count else 0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+32 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \