[38.22266, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Terminal report of famous volcanic eruptions.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ import json\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ DATA = json.loads(\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ [\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+   {\"volcano\": \"Tambora\",        \"year\": 1815, \"country\": \"Indonesia\",      \"vei\": 7, \"dea\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+   {\"volcano\": \"Krakatoa\",       \"year\": 1883, \"country\": \"Indonesia\",      \"vei\": 6, \"dea\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+   {\"volcano\": \"Pinatubo\",       \"year\": 1991, \"country\": \"Philippines\",    \"vei\": 6, \"dea\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+   {\"volcano\": \"St. Helens\",     \"year\": 1980, \"country\": \"United States\",  \"vei\": 5, \"dea\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ ]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ \"\"\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ def banner(text):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+40 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-gSUqxY && python3 volcano_report.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m/\u001b[39m bash cd /tmp/ami-demo-gSUqxY && python3 volcano_report.py \u001b[2m0.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[36m\u001b[39m\u001b[35m\u001b[32m\u001b[39m                    \u001b[33m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[55G\u001b[K\u001b[36m\u001b[39m\u001b[35m\u001b[32m\u001b[2m\u001b[22m\u001b[39m                     \u001b[33m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[33m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m            \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588