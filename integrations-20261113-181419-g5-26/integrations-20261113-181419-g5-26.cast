[302.176171, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                     \u001b[92m\u28de\u28d3\u2840\u001b[39m  \u001b[37m\u284e\u28b1\u001b[39m     \u001b[36m\u28a0\u28ff\u2844\u001b[39m                          \u001b[35m\u28de\u28d3\u2840\u001b[39m  \u001b[37m\u284e\u28b1\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                    \u001b[92m\u2814\u28bd\u282b\u2862\u001b[39m \u001b[92m\u001b[2m\u2804\u001b[22m\u001b[37m\u2808\u001b[39m      \u001b[36m\u287d\u283f\u28af\u001b[39m                         \u001b[35m\u2819\u28ff\u28ab\u2843\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[37m\u2808\u001b[39m\r\r\n\u001b[6G\u001b[K                    \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[92m\u001b[2mL\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210