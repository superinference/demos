[249.031465, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[37G\u001b[K\u001b[32m\u001b[39m\u001b[37m\u001b[39m\u001b[36m\u28b0\u285e\u28f7\u2841\u001b[39m                \u001b[93m\u28d4\u28f7\u28fe\u28e2\u001b[39m \u001b[37m\u28d4\u28f7\u28fe\u28e2\u001b[39m         \u001b[35m\u2811\u2884\u2860\u280a\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2814\u2801\u2808\u2822\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m          \u001b[36m\u285f\u289f\u288e\u28c4\u001b[39m                \u001b[93m\u2811\u281f\u283b\u280a\u001b[2m\u2824\u001b[22m\u001b[37m\u2811\u281f\u283b\u280a\u001b[39m         \u001b[35m\u2814\u2801\u2808\u2822\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;