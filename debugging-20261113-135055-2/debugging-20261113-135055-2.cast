[51.213328, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[51.213675, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1- def top_scorers(records, threshold):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2-     names = []\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3-     for record in records:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4-         # \u001b[32mBUG:\u001b[39m comparing the string score directly to the numeric threshold.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5-         # In Python 3 \"95\" > 90 raises TypeError, but using != / == style\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6-         # string comparison silently misbehaves. Here we compare raw string.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7-         if record[\"score\"] > threshold:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8-             names.append(record[\"name\"])\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-     return names\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ def top_scorers(records, threshold):\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 2 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+         # \u001b[32mBUG:\u001b[39m record[\"score\"] is a string. We compare it against the\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+         # threshold coerced to a string, so Python does a *lexicographic*\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+         # string comparison instead of a numeric one. This never raises an\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+         # error, it just silently returns wrong results (e.g. \"100\" < \"90\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+         # lexicographically because '1' < '9').\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         if record[\"score\"] > str(threshold):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+             names.append(record[\"name\"])\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m11+     return names\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+11\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-9\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Crystallizing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called scores.p\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[39m                   \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m       \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2802\u001b[22m\u001b[39m        \u001b[36m\u284d\u28a9\u001b[39m                   \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580