[82.563519, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[82.564204, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K## Options\r\r\n\u001b[E\u001b[1G\u001b[K| Option | Format | Required | Notes |\r\r\n\u001b[1G\u001b[K|--------|--------|----------|-------|\r\r\n\u001b[1G\u001b[K| `--start` | `YYYY-MM-DD HH:MM:SS` | Yes | Earliest timestamp to include (inclusive) |\r\r\n\u001b[1G\u001b[K| `--end` | `YYYY-MM-DD HH:MM:SS` | No | Latest timestamp to include (inclusive); defaults to end of\r\r\n\u001b[1G\u001b[K file |\r\r\n\u001b[1G\u001b[K| `--severity` | `LEVEL1,LEVEL2,\u2026` | No | Comma-separated severity levels (e.g., `ERROR,WARN`);\r\r\n\u001b[1G\u001b[Kdefaults to all |\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## Supported severity levels\r\r\n\u001b[E\u001b[1G\u001b[K`DEBUG`, `INFO`, `WARN`, `ERROR`, `CRITICAL`\r\r\n\u001b[E\u001b[1G\u001b[K## How it works\r\r\n\u001b[E\u001b[1G\u001b[K- Reads log file line-by-line; memory usage is O(1) relative to file size.\r\r\n\u001b[1G\u001b[K- Detects timestamp and severity from standard log formats (ISO 8601, syslog, JSON).\r\r\n\u001b[20G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m7 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mActivate the cognitive-doc-de\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[82.647652, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K## Options\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K| Option | Format | Required | Notes |\r\r\n\u001b[2G\u001b[K--------|--------|----------|-------|\r\r\n\u001b[2G\u001b[K `--start` | `YYYY-MM-DD HH:MM:SS` | Yes | Earliest timestamp to include (inclusive) |\r\r\n\u001b[6G\u001b[Kend` | `YYYY-MM-DD HH:MM:SS` | No | Latest timestamp to include (inclusive); defaults to end of\r\r\n\u001b[1G\u001b[K file |\r\r\n\u001b[1G\u001b[K| `--severity` | `LEVEL1,LEVEL2,\u2026` | No | Comma-separated severity levels (e.g., `ERROR,WARN`);\r\r\n\u001b[1G\u001b[Kdefaults to all |\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## Supported severity levels\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K`DEBUG`, `INFO`, `WARN`, `ERROR`, `CRITICAL`\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## How it works\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K- Reads log file line-by-line; memory usage is O(1) relative to file size.\r\r\n\u001b[3G\u001b[KDetects timestamp and severity from standard log formats (ISO 8601, syslog, JSON).\r\r\n\u001b[3G\u001b[KOutputs matching entries in original format.\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
