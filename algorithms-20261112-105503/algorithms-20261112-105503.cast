[19.688701, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[2mOutput:\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2mMonte Carlo \u03c0 estimate using 1,000,000 samples\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2mEstimated \u03c0: 3.1430360000\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2mAbsolute error: 0.\u001b[22m\r\r\n\u001b[19G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m3 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate estimate_pi.py in the \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[3G\u001b[K\u001b[38;5;248m2.0 tps \u00b7 \u219113k \u2193275 \u00b7 Ctrl+B bg\u001b[39m                \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
