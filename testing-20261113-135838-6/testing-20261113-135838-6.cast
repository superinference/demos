[110.836449, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ class TestAdd:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     \"\"\"Tests for add function.\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     def test_add_negative_numbers(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         \"\"\"Add two negative integers.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         assert calc.add(-5, -3) == -8\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     def test_add_mixed_signs(self):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+         \"\"\"Add positive and negative number.\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         assert calc.add(10, -4) == 6\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+106 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(bash: line 1: pytest: command not found) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KLet me install pytest first:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(error: externally-managed-environment) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m