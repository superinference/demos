[88.96634, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u2022 test_invalid_inputs \u2014 11 cases including '', 'abc', '5x', None, plus extras ('5', '3.5h', '3H',\r\r\n\u001b[1G\u001b[K-5m, etc.).\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mpytest result:\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K============================== 18 passed in 0.01s ==============================\r\r\n\u001b[1G\u001b[KAll 18 tests passed (exit code 0) on Python 3.14.4 / pytest 9.2.0.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- Anchoring the regex with `^...$` is what makes `'3 h'` and `'3.5h'` fail \u2014 without the anchors,\r\r\n\u001b[1G\u001b[K`re.match` would accept a valid prefix and silently ignore trailing junk.\r\r\n\u001b[1G\u001b[K- The explicit `isinstance(s, str)` guard matters because `None` (and `10`) would otherwise crash in\r\r\n\u001b[1G\u001b[K `re.match` with a `TypeError`, not the `ValueError` the contract promises \u2014 converting it keeps the\r\r\n\u001b[1G\u001b[K error type consistent for callers.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Forged for 1m 15s \u00b7 done 3:00 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[1.5m | 33379 tokens | $0.02] Done in 3 turns \u00b7 done 3:00 PM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[7G\u001b[K\u001b[2m/model switches the active model mid-session\u001b[22m\r\r\n\u001b[57G\u001b[K\u001b[93m\u001b[2m\u2880\u28e0\u2840\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m                                  \u001b[93m\u001b[2m\u28f4\u28bb\u28e7\u281f\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u2804\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[22m\u001b[39m              \u001b[93m\u001b[2m\u2808\u283b\u2807\u001b[22m\u001b[39m                \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                 \u001b[36m\u001b[2m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[22m\u001b[39m                                 \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u2808\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[32m\u001b[2m Mentor  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m