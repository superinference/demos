[47.406746, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Self-contained SDF raymarcher rendering ASCII art to the terminal.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ Renders two spheres on a ground plane with Lambert shading, soft shadows,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ and ambient occlusion. Standard library only.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ import math\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ MAX_STEPS = 96\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ MAX_DIST = 50.0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ SURF_EPS = 0.001\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ # Darkest -> brightest ramp.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ GRADIENT = \" .:-=+*#%@\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+132 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n