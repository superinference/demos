[141.124893, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;203m/\u001b[39m Percolating \u001b[38;5;136m21.9s\u001b[38;5;172m (reasoning\u2026)\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[24G\u001b[K\u001b[32m\u28a0\u28ba\u28d7\u2844\u001b[39m         \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[93m\u28d0\u28be\u2877\u2884\u001b[2m\u2809\u001b[22m\u001b[39m       \u001b[35m\u2826\u287b\u28ce\u2807\u001b[39m\r\r\n\u001b[24G\u001b[K\u001b[32m\u2890\u283d\u282b\u28c2\u001b[39m         \u001b[36m\u2879\u281d\u282f\u288b\u001b[2m\u2802\u001b[22m\u001b[39m              \u001b[93m\u2839\u287a\u28b7\u280f\u001b[39m        \u001b[35m\u2838\u285f\u2823\u28c0\u001b[39m\r\r\n\u001b[24G\u001b[K    \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m                             \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u