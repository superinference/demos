[90.772345, "o", "[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l\u001b]2;\u2839 AMI \u00b7 Buffon's Needle \u03c0 Estimation Script\u0007"]
[90.786023, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[90.786164, "o", "\u001b[29A\u001b[1G\u001b[Kcrossings when length == spacing.\r\r\n\u001b[E\u001b[1G\u001b[KThe run landed within \u001b[1m~0.11%\u001b[22m of true \u03c0 \u2014 typical for 500k samples. Monte Carlo error shrinks like\r\r\n\u001b[1G\u001b[K1/\u221aN, so to get one more decimal digit of reliable accuracy you'd need roughly 100\u00d7 more needles.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The simulation needs no actual (x, y) coordinates \u2014 only the *relative* distance to the nearest\r\r\n\u001b[1G\u001b[Kline and the angle matter, which is why sampling `center` on `[0, spacing/2]` is sufficient and\r\r\n\u001b[1G\u001b[Kkeeps it fast.\r\r\n\u001b[1G\u001b[K- \u03c0 appears in the answer because `angle` is sampled uniformly and `sin` is integrated over it \u2014 the\r\r\n\u001b[1G\u001b[K `\u03c0/2` range of the angle is what injects \u03c0 into the crossing probability.\r\r\n\u001b[1G\u001b[K- `1/\u221aN` convergence is the fundamental Monte Carlo trade-off: accuracy improves only with the\r\r\n\u001b[1G\u001b[Ksquare root of sample count, so brute-forcing extra digits gets expensive fast.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: how-it-works.md (27 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Cooked for 1m 17s \u00b7 done 12:56 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[1.5m | 31973 tokens | $0.03] Done in 3 turns \u00b7 done 12:56 PM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[11G\u001b[K\u001b[2mAgents tab lets you drill into each running flow\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m                                                       \u001b[93m\u001b[2m\u28e0\u28be\u2877\u28c4\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m               \u001b[36m\u001b[2m\u28a0\u28fa\u28d7\u2844\u2802\u001b[22m\u001b[39m                                 \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[93m\u2877\u001b[22m\u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[36m\u001b[2m\u287d\u2839\u280f\u28af\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u2808\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n"]
[90.786242, "o", "\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
