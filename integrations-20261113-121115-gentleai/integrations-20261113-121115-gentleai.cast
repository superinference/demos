edge-case verification.                                        \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mChunking\u001b[22m                \u2502 Short, single-purpose sections; no long flat lists.                    \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mSignposting\u001b[22m             \u2502 Clear ## headings label every zone.                                    \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mRecognition over recall\u001b[22m \u2502 Three tables (options, exit codes) + runnable examples + a verificatio \u2502\r\r\n\u001b[3G\u001b[K                        \u2502 n checklist instead of prose.                                          \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mReview empathy\u001b[22m          \u2502 `                                                                      \u2502\r\r\n\u001b[E\u001b[20G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m2 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mInvoke the cognitive-doc-desi\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u25