[50.385546, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Parse an inline wildlife habitat survey (JSON) and print a concise report.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ import json\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ from collections import Counter\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ from statistics import mean\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ # --- Inline survey data -----------------------------------------------------\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ # Replace this string with your actual survey JSON. The report logic below\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     \"site\": \"Willow Creek Wetland\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     \"region\": \"Pacific Northwest\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     \"date\": \"2026-10-18\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     \"surveyors\": [\"A. Rivera\", \"J. Okafor\"],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     \"area_hectares\": 42.5,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     \"observations\": [\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+       {\"species\": \"Great Blue Heron\", \"type\": \"bird\",    \"count\": 6,  \"status\": \"least_co\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+109 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u