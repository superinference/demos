[203.493808, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[38G\u001b[K\u001b[92m\u001b[39m\u001b[37m\u001b[39m\u001b[36m\u28ff\u28ff\u28e2\u2844\u001b[39m              \u001b[33m\u28c0\u28b4\u287f\u28e6\u001b[39m               \u001b[35m\u284e\u2809\u2809\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m\r\r\n\u001b[36G\u001b[K\u001b[92m\u001b[39m\u001b[37m\u001b[39m\u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m              \u001b[33m\u2819\u28be\u2877\u280b\u001b[39m               \u001b[35m\u2808\u281d\u2809\u2801\u001b[2m\u2820\u001b[22m\u001b[37m\u2808\u281d\u2809\u2801\u001b[39m\r\r\n\u001b[39G\u001b[K\u001b[92m\u001b[2m\u001b[22m\u001b[39m                                     \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u00