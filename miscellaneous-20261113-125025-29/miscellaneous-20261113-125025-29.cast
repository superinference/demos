[148.541643, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[32m\u289b\u28d3\u28e1\u001b[39m \u001b[37m\u2808\u2801\u2801\u2890\u001b[39m           \u001b[36m\u2890\u2842\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                 \u001b[35m\u289b\u28d3\u28e1\u001b[93m\u28e0\u001b[37m\u2808\u2801\u2801\u2890\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u282b\u2863\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[37m\u2810\u2808\u001b[39m          \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[36m\u284d\u28a9\u001b[39m                                   \u001b[35m\u2819\u285f\u28ab\u2843\u001b[93m\u2819\u28be\u001b[37m\u2810\u2808\u001b[39m\r\r\n\u001b[20G\u001b[K                     \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                    \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m    \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[12G\u001b[K\u001b[36m\u001b[2mT\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[148.605786, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[148.605991, "o", "\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K1. \u001b[1mMaze Generation\u001b[22m (Recursive Backtracking):\r\r\n\u001b[1G\u001b[K  \u25e6 Creates a 21\u00d721 grid, all initially walls (1s)\r\r\n\u001b[1G\u001b[K  \u25e6 Starts at (1,1) and carves paths (0s) by randomly visiting unvisited neighbors\r\r\n\u001b[1G\u001b[K  \u25e6 Uses a stack to backtrack when hitting dead ends\r\r\n\u001b[5G\u001b[KResults in a perfect maze (single solution path)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K2. \u001b[1mMaze Solving\u001b[22m (BFS):\r\r\n\u001b[5G\u001b[KFinds the shortest path from top-left (1,1) to bottom-right (19,19)\r\r\n\u001b[1G\u001b[K  \u25e6 Uses breadth-first search to guarantee the shortest solution\r\r\n\u001b[1G\u001b[K  \u25e6 Returned a path of 133 steps\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K3. \u001b[1mVisualization\u001b[22m:\r\r\n\u001b[5G\u001b[K\u001b[1m\u2588\u001b[22m = walls (grid value 1)\r\r\n\u001b[1G\u001b[K  \u25e6 \u001b[1m\u00b7\u001b[22m (in green) = solution path\r\r\n\u001b[1G\u001b[K  \u25e6 \u001b[1mspaces\u001b[22m = open paths not on the solution\r\r\n\u001b[5G\u001b[KFixed seed of 42 ensures reproducibility\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe green dots form a continuous path from the top-left corner to the bottom-right corner,\r\r\n\u001b[1G\u001b[Ksuccessfully navigating through the maze!\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
