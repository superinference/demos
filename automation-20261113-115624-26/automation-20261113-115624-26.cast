[61.276835, "o", "\u001b[29A\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m# Maze Solver\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m A Python script that generates a random maze and solves it with visualization.\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m## What It Does\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m- \u001b[1m**Generates**\u001b[22m a 15\u00d715 maze using the recursive backtracking algorithm\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m- \u001b[1m**Solves**\u001b[22m the maze from top-left to bottom-right using breadth-first search (BFS)\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m- \u001b[1m**Visualizes**\u001b[22m the maze with the solution path marked using ASCII characters\r\r\n\u001b[14G\u001b[K\u001b[2m5 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ ### Solving: Breadth-First Search (BFS)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ Explores the maze level-by-level from the start position, ensuring the shortest path is f\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ ## Running\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+12 more lines)\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m2  [Auto-formatted]\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Hyperspacing \u001b[2m1.2s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mWrite a Python script called \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m  \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m        \u001b[36m\u287d\u2809\u283f\u2809\u28af\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[27G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                 \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
