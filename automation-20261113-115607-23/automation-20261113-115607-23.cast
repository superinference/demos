[72.050078, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[72.050471, "o", "\u001b[29A\u001b[E\u001b[15G\u001b[K\u001b[2m\u001b[22mingredients import Recipe\r\r\n\u001b[15G\u001b[K\u001b[2m\u001b[22mtyping import List\r\r\n\u001b[E\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mdef format_recipe(recipe: Recipe) -> str:\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m    \"\"\"Format a recipe as a pretty shopping list with aligned columns.\"\"\"\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mlines = []\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mlines.append(f\"\\n{'='*70}\")\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mlines.append(f\"{recipe.name.upper()}\")\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m        lines.append(\"No ingredients.\\n\")\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m         return \"\\n\".join(lines)\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m# Calculate column widths for alignment\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mqty_width = max(len(\"Qty\"), max(len(_format_qty(ing.quantity)) for ing in recipe.ingr\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22munit_width = max(len(\"Unit\"), max(len(ing.unit) for ing in recipe.ingredients))\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m    name_width = max(len(\"Ingredient\"), max(len(ing.name) for ing in recipe.ingredients))\r\r\n\u001b[16G\u001b[K\u001b[2m45 more lines)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Hyperspacing \u001b[2m3.3s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mBuild a small Python CLI app \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r"]
[72.050561, "o", "\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m              \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m                              \u001b[35m\u001b[2m\u2820\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b[35G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
