[219.100037, "o", "\u001b[29A\u001b[1G\u001b[K2. \u001b[1mEdge Cases Suite (6 tests)\u001b[22m \u2014 TestSlugifyEdgeCases\r\r\n\u001b[5G\u001b[KConsecutive hyphens collapsing\r\r\n\u001b[5G\u001b[KSpecial character replacement\r\r\n\u001b[5G\u001b[KAlphanumeric and hyphen preservation\r\r\n\u001b[6G\u001b[Kon-ASCII character handling\r\r\n\u001b[5G\u001b[KEmpty-after-processing cases\r\r\n\u001b[1G\u001b[K  \u25e6 Whitespace handling (tabs, newlines, carriage returns)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K3. \u001b[1mType/Boundary Suite (2 tests)\u001b[22m \u2014 TestSlugifyTypes\r\r\n\u001b[6G\u001b[Kingle character handling\r\r\n\u001b[5G\u001b[KSpecial character only inputs\r\r\n\u001b[5G\u001b[KHyphen-only inputs\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mKey Behaviors Verified:\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u2713 Lowercases all input\r\r\n\u001b[1G\u001b[K\u2022 \u2713 Replaces spaces & special chars with hyphens\r\r\n\u001b[5G\u001b[KStrips leading/trailing hyphens\r\r\n\u001b[5G\u001b[KCollapses consecutive hyphens into single hyphen\r\r\n\u001b[5G\u001b[KHandles unicode and accented characters gracefully\r\r\n\u001b[5G\u001b[KProcesses real-world slugs like \"How to Train Your Dragon\" \u2192 \"how-to-train-your-dragon\"\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KBoth files\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file utils.py with a\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[3