[228.803991, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[26G\u001b[K\u001b[32m\u28de\u28d3\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[37m\u2844\u2801\u001b[39m   \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m            \u001b[93m\u28c0\u28bf\u28f7\u28e2\u001b[39m \u001b[37m\u2844\u28c5\u2804\u28c2\u001b[39m          \u001b[35m\u28de\u28d3\u001b[2m\u2802\u001b[22m\u001b[39m  \u001b[37m\u2844\u2801\u001b[39m\r\r\n\u001b[24G\u001b[K \u001b[32m\u2814\u28bc\u2823\u2842\u001b[39m  \u001b[37m\u2818\u2824\u001b[39m   \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m            \u001b[93m\u2811\u28be\u2833\u280b\u001b[2m\u2812\u001b[22m\u001b[39m \u001b[37m\u281b\u2838\u2802\u001b[39m         \u001b[35m\u2811\u28fe\u28a3\u2843\u001b[39m  \u001b[37m\u2818\u2824\u001b[39m\r\r\n\u001b[30G\u001b[K      \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                    \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                  \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2mi\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[