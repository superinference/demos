[45.072102, "o", "\u001b[75G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;35mREADME for the clipco\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[7G\u001b[K\u001b[2mHome jumps to the top, End returns to the live tail\u001b[22m\r\r\n\u001b[38G\u001b[K                   \u001b[33m\u2880\u2840\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u28a0\u28ff\u2844\u001b[39m              \u001b[33m\u001b[2m\u2820\u001b[22m\u28f4\u28bb\u2877\u28c4\u001b[39m               \u001b[35m\u282a\u2810\u2805\u2807\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2879\u283b\u288b\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[33m\u2808\u283b\u2837\u280b\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[35m\u282a\u282d\u282d\u2815\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u001b[2m\u2802\u001b[22m\u001b[39m                     \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                       \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[92m\u001b[2m Mentor  Ask anything\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;2