[40.330411, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Random ASCII maze via recursive backtracking, solved with A*.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ import random\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ import heapq\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ WIDTH, HEIGHT = 41, 21  # odd dimensions so walls/cells alternate\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ WALL, PATH = '#', ' '\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ GREEN, RESET = '\\033[92m', '\\033[0m'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     rng = random.Random(seed)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     grid = [[WALL] * w for _ in range(h)]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     def carve(cx, cy):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         grid[cy][cx] = PATH\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+         dirs = [(0, -2), (0, 2), (-2, 0), (2, 0)]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         rng.shuffle(dirs)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+77 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Conjuring \u001b[2m28.8s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[28G\u001b[K        \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[32m\u2844\u001b[39m \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m            \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[28G\u001b[K        \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[32m\u2862\u001b[39m              \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m             \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[30G\u001b[K    \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m      \u001b[36m\u001b[2m\u2820\u001b[32m\u2802\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n"]
