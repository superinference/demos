[140.323741, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[32m\u2884\u28e3\u280a\u001b[39m \u001b[37m\u2810\u2884\u2860\u280a\u001b[39m        \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[36m\u28ff\u28d7\u28e2\u2844\u001b[39m                                 \u001b[35m\u2884\u28e3\u280a\u001b[2m\u2837\u001b[22m\u001b[37m\u2810\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[16G\u001b[K  \u001b[32m\u2814\u2809\u280a\u2862\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m        \u001b[93m\u2819\u28be\u2877\u280b\u001b[36m\u283f\u280f\u2839\u28af\u001b[39m                                \u001b[35m\u2814\u280b\u288a\u2863\u001b[39m \u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[36G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m\u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                                        \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;21