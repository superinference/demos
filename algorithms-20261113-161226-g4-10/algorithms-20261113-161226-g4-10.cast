[32.077389, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import heapq\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ from collections import defaultdict\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ class Graph:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     def __init__(self):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+         self.graph = defaultdict(list)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     def add_edge(self, u, v, weight):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+         \"\"\"Add a directed edge from u to v with given weight.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+         Find shortest path from start to end using Dijkstra's algorithm.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+         Returns (shortest_distance, path).\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+         \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+         # Initialize distances and parent tracking\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         distances = {node: float('inf') for node in self.graph}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+         distances[start] = 0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         parent = {node: None for node in self.graph}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+67 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Crystallizing \u001b[2m2.7s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[54G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m  \u001b[93m\u001b[2m\u2824\u001b[22m\u28e0\u28be\u2877\u28c4\u001b[2m\u2812\u001b[22m\u001b[39m             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[57G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[57G\u001b[K  \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2