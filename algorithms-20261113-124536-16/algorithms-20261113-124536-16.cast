[96.749872, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+ random.seed(42)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ # Token types\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ class TokenType:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     NUMBER = 'NUMBER'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     DICE = 'DICE'\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     RPAREN = 'RPAREN'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     EOF = 'EOF'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ class Token:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     def __init__(self, type, value):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         self.type = type\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         self.value = value\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+195 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run the dice evaluator:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Dice Notation Evaluator) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Crystallizing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u001b[39m                    \u001b[36m\u2890\u2842\u001b[39m         \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                    \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[16G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m                      \u001b[36m\u284d\u28a9\u001b[39m       \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                    \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m                 \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m        \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                       \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B \u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-sonnet-4-5 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2