[144.753275, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ from formatter import format_recipe, format_recipes_side_by_side\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         name=\"Spicy Black Bean Chili\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         servings=4,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         ingredients=[\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+             Ingredient(quantity=2, unit=\"tbsp\", name=\"olive oil\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+             Ingredient(quantity=1, unit=\"cup\", name=\"onion, diced\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+             Ingredient(quantity=4, unit=\"clove\", name=\"garlic, minced\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+             Ingredient(quantity=2, unit=\"tbsp\", name=\"chili powder\"),\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+56 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run the main.py and see the output:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KPerfect! The app is working beautifully. Let me verify all files are in place:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b