[138.678089, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+     \"margarita\": {\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         \"category\": \"Sour / Highball\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         \"base\": \"Tequila\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         \"citrus\": \"Lime\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         \"sweetener\": \"Orange liqueur\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         \"glass\": \"Margarita coupe (salted rim)\",\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+             \"Garnish with a lime wheel.\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+         ],\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     },\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     \"old fashioned\": {\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         \"category\": \"Spirit-forward / Stirred\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         \"base\": \"Whiskey\",\r\r\n"]
[138.678149, "o", "\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         \"citrus\": \"None (orange twist garnish)\",\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+127 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow run the refactored version and diff against the original.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Error: Blocked: unquoted redirect operators det...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Tinkering \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file cocktail_mixer.\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[21G\u001b[K\u001b[32m\u2840\u001b[39m \u001b[37m\u2811\u001b[39m  \u001b[37m\u2808\u001b[39m           \u001b[36m\u2890\u2842\u001b[39m         \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                      \u001b[35m\u2880\u28ba\u28d3\u2840\u001b[39m \u001b[37m\u2811\u001b[39m  \u001b[37m\u2808\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u282a\u2862\u001b[39m                \u001b[36m\u284d\u28a9\u001b[39m         \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                      \u001b[35m\u2819\u285f\u28ba\u284b\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m                     \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m           \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b"]
