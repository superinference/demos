[168.663717, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m#!/usr/bin/env python3\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m\"\"\"Dictionary-driven approach to classify HTTP status codes.\"\"\"\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2mstatus_codes = {\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m    200: \"success\",\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m    201: \"success\",\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m    204: \"success\",\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m    301: \"redirect\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m302: \"redirect\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m400: \"client_error\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m401: \"client_error\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m403: \"client_error\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m404: \"client_error\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m500: \"server_error\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m502: \"server_error\",\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m503\u001b[22m\r\r\n\u001b[20G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m6 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\