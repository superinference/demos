[67.698641, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def render_drink(drink):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     name = drink.lower().strip()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     # Deeply nested decision tree: category -> base spirit -> citrus -> sweetener\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     if name in (\"margarita\", \"daiquiri\", \"mojito\", \"whiskey sour\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+                 \"gimlet\", \"paloma\", \"old fashioned\", \"negroni\"):\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+             category = \"Sour / Highball\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+             # ---- Base spirit branch ----\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+             if name in (\"margarita\", \"paloma\"):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+                 base = \"Tequila\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+                 if name == \"margarita\":\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+                     # citrus present?\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+130 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run it and capture the output.\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(=== MARGARITA ===) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Tinkering \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[29G\u001b[K\u001b[32m\u001b[39m        \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m                         \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m           \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[29G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m       \u001b[36m\u287d\u2839\u280f\u28af\u001b[39m                         \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2802\u001b[22m\u001b[39m          \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[27G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[32m\u001b[2m Mentor  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u