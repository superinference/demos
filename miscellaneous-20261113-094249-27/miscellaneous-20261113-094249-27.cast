[50.556934, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+ \"\"\"Render an ASCII-art Mandelbrot set to the terminal (stdlib only).\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ WIDTH, HEIGHT = 120, 50\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ MAX_ITER = 80\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ # Dark -> light gradient; last char (space) marks points inside the set.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ GRADIENT = \"@%#*+=-:. \"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ def escape_time(c: complex) -> int:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     \"\"\"Return iterations until |z| > 2, or MAX_ITER if it never escapes.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     z = 0j\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     for n in range(MAX_ITER):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         if abs(z) > 2.0:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+             return n\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+23 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-iLeiKY && python3 mandelbrot.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m/\u001b[39m bash cd /tmp/ami-demo-iLeiKY && python3 mandelbrot.py \u001b[2m17.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m      \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m     \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2809\u001b[22m\u001b[39m     \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m     \u001b[36m\u2879\u282d\u283b\u282d\u288b\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u001b[2m\u2824\u001b[22m\u001b[39m                   \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
