[166.460166, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Percolating \u001b[2m2.4s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[17G\u001b[K                    \u001b[36m\u28a0\u28fb\u28d7\u2844\u001b[32m\u28d7\u2844\u001b[39m          \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[33m\u283c\u287f\u28d5\u001b[39m\r\r\n\u001b[18G\u001b[K                  \u001b[36m\u001b[2m\u2804\u001b[22m\u287d\u2839\u280f\u28af\u001b[32m\u282b\u2862\u001b[2m\u2836\u001b[22m\u001b[39m         \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[33m\u28a6\u2827\u2819\u001b[39m \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[20G\u001b[K                    \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u