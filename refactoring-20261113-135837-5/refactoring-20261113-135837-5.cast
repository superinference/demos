[85.196106, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[36G\u001b[K \u001b[36m\u28f0\u001b[35m\u28f0\u28fa\u28d3\u284c\u001b[39m              \u001b[33m\u28e0\u28b4\u287f\u28c6\u001b[32m\u2853\u2801\u001b[39m\r\r\n\u001b[36G\u001b[K\u001b[35m\u001b[2m\u2836\u001b[22m\u001b[36m\u283b\u001b[35m\u2889\u287d\u289f\u288b\u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[33m\u001b[2m\u2804\u001b[22m\u289f\u283e\u2873\u2809\u001b[32m\u2829\u2822\u001b[39m\r\r\n\u001b[37G\u001b[K \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m   \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m              \u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m    \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u00