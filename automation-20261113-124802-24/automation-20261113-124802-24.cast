[65.802142, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+     \"A\": \".-\", \"B\": \"-...\", \"C\": \"-.-.\", \"D\": \"-..\", \"E\": \".\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     \"F\": \"..-.\", \"G\": \"--.\", \"H\": \"....\", \"I\": \"..\", \"J\": \".---\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     \"K\": \"-.-\", \"L\": \".-..\", \"M\": \"--\", \"N\": \"-.\", \"O\": \"---\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     \"P\": \".--.\", \"Q\": \"--.-\", \"R\": \".-.\", \"S\": \"...\", \"T\": \"-\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     \"U\": \"..-\", \"V\": \"...-\", \"W\": \".--\", \"X\": \"-..-\", \"Y\": \"-.--\",\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ def encode(phrase):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     words = phrase.upper().split(\" \")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     return \" / \".join(\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+         \" \".join(MORSE[ch] for ch in word if ch in MORSE)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+         for word in words\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     )\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+5 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KLet me verify it runs, then commit.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\