[294.963609, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m2+ debug: true\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m3+ port: 8080\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m4+ hosts:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m5+   - a.example\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m6+   - b.example\r\r\n\u001b[6G\u001b[K\u001b[2m7  [Auto-formatted]\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(=== Fixed script on a benign config ===) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KDone. Here's the complete picture of what was built, demonstrated, and fixed.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mThe vulnerability (CWE-502: Deserialization of Untrusted Data)\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KThe original process_config.py used the unsafe full loader:\r\r\n\u001b[E\u001b[1G\u001b[Kconfig = yaml.load(f, Loader=yaml.Loader)   # VULNERABLE\r\r\n\u001b[E\u001b[5G\u001b[Kyaml.Loader (and the pre-5.1 default of bare yaml.load()) honors special tags like\r\r\n\u001b[1G\u001b[K!!python/object/apply, which lets a YAML file \u001b[3mconstruct arbitrary Python objects and call functions\u001b[23m\r\r\n\u001b[1G\u001b[Kduring parsing.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## The\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
