[156.770574, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2880\u28ba\u28d3\u28c0\u001b[39m \u001b[37m\u2808\u2809\u2809\u001b[39m     \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m   \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                 \u001b[35m\u2880\u28ba\u28d3\u28c0\u001b[39m \u001b[37m\u2808\u2809\u2809\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2814\u281d\u282b\u2863\u001b[39m         \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m   \u001b[36m\u284d\u28a9\u001b[39m                                   \u001b[35m\u2819\u285f\u28bb\u284b\u001b[39m\r\r\n\u001b[31G\u001b[K\u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[23G\u001b[K\u001b[32m\u001b[2m3\u001b[22m\u001b[39m\r\r\n"]
