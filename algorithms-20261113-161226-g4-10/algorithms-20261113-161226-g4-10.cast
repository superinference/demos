[47.893184, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ class Graph:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     def __init__(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         self.graph = defaultdict(list)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     def add_edge(self, u, v, weight):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         \"\"\"Add a directed edge from u to v with given weight.\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         Find shortest path from start to end using Dijkstra's algorithm.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         Returns (shortest_distance, path).\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         # Initialize distances and parent tracking\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         distances = {node: float('inf') for node in self.graph}\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+         distances[start] = 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         parent = {node: None for node in self.graph}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+67 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Traceback (most recent c