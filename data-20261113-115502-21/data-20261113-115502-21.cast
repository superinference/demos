[54.203941, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ import json\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ DATA = json.loads(\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+   {\"volcano\": \"Tambora\",        \"year\": 1815, \"country\": \"Indonesia\",      \"vei\": 7, \"dea\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+   {\"volcano\": \"Krakatoa\",       \"year\": 1883, \"country\": \"Indonesia\",      \"vei\": 6, \"dea\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+   {\"volcano\": \"Pinatubo\",       \"year\": 1991, \"country\": \"Philippines\",    \"vei\": 6, \"dea\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+   {\"volcano\": \"St. Helens\",     \"year\": 1980, \"country\": \"United States\",  \"vei\": 5, \"dea\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+ ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ \"\"\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ def banner(text):\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+40 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KDone. volcano_report.py is cr