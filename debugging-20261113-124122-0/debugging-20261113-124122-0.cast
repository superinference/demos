[31.813812, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ def sliding_window_max(nums, k):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+     result = []\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+     for i in range(len(nums) - k):  # \u001b[32mBUG:\u001b[39m should be len(nums) - k + 1\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+         window = nums[i:i + k]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+         result.append(max(window))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     return result\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ def run_tests():\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+         ([4, 2, 12, 11, -5], 2, [4, 12, 12, 11]),\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     ]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     all_pass = True\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     for nums, k, expected in cases:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         actual = sliding_window_max(nums, k)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2