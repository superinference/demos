[21.676948, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[21.677634, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K  \u2022 The script uses only Python\u2019s standard-library \u001b[2mstatistics\u001b[22m module and an inline\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u280a\u289b\u28c3\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m         \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                  \u001b[35m\u280a\u289b\u28c3\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u280b\u2843\u001b[39m \u001b[37m\u2808\u2809\u001b[39m           \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                               \u001b[35m\u2819\u285f\u288b\u2843\u001b[39m \u001b[37m\u2808\u2809\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                                       \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[3G\u001b[K\u001b[38;5;248m5.0 tps \u00b7 \u219113k \u2193164 \u00b7 Ctrl+B bg\u001b[39m                \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u