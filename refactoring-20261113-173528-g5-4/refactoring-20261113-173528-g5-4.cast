[28.717611, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"Deeply nested if/elif chains classifying HTTP status codes.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ codes = [200, 201, 204, 301, 302, 400, 401, 403, 404, 500, 502, 503]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ for code in codes:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     if code == 200:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+         category = \"success\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     elif code == 201:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+         category = \"redirect\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     elif code == 302:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+         category = \"redirect\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     elif code == 400:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         category = \"client_error\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     elif code == 401:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         category = \"client_error\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+14 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Cooking \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file messy.py that c\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m       \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m           \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                 \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[16G\u001b[K       \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m        \u001b[36m\u2879\u281d\u282f\u288b\u001b[39m           \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K       \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588