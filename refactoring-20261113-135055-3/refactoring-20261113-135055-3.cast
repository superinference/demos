[54.699688, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ SAMPLE = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     {\"status\": \"pending\", \"value\": 100},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     {\"status\": \"pending\", \"value\": 50},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     {\"status\": \"active\", \"value\": 200},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     {\"status\": \"active\", \"value\": 300},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     {\"status\": \"active\", \"value\": 100},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     {\"status\": \"expired\", \"value\": 75},\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ EXPECTED = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     {\"status\": \"pending\", \"count\": 2, \"total_value\": 150, \"avg_value\": 75.0},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     {\"status\": \"active\", \"count\": 3, \"total_value\": 600, \"avg_value\": 200.0},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     {\"status\": \"expired\", \"count\": 1, \"total_value\": 75, \"avg_value\": 75.0},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     {\"status\": \"cancelled\", \"count\": 2, \"total_value\": 40, \"avg_value\": 20.0},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+9 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-avK5Nd && python -m pytest test_messy.py...\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m/\u001b[39m bash cd /tmp/ami-demo-avK5Nd && python -m pytest test_messy.py... \u001b[2m0.5s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called messy.py\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[33G\u001b[K     \u001b[36m\u2890\u2842\u001b[39m  \u001b[32m\u2808\u288b\u289b\u280b\u001b[39m \u001b[37m\u2819\u280b\u2819\u280b\u001b[39m     \u001b[93m\u28e0\u28be\u2877\u001b[39m                \u001b[35m\u2808\u288b\u289b\u280b\u001b[39m \u001b[37m\u2819\u280b\u2819\u280b\u001b[39m\r\r\n\u001b[33G\u001b[K     \u001b[36m\u284d\u28a9\u001b[39m  \u001b[32m\u2811\u282c\u2826\u284a\u001b[39m \u001b[37m\u2811\u2824\u2824\u280a\u001b[39m     \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m  \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m               \u001b[35m\u2811\u282e\u28a6\u284b\u001b[39m \u001b[37m\u2811\u2824\u2824\u280a\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m            \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.super"]
