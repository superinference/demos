[71.998917, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;167m-\u001b[39m Crystallizing \u001b[2m0.6s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[32m\u2880\u2840\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[32m\u2806\u001b[39m \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m          \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[15G\u001b[K\u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m \u001b[93m\u2819\u28be\u2877\u280b\u001b[32m\u2815\u001b[39m              \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m         \u001b[35m\u001b[2m\u2820\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K                \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                   \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[