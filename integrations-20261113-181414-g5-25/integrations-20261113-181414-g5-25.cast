[220.701057, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2836\u001b[22m\u289e\u28c3\u2802\u001b[39m  \u001b[37m\u2884\u001b[39m \u001b[37m\u280a\u001b[39m          \u001b[36m\u28a6\u28fe\u28d5\u2844\u001b[2m\u2802\u001b[22m\u001b[39m              \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                \u001b[35m\u289e\u28c3\u2802\u001b[39m  \u001b[37m\u2884\u001b[39m \u001b[37m\u280a\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u2819\u280a\u2862\u001b[39m \u001b[37m\u2804\u2801\u2808\u2802\u001b[39m          \u001b[36m\u287d\u2839\u280f\u282f\u001b[39m              \u001b[93m\u001b[2m\u2812\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m               \u001b[35m\u2815\u285b\u288a\u2843\u001b[39m \u001b[37m\u2804\u2801\u2808\u2802\u001b[39m\r\r\n\u001b[41G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m                   \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m             \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2mn\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u