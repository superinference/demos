[98.43143, "o", "\u001b[29A\u001b[1G\u001b[KThe README is complete and already aligns closely with the skill's guidance. Here's how it maps to\r\r\n\u001b[1G\u001b[Kthe critical patterns:\r\r\n\u001b[E\u001b[1G\u001b[K\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\r\n\u001b[1G\u001b[K\u2502 Skill pattern           \u2502 How the README applies it                                              \u2502\r\r\n\u001b[1G\u001b[K\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\r\n\u001b[1G\u001b[K\u2502 \u001b[1mLead with the answer\u001b[22m    \u2502 Title states the outcome (\"check network latency in one command\"); fir \u2502\r\r\n\u001b[3G\u001b[K                        \u2502 st paragraph says what it does and who it helps before any detail.     \u2502\r\r\n\u001b[1G\u001b[K\u2502 \u001b[1mProgressive disclosure\u001b[22m  \u2502 Quick path (install + happy path) \u2192 Common options \u2192 Scripting \u2192 Exit  \u2502\r\r\n\u001b[3G\u001b[K                        \u2502 codes \u2192 edge-case verification.                                        \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mChunking\u001b[22m                \u2502 Short, single-purpose sections; no long flat lists.                    \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mSignposting\u001b[22m             \u2502 Clear ## headings label every zone.                                    \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mRecognition over recall\u001b[22m \u2502 Three tables (options, exit codes) + runnable examples + a verificatio \u2502\r\r\n\u001b[3G\u001b[K                        \u2502 n checklist instead of prose.                                          \u2502\r\r\n\u001b[3G\u001b[K\u001b[1mReview empathy\u001b[22m          \u2502 Checklist and expected-output blocks let a reader confirm correctness  \u2502\r\r\n\u001b[3G\u001b[K                        \u2502 without reconstructing intent.                                         \u2502\r\r\n\u001b[1G\u001b[K\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe structure also matches the skill's default \u001b[1mDocumentation Shape\u001b[22m: outcome title \u2192 one-paragraph\r\r\n\u001b[1G\u001b[Kintro \u2192 Quick path \u2192 Details (as tables) \u2192 Checklist \u2192 Next step.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KOne small jud\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b["]
