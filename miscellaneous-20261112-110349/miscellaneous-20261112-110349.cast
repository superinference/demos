[43.579025, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from citymap import MapSyntaxError, MapValidationError, parse_map, shortest_path\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ SOURCE = \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ place A\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ place B\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ place C\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ \"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ class CityMapTests(unittest.TestCase):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     def test_parser_reads_all_record_types(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         city_map = parse_map(SOURCE)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         self.assertEqual([place.name for place in city_map.places], [\"A\", \"B\", \"C\"])\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+23 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mpython -m unittest discover -v && python main.py\u001b[39m\r\r\n\u001b[1