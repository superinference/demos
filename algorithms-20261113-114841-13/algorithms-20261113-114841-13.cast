[51.733982, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[51.734345, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import heapq\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ def patience_sort(arr):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+     \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     Patience sort algorithm - inspired by the patience card game.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     Phase 1: Build piles - each element goes on the leftmost pile\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+              whose top is >= current element, or starts a new pile.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     Phase 2: Merge piles - use a min-heap to merge the sorted piles.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     # Phase 1: Build piles\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     piles = []\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     print(\"Building piles:\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     print(\"-\" * 70)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     for item in arr:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         # Find the leftmost pile where top >= item (lexicographically)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+82 more lines)\u001b[22m\r\r\n"]
[51.734403, "o", "\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Simmering \u001b[2m6.6s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[29G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m        \u001b[36m\u2869\u288d\u001b[39m                 \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                                  \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
