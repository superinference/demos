[139.483043, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[139.483302, "o", "\u001b[29A\u001b[E\u001b[1G\u001b[K\u001b[1m\u001b[3m1. csvstats.py\u001b[22m - CSV Statistics Tool\u001b[23m\r\r\n\u001b[E\u001b[1G\u001b[KA command-line tool that:\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 Reads any CSV file and auto-detects numeric columns\r\r\n\u001b[1G\u001b[K\u2022 Calculates comprehensive statistics (count, mean, min, max, standard deviation)\r\r\n\u001b[1G\u001b[K\u2022 Displays results in a beautifully formatted table with Unicode box-drawing characters\r\r\n\u001b[1G\u001b[K\u2022 Uses only Python's standard library (csv, statistics, sys, typing)\r\r\n\u001b[1G\u001b[K\u2022 Includes proper error handling for missing files and invalid input\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1m\u001b[3m2. sales_data.csv\u001b[22m - Sample Dataset\u001b[23m\r\r\n\u001b[E\u001b[1G\u001b[KA realistic sales dataset with 20 rows and 5 columns:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mdate\u001b[22m: Transaction dates (non-numeric, ignored by the tool)\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mproduct\u001b[22m: Product names (non-numeric, ignored)\r\r\n\u001b[3G\u001b[K\u001b[1mquantity\u001b[22m: Units sold (1-12 items)\r\r\n\u001b[3G\u001b[K\u001b[1munit_price\u001b[22m: Price per unit ($24.99 - $899.99)\r\r\n\u001b[3G\u001b[K\u001b[1mtotal_amount\u001b[22m: Total transaction value ($124.95 - $2699.97)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K##\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python command-line \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
