[261.304148, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m1  Successfully wrote /tmp/ami-demo-yCN1wP/probe.py (new file, 17 lines)\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ import yaml\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ tests = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     (\"python/tuple\",       \"v: !!python/tuple [1, 2, 3]\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     (\"python/name sys\",    \"v: !!python/name:os.system\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     (\"python/module os\",   \"v: !!python/module:os\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     (\"python/object/new\",  \"v: !!python/object/new:complex [3, 4]\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ for label, doc in tests:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     for loader in (\"FullLoader\", \"safe\"):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+         try:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+             if loader == \"FullLoader\":\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+                 d = yaml.load(doc, Loader=yaml.FullLoader)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+             else:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+                 d = yaml.safe_load(doc)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+             print(f\"{label:20} {loader:10} -> OK      {d!r}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         except Exception as e:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+             print(f\"{label:20} {loader:10} -> BLOCKED ({type(e).__name__})\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(python/tuple FullLoader -> OK {'v': (1, 2, 3)}) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Tinkering \u001b[2m34.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K        \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m    \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m                       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m        \u001b[36m\u2879\u282d\u283b\u282d\u288b\u001b[39m    \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m                      \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[40G\u001b[K\u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m    \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
