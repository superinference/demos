[69.850453, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ CATEGORIES = {\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     4: \"four\", 5: \"five\", 6: \"six\", 7: \"seven\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     8: \"eight\", 9: \"nine\", 10: \"ten\", 11: \"eleven\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     12: \"twelve\", 13: \"thirteen\", 14: \"fourteen\", 15: \"fifteen\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ def classify(code):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+     return CATEGORIES[code]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ if __name__ == \"__main__\":\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     for i in range(16):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         print(classify(i))\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run both and diff them:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Error: Blocked: unquoted redirect operators det...) 0.0s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(=== messy.py output ===) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Hyperspacing \u001b[2m18.3s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[12G\u001b[K        \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u28a0\u28ff\u2844\u001b[39m                             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[12G\u001b[K        \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m         \u001b[36m\u2879\u283b\u288b\u001b[39m  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                          \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[12G\u001b[K              \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                             \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n"]
