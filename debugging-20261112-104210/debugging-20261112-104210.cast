[23.254235, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ from pathlib import Path\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ BASE_DIR = Path(\"examples\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ def vulnerable_read(filename: str) -> str:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     \"\"\"Original vulnerable implementation: user input controls the path.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     return (BASE_DIR / filename).read_text(encoding=\"utf-8\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     base = BASE_DIR.resolve()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     candidate = (base / filename).resolve()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     try:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         candidate.relative_to(base)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     except ValueError as exc:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         raise ValueError(\"rejected path traversal\") from exc\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+19 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u