[49.936914, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ Leading letters E, T, A cannot be zero.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ from itertools import permutations\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     # Extract unique letters: E, A, T, H, P, L\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     letters = ['E', 'A', 'T', 'H', 'P', 'L']\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     # Try all permutations of 6 unique digits from 0-9\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     for perm in permutations(range(10), 6):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+         # Create a mapping\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         mapping = dict(zip(letters, perm))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+65 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Found 1 solution(s):) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Crystallizing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[93m\u001b[39m\u0