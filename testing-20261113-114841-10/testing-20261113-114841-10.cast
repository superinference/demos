[37.631009, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Morse code encoder and decoder.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ MORSE_CODE = {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+     'A': '.-',    'B': '-...',  'C': '-.-.',  'D': '-..',   'E': '.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     'F': '..-.',  'G': '--.',   'H': '....',  'I': '..',    'J': '.---',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     'K': '-.-',   'L': '.-..',  'M': '--',    'N': '-.',    'O': '---',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     'P': '.--.',  'Q': '--.-',  'R': '.-.',   'S': '...',   'T': '-',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     'U': '..-',   'V': '...-',  'W': '.--',   'X': '-..-',  'Y': '-.--',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     'Z': '--..',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ # Reverse mapping for decoding\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ MORSE_TO_CHAR = {morse: char for char, morse in MORSE_CODE.items()}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ def encode(text):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     Encode plain text to Morse code.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+45 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Crystallizing \u001b[2m5.7s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a morse_codec.py modul\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K     \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m             \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m  \u001b[35m\u001b[2m\u2804\u001b[22m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m             \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K                      \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m        \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;