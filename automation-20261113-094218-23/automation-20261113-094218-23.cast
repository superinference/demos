[98.92372, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[32m\u289e\u28d3\u2840\u001b[39m \u001b[37m\u2811\u2884\u2820\u280a\u001b[39m          \u001b[36m\u282d\u28ba\u28c7\u28b8\u001b[39m               \u001b[93m\u2872\u28aa\u2827\u2844\u001b[39m                \u001b[35m\u289e\u28d3\u2840\u001b[39m \u001b[37m\u2811\u2884\u2820\u280a\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u2883\u2839\u28a0\u2888\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[93m\u2899\u28be\u2857\u282b\u001b[39m              \u001b[35m\u001b[2m\u283e\u001b[22m\u2819\u285f\u28aa\u2843\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m                                    \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                   \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u001b[2mO\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u00