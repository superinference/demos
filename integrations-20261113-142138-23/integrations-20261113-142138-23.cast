[106.875973, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[106.876036, "o", "\u001b[29A\u001b[1G\u001b[K\u2022 \u001b[1mRecognition over recall\u001b[22m: Tables for commands, behaviors, and exit codes instead of prose\r\r\n\u001b[1G\u001b[Kparagraphs.\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mChunking\u001b[22m: Each section has one focus (usage, details, examples, installation, verification).\r\r\n\u001b[3G\u001b[K\u001b[1mSignposting\u001b[22m: Clear headings guide readers. The \"Details\" section explicitly calls out edge cases\r\r\n\u001b[1G\u001b[Klike empty files and stdin.\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mExamples before install\u001b[22m: Show what works before asking users to install, so they understand the\r\r\n\u001b[1G\u001b[Kvalue.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe README is now saved at /tmp/ami-demo-K5y26U/README.md and ready to use!\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- **Cognitive load is the metric**: Tables, headings, and examples make docs scannable; dense prose\r\r\n\u001b[1G\u001b[Kforces readers to reconstruct intent from memory.\r\r\n\u001b[1G\u001b[K- **Lead-with-the-answer** inverts traditional writing: the outcome goes first, context follows, so\r\r\n\u001b[1G\u001b[Kreaders decide immediately if this is relevant.\r\r\n\u001b[1G\u001b[K- **Recognition over recall** (tables vs. prose) lets users verify what they're looking for without\r\r\n\u001b[1G\u001b[Kmemorizing explanations.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;75m  \u25c6 Suggested file: tinycount.md (141 lines)\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Worked for 1m 35s \u00b7 done 3:24 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mtinycount CLI Tool README Gen\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: click a \u25b6 row, or press Ctrl+T, to expand every component\u001b[22m\r\r\n\u001b[18G\u001b[K                    \u001b[36m\u2880\u2860\u2840\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28f0\u28fd\u285f\u28d7\u001b[39m                                 \u001b[93m\u28f0\u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u281e\u2818\u2803\u2808\u001b[39m                                 \u001b[93m\u2819\u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2808\u001b[22m\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[2m\u2808\u001b[22m\u001b[39m                                                    \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m  \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 Ctrl+D \u2026\u001b[22m\u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[cognitive-doc-design] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww"]
