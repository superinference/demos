[130.851, "o", "\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[130.929747, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u001b[1mHow it works:\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KThe implementation uses a \u001b[1mmin-heap priority queue\u001b[22m to always process the nearest unvisited node next.\r\r\n\u001b[1G\u001b[KThe algorithm:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K1. \u001b[1mInitializes\u001b[22m all distances to infinity, except the start node (distance 0)\r\r\n\u001b[1G\u001b[K2. \u001b[1mExplores\u001b[22m nodes in order of increasing distance from the start\r\r\n\u001b[1G\u001b[K3. \u001b[1mRelaxes edges\u001b[22m \u2014 when visiting a node, it checks all neighbors and updates their distances if a\r\r\n\u001b[1G\u001b[Kshorter path is found\r\r\n\u001b[1G\u001b[K4. \u001b[1mTracks parents\u001b[22m to reconstruct the actual path at the end\r\r\n\u001b[1G\u001b[K5. \u001b[1mStops early\u001b[22m once the destination is reached\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mThe shortest path A \u2192 C \u2192 B \u2192 E = 4:\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 A \u2192 C costs 2\r\r\n\u001b[1G\u001b[K\u2022 C \u2192 B costs 1\r\r\n\u001b[3G\u001b[KB \u2192 E costs 1\r\r\n\u001b[3G\u001b[K\u001b[1mTotal: 2 + 1 + 1 = 4\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KOther possible routes (like A \u2192 B \u2192 E = 5, or A \u2192 C \u2192 D \u2192 E = 9) are longer.\r\r\n\u001b[E\u001b[1G\u001b[K\u2605 Insight\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
