[20.448478, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[20.450315, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ \"\"\"Simulate and explain the classic 100 doors puzzle.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def solve(number_of_doors=100):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     doors = [False] * number_of_doors  # False means closed; True means open.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     for pass_number in range(1, number_of_doors + 1):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         for door_number in range(pass_number, number_of_doors + 1, pass_number):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+             doors[door_number - 1] = not doors[door_number - 1]\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def main():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     open_doors = solve()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     perfect_squares = [number * number for number in range(1, 11)]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     print(\"100 Doors Result\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     print(f\"Doors remaining open: {open_doors}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     print(\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+9 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G