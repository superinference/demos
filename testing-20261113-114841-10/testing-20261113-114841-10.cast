[130.554335, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     \"\"\"Test encoding plain text to Morse code.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+         assert morse_codec.encode('S') == '...'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+         assert morse_codec.encode('T') == '-'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     def test_encode_word(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         \"\"\"Word should encode with spaces between character codes.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         assert morse_codec.encode('SOS') == '... --- ...'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+121 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run the tests with pytest:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(============================= test session star...) 0.3s\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KPerfect! Let me also create a quick demonstration showing the module in action:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Error: Quoted newline followed by #-prefixed li...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Crystallizing \u001b[2m1.8s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a morse_codec.py modul\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u2869\u2829\u28d7\u2816\u001b[39m               \u001b[93m\u28e0\u28fc\u287f\u2846\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u2859\u282d\u2893\u288e\u001b[2m\u2802\u001b[22m\u001b[39m              \u001b[93m\u2871\u287e\u289d\u280d\u001b[39m              \u001b[35m\u001b[2m\u2836\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m               \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                       \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m1% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m