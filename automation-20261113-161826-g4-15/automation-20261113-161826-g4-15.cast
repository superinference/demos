[36.869926, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;35m/\u001b[39m Writing csvstats.py \u00b7 2.6k chars \u001b[2m0.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[35G\u001b[K\u001b[32m\u2808\u288b\u289b\u001b[36m\u2890\u2842\u001b[37m\u2819\u280b\u2819\u280b\u001b[39m          \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[33m\u28e0\u28b4\u287f\u28c6\u001b[39m               \u001b[35m\u2808\u288b\u289b\u2803\u001b[2m\u2809\u001b[22m\u001b[37m\u2819\u280b\u2819\u280b\u001b[39m\r\r\n\u001b[35G\u001b[K\u001b[32m\u2811\u282c\u2826\u001b[36m\u284d\u28a9\u001b[37m\u2811\u2824\u2824\u280a\u001b[39m            \u001b[33m\u28bb\u287e\u2817\u2809\u001b[39m              \u001b[35m\u001b[2m\u2812\u001b[22m\u2811\u286e\u28a6\u284b\u001b[39m \u001b[37m\u2811\u2824\u2824\u280a\u001b[39m\r\r\n\u001b[39G\u001b[K\u001b[32m\u001b[2m\u2809\u001b[22m\u001b[39m                 \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u0