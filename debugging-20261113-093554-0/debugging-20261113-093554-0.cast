[35.416262, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[35.416814, "o", "\u001b[29A\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mfrom bug import find_peak\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mdef run():\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mcases = [\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    ([1, 3, 2], 1, \"simple peak in middle\"),\r\r\n\u001b[18G\u001b[K\u001b[2m\u001b[22m([3, 2, 1], 0, \"first element is peak\"),\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    ([1, 2, 3], 2, \"last element is peak\"),\r\r\n\u001b[18G\u001b[K\u001b[2m\u001b[22m([1], 0, \"single element\"),\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     results = []\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     for nums, expected, desc in cases:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         got = find_peak(nums)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         ok = got == expected\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         results.append((ok, desc, nums, expected, got))\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m20+     return results\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Tinkering \u001b[2m4.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[8G\u001b[K                              \u001b[36m\u2890\u2842\u001b[32m\u28fa\u28d7\u2844\u001b[39m              \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[8G\u001b[K                              \u001b[36m\u2869\u288d\u001b[32m\u281d\u282b\u2862\u001b[39m              \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[12G\u001b[K                           \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m   \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                                   \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n"]
