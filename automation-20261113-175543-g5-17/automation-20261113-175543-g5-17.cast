\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[93m\u28e0\u28be\u2877\u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[55G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m \u001b[93m\u2819\u28be\u2877\u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n"]
