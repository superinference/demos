[81.211557, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[38;5;208m\u25bc \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan file_edit(signal_garden.py) +3 -2 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K  \u001b[38;5;35m\u2713\u001b[39m \u001b[1m\u001b[38;5;167mfile_edit\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243msignal_garden.py\u001b[39m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;35m(+3 -2)\u001b[39m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;35m213 tok\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u23bf  diff \u00b7 \u001b[1m\u001b[38;5;75msignal_garden.py\u001b[39m\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502    0  [edit: signal_garden.py, 7 lines changed]\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m1  Successfully edited /tmp/ami-demo-35iKs6/signal_garden.py\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m104          window = values[end - drift_window * 2:end]\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m5          first, last = window[:drift_window], window[drift_window:]\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m6          slope = (statistics.median(last) - statistics.median(first)) / drift_window\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m107-         local_mad = median_absolute_deviation(window)\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m8-         scale = max(local_mad, mad, 1e-9)\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m7+         # A trend inflates the window MAD, so use the known sensor noise floor\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m8+         # rather than letting the suspected drift hide its own signal.\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m9+         scale = max(sensor.noise, 1e-9)\r\r\n\u001b[6G\u001b[K\u001b[2m110          score = slope * drift_window / scale\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m1          if abs(score) >= drift_threshold:\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m2              direction = \"rising\" if score > 0 else \"falling\"\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(test_all_fixture_sensors_have_signal (test_sign...) 0.1s\u001b[22m\r\r\n\u001b[15G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u001b[39m\u001b[2mSIGNAL GARDEN OBSERVATORY) 0.1s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[2m\u2234 Thinking #7\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m2.4s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
