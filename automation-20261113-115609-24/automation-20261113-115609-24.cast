[117.958776, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[117.959678, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+ - 500g bread flour\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ - 350g water (70% hydration)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ - 10g salt\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+ - 100g active sourdough starter\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+ ## Steps\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ 1. Mix the flour, water, salt, and starter until no dry flour remains, then let rest.\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ 2. Bulk ferment at room temperature for 4 hours, folding the dough every 30-45 minutes.\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+ 3. Shape the dough, proof, then bake in a preheated Dutch oven at 230\u00b0C until deeply brow\r\r\n\u001b[6G\u001b[K\u001b[2m17  [Auto-formatted]\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Exit code: 0) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan git_commit([master (root-commit) d844969] first draft: bas...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow the revision. Computing the changes: 78% hydration of 500g flour = 390g water; 10% of bread\r\r\n\u001b[1G\u001b[Kflour (50g) swapped to whole wheat \u2192 450g bread flour + 50g whole wheat.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m[Checkpoint cp-1794571163713-2: /tmp/ami-demo-ByQbNx/sourdough.md]\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mfile_edit\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243m/tmp/ami-demo-ByQbNx/sourdough.md\u001b[39m\r\r\n\u001b[3G\u001b[K\u001b[38;5;167m\u001b[39mfile_edit /tmp/ami-demo-ByQbNx/sourdough.md \u001b[2m0.6s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mInitialize a git repo here, t\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[6G\u001b[K                   \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2824\u001b[22m\u001b[39m      \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m             \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[6G\u001b[K                   \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m             \u001b[93m\u2819\u001b[39m                  \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[5G\u001b[K                                  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                   \u001b[35m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u0