[163.779958, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1- #!/usr/bin/env python3\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2- import base64\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4- # Define the three scripts with base64 placeholders\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5- bash_template = b'''#!/bin/bash\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6- # Step 3/3: Bash quine - outputs Python\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7- s='!!PYTHON_B64!!'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8- echo \"$s\" | base64 -d\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9- '''\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10-\r\r\n\u001b[14G\u001b[K\u001b[2m24 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ ruby_script = b'''#!/usr/bin/env ruby\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ # Step 2/3: Ruby quine - outputs Bash\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ s=\"!!ENCODED_BASH!!\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ puts s.unpack(\"m\")[0]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ '''\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ # Step 3: Create the Python script\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  22  ... (+61 more added)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Simmering \u001b[2m4.2s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u0