[196.561065, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K                                                                        \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[25G\u001b[K \u001b[32m\u288c\u285b\u28d1\u286e\u001b[39m       \u001b[36m\u28b0\u28f8\u28d7\u2844\u001b[39m               \u001b[33m\u28e0\u283e\u2877\u28c4\u001b[39m \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m        \u001b[35m\u28a8\u28fa\u28ff\u2844\u001b[39m\r\r\n\u001b[25G\u001b[K \u001b[32m\u2810\u281f\u282f\u2886\u001b[39m \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m     \u001b[36m\u2879\u285d\u282f\u288b\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m           \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[33m\u2839\u287a\u2897\u280f\u001b[39m          \u001b[35m\u289f\u285f\u28bb\u286b\u001b[39m\r\r\n\u001b[25G\u001b[K                                  \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m         \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m    \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;21