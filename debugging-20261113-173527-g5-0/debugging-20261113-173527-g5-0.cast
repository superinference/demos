[55.845989, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+     assert binary_search([1, 2, 3, 4, 5], 1) == 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ def test_find_middle():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     assert binary_search([1, 2, 3, 4, 5], 3) == 2\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     assert binary_search([1, 2, 3, 4, 5], 5) == 4\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ def test_single_element_found():\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+     assert binary_search([42], 42) == 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+10 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run the tests to show the failure:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-dOvSdg && python -m pytest test_bug.py -...\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-dOvSdg && python -m pytest test_bug.py -... \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u