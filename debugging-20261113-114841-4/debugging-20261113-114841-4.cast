[165.86573, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 Method: yaml.load() with yaml.Loader\r\r\n\u001b[1G\u001b[K\u2022 Status: \ud83d\udea8 \u001b[1mVULNERABLE\u001b[22m to code execution\r\r\n\u001b[1G\u001b[K\u2022 Exploit: Successfully executed os.system() and created PWNED.txt\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mAFTER (Patched):\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 Method: yaml.safe_load()\r\r\n\u001b[1G\u001b[K\u2022 Status: \u2705 \u001b[1mSECURE\u001b[22m - exploit blocked\r\r\n\u001b[1G\u001b[K\u2022 Result: Raised ConstructorError, no file created\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mThe Vulnerability:\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe !!python/object/apply YAML tag allows arbitrary Python object instantiation and function calls.\r\r\n\u001b[1G\u001b[KWhen combined with yaml.load(), an attacker can execute system commands, read files, or establish\r\r\n\u001b[1G\u001b[Kreverse shells.\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mThe Fix:\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[Kyaml.safe_load() only deserializes basic Python types (strings, lists, dicts, numbers) and rejects\r\r\n\u001b[1G\u001b[Kdangerous tags like !!python/object/apply, preventing code execution.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
