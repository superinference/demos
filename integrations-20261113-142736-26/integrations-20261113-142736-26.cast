[144.472427, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K        \u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[5G\u001b[K \u001b[32m\u28a0\u28fa\u28d6\u284c\u001b[39m                          \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                      \u001b[93m\u001b[2m\u2824\u001b[22m\u28f0\u28b5\u286e\u28c6\u001b[39m \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m                  \u001b[35m\u28ee\u28e6\u28f5\u285d\u001b[39m\r\r\n\u001b[4G\u001b[K \u001b[32m\u001b[2m\u2837\u001b[22m\u2890\u2899\u281b\u2872\u001b[39m                          \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m                       \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                    \u001b[35m\u2881\u2859\u28bc\u2840\u001b[39m\r\r\n\u001b[9G\u001b[K \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m                         \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                                        \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2