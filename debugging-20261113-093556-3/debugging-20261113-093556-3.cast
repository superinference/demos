[142.599473, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1- import os\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3- DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6- def serve_file(filename):\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m 7-     # VULNERABLE: naive join, no validation of '../' sequences\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8-     path = os.path.join(DATA_DIR, filename)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9-     with open(path, \"r\") as f:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m10-         return f.read()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 19 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     requested = os.path.realpath(os.path.join(DATA_DIR, filename))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     # Confinement check: the resolved path must live inside DATA_DIR.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     if os.path.commonpath([DATA_DIR, requested]) != DATA_DIR:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+         raise PathTraversalError(f\"Access outside data directory denied: {filename!r}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     with open(requested, \"r\") as f:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+7 more added)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-16\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m1.2s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called serve_fi\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[9G\u001b[K \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m    \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[9G\u001b[K\u001b[93m\u001b[2m\u2809\u001b[22m\u2839\u287a\u2897\u280f\u001b[39m    \u001b[92m\u2894\u281d\u282b\u2862\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u2879\u282d\u283b\u282d\u288b\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[11G\u001b[K \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m     \u001b[92m\u001b[2m\u2802\u001b[22m\u001b[39m                   \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n"]
