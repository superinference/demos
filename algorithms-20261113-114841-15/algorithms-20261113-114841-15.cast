[36.248896, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ from pattern_match import is_match\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ filenames = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     \"snapshot_2024.tar.gz\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     \"report_final.pdf\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     \"data_v3.csv\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+     \"notes.txt\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+     \"archive.tar.gz\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ ]\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     \"data_v*.csv\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     \"*.*\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     \"???es.txt\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m20+ def main() -> None:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+25 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n"]
[36.248974, "o", "\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Simmering \u001b[2m4.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[8G\u001b[K                              \u001b[36m\u2890\u2842\u001b[32m\u28fa\u28d7\u2844\u001b[39m              \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[8G\u001b[K                              \u001b[36m\u2869\u288d\u001b[32m\u281d\u282b\u2862\u001b[39m              \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[12G\u001b[K                           \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m   \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                                   \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u0