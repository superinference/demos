[118.13426, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     'K': '-.-',   'L': '.-..',  'M': '--',    'N': '-.',    'O': '---',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     'P': '.--.',  'Q': '--.-',  'R': '.-.',   'S': '...',   'T': '-',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     'U': '..-',   'V': '...-',  'W': '.--',   'X': '-..-',  'Y': '-.--',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     'Z': '--..',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     '0': '-----', '1': '.----', '2': '..---', '3': '...--', '4': '....-',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     '5': '.....', '6': '-....', '7': '--...', '8': '---..', '9': '----.',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     '.': '.-.-.-', ',': '--..--', '?': '..--..', \"'\": '.----.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+140 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's make it executable and run it with the --demo flag:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[15G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u001b[39m\u001b[2m[Command completed successfully (no output expe...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KPerfect! Let me also demonstrate the encode and decode modes individually:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(.... . .-.. .-.. --- / .-- --- .-. .-.. -..) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Coalescing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m  \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                    \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m  \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m                    \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[27G\u001b[K\u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m  \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                       \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[92m\u001b[2m Mentor  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[