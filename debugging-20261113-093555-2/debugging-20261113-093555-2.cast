[76.028603, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ from bug import categorize_score\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ test_cases = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     (95, 'high'),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     (60, 'medium'),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     (30, 'low'),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     (100, 'high'),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m0+ print(\"Testing categorize_score():\\n\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ for score, expected in test_cases:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     result = categorize_score(score)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     status = \"\u2713\" if result == expected else \"\u2717\"\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m14+     print(f\"{status} score={score:3d} | expected={expected:6s} | got={result:6s}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow run the test to show the bug:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(bash: line 1: python: command not found) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Testing categorize_score():) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Tinkering \u001b[2m15.6s\u001b[22m\r\r\n\u00