[33.448405, "o", "\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: type / to open the slash-command palette\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[20G\u001b[K\u001b[92m\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m      \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m                         \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m      \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m                        \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[92m\u001b[2m\u2810\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m        \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 /help \u00b7 \u2193 menu \u00b7 Ctrl+D exit\u001b[22m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;