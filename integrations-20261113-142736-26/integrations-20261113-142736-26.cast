[207.032586, "o", "\u001b]2;\u280b AMI \u00b7 HTML Button with Accessibility Improvements\u0007"]
[207.069208, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[207.069296, "o", "\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe button includes:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mVisual polish\u001b[22m: Blue gradient (from #2563eb to #1d4ed8), layered shadows for depth, 12px border\r\r\n\u001b[1G\u001b[Kradius\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mAccessibility\u001b[22m: Semantic <button type=\"button\">, :focus-visible ring (no outline on click, 4px blue\r\r\n\u001b[1G\u001b[K ring on keyboard nav), WCAG AA color contrast (white on blue)\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mInteraction states\u001b[22m: Hover (darker, elevated shadow, -1px lift), active (pressed appearance),\r\r\n\u001b[1G\u001b[Kdisabled (50% opacity)\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mInclusive design\u001b[22m: prefers-reduced-motion removes transitions, prefers-contrast: high adds border,\r\r\n\u001b[1G\u001b[Ksystem font stack\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- `:focus-visible` is the modern standard for accessible focus states\u2014it shows the ring only on\r\r\n\u001b[1G\u001b[Kkeyboard navigation, not mouse clicks, eliminating the common tension between visual polish and\r\r\n\u001b[1G\u001b[Kaccessibility\r\r\n\u001b[1G\u001b[K- Layered box-shadows (structural + colored glow) create depth that feels tactile rather than flat,\r\r\n\u001b[1G\u001b[Kand the glow uses the button's own hue to reinforce its identity without adding visual noise\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Brewed for 3m 16s \u00b7 done 3:31 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mHTML Button with Accessibilit\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: Home jumps to the top, End returns to the live tail\u001b[22m\r\r\n\u001b[19G\u001b[K                   \u001b[36m\u2880\u2860\u2840\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[32m\u2844\u001b[39m               \u001b[36m\u28f0\u28fd\u285f\u28d7\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[32m\u2862\u001b[39m               \u001b[36m\u281e\u2818\u2803\u2808\u001b[39m                                 \u001b[35m\u001b[2m\u2808\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m  \u001b[32m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 Ctrl+D\u2026\u001b[22m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[impeccable] \u001b[39manthropic-vertex/claude-sonnet-4-5 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;2"]
