[17.26481, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ import json\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ data = json.loads('{\"period\":\"Q3 2026\",\"region\":\"North\",\"orders\":1284,\"revenue\":186420.5,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ report = f\"\"\"Sales Report\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ ============\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ Period:      {data['period']}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ Region:      {data['region']}\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ ------------\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ \"\"\" + \"\\n\".join(\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     f\"{product['name']}: {product['units']:,} units\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     for product in data['top_products']\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ ) + f\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ Return Rate: {data['return_rate']:.1%}\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+3 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Sales Report) 0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;136m\u001b[39mSimmering \u001b[2m1.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m          \u001b[93m\u28d4\u28f7\u28fe\u28e2\u001b[39m \u001b[37m\u28d4\u28f7\u28fe\u28e2\u001b[39m            \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m          \u001b[93m\u2811\u281f\u283b\u280a\u001b[39m \u001b[37m\u2811\u281f\u283b\u280a\u001b[39m            \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
