[47.315567, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[47.315863, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ Morse Code Encoder/Decoder CLI Tool\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ Supports letters, digits, and common punctuation.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ import argparse\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ import sys\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     'K': '-.-',   'L': '.-..',  'M': '--',    'N': '-.',    'O': '---',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     'P': '.--.',  'Q': '--.-',  'R': '.-.',   'S': '...',   'T': '-',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     'U': '..-',   'V': '...-',  'W': '.--',   'X': '-..-',  'Y': '-.--',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     'Z': '--..',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     '0': '-----', '1': '.----', '2': '..---', '3': '...--', '4': '....-',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     '5': '.....', '6': '-....', '7': '--...', '8': '---..', '9': '----.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     '.': '.-.-.-', ',': '--..--', '?': '..--..', \"'\": '.----.',\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+140 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Coalescing \u001b[2m15.6s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[36G\u001b[K\u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2820\u001b[22m\u001b[39m          \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[36G\u001b[K\u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m           \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m             \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[37G\u001b[K   \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m    \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                  \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[32m\u001b[2m Mentor  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580"]
