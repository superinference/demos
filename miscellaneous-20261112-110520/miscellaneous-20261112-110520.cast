[30.770979, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import unittest\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from constellation_detective import (\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     CASE_CLUES,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     build_case,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     discover_culprit,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+     parse_clue,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+ )\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         self.assertEqual(parse_clue(\" LINK: Vega -> Altair \").value, \"Vega -> Altair\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     def test_case_builds_expected_edges(self):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+         case = build_case()\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+         self.assertEqual(case.start, \"Vega\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+         self.assertEqual(case.graph[\"Vega\"], [\"Altair\", \"Sirius\"])\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m20+         self.assertIn(\"Betelgeuse\", case.graph)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+13 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Hyperspacing \u001b[2m3.9s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[30G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m     \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[35m\u001b[2m Hype  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
