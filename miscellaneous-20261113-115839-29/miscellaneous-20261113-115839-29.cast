[49.846663, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ # Full Morse code dictionary (A-Z and 0-9)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ MORSE_DICT = {\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     'A': '.-',    'B': '-...',  'C': '-.-.',  'D': '-..',   'E': '.',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     'F': '..-.',  'G': '--.',   'H': '....',  'I': '..',    'J': '.---',\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     'K': '-.-',   'L': '.-..',  'M': '--',    'N': '-.',    'O': '---',\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     'P': '.--.',  'Q': '--.-',  'R': '.-.',   'S': '...',   'T': '-',\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ # Reverse mapping for decoding\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ REVERSE_MORSE = {v: k for k, v in MORSE_DICT.items()}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ def encode_word_to_morse(word: str) -> str:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+60 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(===============================================...) 0.1s\u001b[2