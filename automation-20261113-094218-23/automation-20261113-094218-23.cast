[100.371294, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2810\u2884\u2860\u280a\u001b[39m \u001b[37m\u2810\u2884\u2860\u280a\u001b[39m         \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m              \u001b[93m\u28c2\u28fc\u28f5\u28d7\u001b[39m               \u001b[35m\u2810\u2884\u2860\u280a\u001b[39m \u001b[37m\u2810\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u283e\u001b[22m\u001b[37m\u2814\u2801\u2808\u2822\u001b[39m         \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m              \u001b[93m\u2815\u2892\u2827\u2801\u001b[2m\u2812\u001b[22m\u001b[39m              \u001b[35m\u2814\u2801\u2808\u2822\u001b[2m\u2836\u001b[22m\u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m                                                       \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[35m\u001b[2mh\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[