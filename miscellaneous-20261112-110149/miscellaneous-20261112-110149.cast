[78.575374, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m[Checkpoint cp-1794481394306-4: /tmp/ami-demo-35iKs6/signal_garden.py]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25bc \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan file_edit(signal_garden.py) +3 -2 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K  \u001b[38;5;35m\u2713\u001b[39m \u001b[1m\u001b[38;5;167mfile_edit\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243msignal_garden.py\u001b[39m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;35m(+3 -2)\u001b[39m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;35m213 tok\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u23bf  diff \u00b7 \u001b[1m\u001b[38;5;75msignal_garden.py\u001b[39m\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502    0  [edit: signal_garden.py, 7 lines changed]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502    1  Successfully edited /tmp/ami-demo-35iKs6/signal_garden.py\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m104          window = values[end - drift_window * 2:end]\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m105          first, last = window[:drift_window], window[drift_window:]\u001b[22m\r\r\n\u001b[8G\u001b[K\u001b[2m6          slope = (statistics.median(last) - statistics.median(first)) / drift_window\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m107-         local_mad = median_absolute_deviation(window)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m108-         scale = max(local_mad, mad, 1e-9)\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m+         # A trend inflates the window MAD, so use the known sensor noise floor\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m+         # rather than letting the suspected drift hide its own signal.\r\r\n\u001b[8G\u001b[K\u001b[2m\u001b[22m9+         scale = max(sensor.noise, 1e-9)\r\r\n\u001b[6G\u001b[K\u001b[2m110          score = slope * drift_window / scale\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m111          if abs(score) >= drift_threshold:\u001b[22m\r\r\n\u001b[8