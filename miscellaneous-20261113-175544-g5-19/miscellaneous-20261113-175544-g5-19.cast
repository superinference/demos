[230.217085, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[32m\u288c\u2883\u2802\u001b[39m \u001b[37m\u2810\u2804\u2820\u280a\u001b[39m         \u001b[36m\u001b[2m\u2802\u001b[22m\u2840\u286d\u28cb\u2838\u001b[39m               \u001b[93m\u28c2\u2857\u2835\u28c6\u001b[2m\u2824\u001b[22m\u001b[39m               \u001b[35m\u288c\u2883\u2802\u001b[39m \u001b[37m\u2810\u2804\u2820\u280a\u001b[39m\r\r\n\u001b[26G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[37m\u2802\u001b[39m          \u001b[36m\u2851\u2801\u28ef\u2889\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[93m\u280b\u2873\u28ad\u2856\u001b[39m               \u001b[35m\u2814\u284b\u288b\u2863\u001b[39m \u001b[37m\u2814\u2809\u2808\u2802\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m                    \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[14G\u001b[K\u001b[35m\u001b[2me\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001