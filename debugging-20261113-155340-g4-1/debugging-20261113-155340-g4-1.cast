1b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m10+ # Compute mean and median\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m11+ mean = statistics.mean(numbers)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m12+ median = statistics.median(numbers)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m13+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ print(f\"Mean: {mean}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ print(f\"Median: {median}\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Noodling \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called stats.py\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[40G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m          \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                   \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n"]
