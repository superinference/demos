[130.99906, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[2mdef process_records(records):              |  def _summarize_by_status(records, status):\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m    results = []                           |      matched = [r for r in records if r[\"status\"] == \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2mstatus]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m                                           |      count = len(matched)\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m# pending block                        |      total_value = sum(r[\"value\"] for r in matched)\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2mpending = [... \"pending\"]              <      avg_value = total_value / count if count else 0\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2mcount = len(pending)                   <      return {\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2mtotal_value = sum(...)                 <          \"status\": status,\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2mavg_value = ...                           ==      \"count\": count,\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2mresults.append({...})                  |          \"total_value\": total_value,\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m                                       |          \"avg_value\": avg_value,\u001b[22m\r\r\n\u001b[5G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[21G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called messy.py\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
