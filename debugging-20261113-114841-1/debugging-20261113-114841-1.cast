[67.963649, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ # Embedded YAML recipe\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ RECIPE_YAML = \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ name: Classic Pancakes\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ servings: 4\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ ingredients:\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+   - amount: \"2\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     name: \"eggs\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+   - amount: \"1 1/4 cups\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     name: \"milk\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+   - amount: \"1/3 cup\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     name: \"melted butter\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+   - amount: \"2 tbsp\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+80 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it with multiplier 2.5 to trigger the bug:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Original recipe:) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Tinkering \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[36m\u28a0\u28d4\u28