[44.620794, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1- import subprocess\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4- def report_for(name: str) -> str:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5-     command = f\"printf 'Report for: %s\\\\n' {name}\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-     result = subprocess.run(command, shell=True, check=True, capture_output=True, text=Tr\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import re\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ import subprocess\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 6 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+         raise ValueError(\"name must contain only letters, numbers, spaces, underscores, o\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+     result = subprocess.run(\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+         [\"printf\", \"Report for: %s\\n\", name],\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+         check=True,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         capture_output=True,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         text=True,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     )\r\r\n\u001b[6G\u001b[K\u001b[2m17      return result.stdout\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+16\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-6\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 