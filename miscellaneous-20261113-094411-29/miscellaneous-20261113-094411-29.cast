[218.233819, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ cd \"$SCRIPT_DIR\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ # Color codes\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ GREEN='\\033[0;32m'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ RED='\\033[0;31m'\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ END='\\033[48;5;226m  \\033[0m'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ echo \"=== Polyglot Maze Project ===\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ echo \"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+ # Step 1: Generate maze with Python\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ echo \"Step 1: Generating 25x25 maze...\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+76 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow make the scripts executable and test:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash([Command completed successfully (no output expe...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Conjuring \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[79G\u001b[K\u001b[93m\u