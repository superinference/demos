[19.647872, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ DATA = \"\"\"name,department,score\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ Avery,Engineering,94\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ Blair,Design,88\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ Casey,Marketing,91\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ Drew,Support,85\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ \"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     header: max(len(header), *(len(row[header]) for row in rows))\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     for header in headers\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+ }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ header_line = \" | \".join(header.ljust(widths[header]) for header in headers)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ separator = \"-+-\".join(\"-\" * widths[header] for header in headers)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ print(header_line)\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+3 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(name | department | score) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated and ran csv_summary.py. Final output:\r\r\n\u001b[1G\u001b[K```text\r\r\n\u001b[1G\u001b[Kname  | department  |\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m \u001b[22m\u001b[38;5;75m\u2191 34 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mIn the current directory, cre\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m      \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                      \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[39m  \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m           \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m      \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                      \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m  \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[2G\u001b[K\u001b[38;5;248m26.0 tps \u00b7 \u219113k \u2193222 \u00b7 Ctrl+B bg\u001b[39m                \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
