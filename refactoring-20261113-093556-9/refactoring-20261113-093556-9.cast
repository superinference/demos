[119.720394, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[19G\u001b[K\u001b[92m\u001b[2m\u2804\u001b[22m\u2866\u2840\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[92m\u2885\u001b[2m\u2820\u001b[22m\u001b[39m    \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m     \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m   \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2868\u287b\u001b[39m \u001b[92m\u2801\u001b[39m     \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m    \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m   \u001b[35m\u2899\u287f\u28bf\u284b\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[39G\u001b[K\u001b[92m\u001b[39m\u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m      \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l\u001b]2;\u280f AMI \u00b7 Write a Python script bench.py that defines a pure-CPU fu...\u0007"]
[119.802105, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[KVERDICT                     PASS\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mWhat it does\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mheavy_hash\u001b[22m \u2014 re-hashes the full 1 MiB payload 200 times, so it's genuinely CPU-bound (not\r\r\n\u001b[1G\u001b[Kmemory-trivial).\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1m8 distinct inputs\u001b[22m generated deterministically so serial and parallel outputs can be compared\r\r\n\u001b[1G\u001b[Kbyte-for-byte.\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mSerial run\u001b[22m \u2192 list comprehension; \u001b[1mparallel run\u001b[22m \u2192 ProcessPoolExecutor.map.\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mAssertion\u001b[22m via serial_result == parallel_result, reported as the PASS/FAIL verdict and the process\r\r\n\u001b[1G\u001b[Kexit code (0/1).\r\r\n\u001b[1G\u001b[K\u2022 stdlib only: hashlib, os, time, concurrent.futures.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mWhy ProcessPool, not ThreadPool\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KI deliberately chose ProcessPoolExecutor. Python's \u001b[1mGIL\u001b[22m serializes CPU-bound bytecode, so threads\r\r\n\u001b[1G\u001b[Kwould give ~1x speedup (no real parallelism) for this workload \u2014 hashlib does release the GIL during\r\r\n\u001b[1G\u001b[Kthe actual C-level digest, but the per-round Python loop overhead keeps threads largely serialized\r\r\n\u001b[1G\u001b[Khere. Processes sidestep the GIL entirely, which is why we see a real ~4.4x speedup across 8\r\r\n\u001b[1G\u001b[Kworkers. Switching backends is a one-line change (use_processes = False).\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KMy first\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mWrite a Python script bench.p\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
