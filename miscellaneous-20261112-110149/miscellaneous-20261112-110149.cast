[55.216866, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from pathlib import Path\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ from signal_garden import (\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     SENSORS,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     Sensor,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     analyze,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     detect_anomalies,\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ class SignalGardenTests(unittest.TestCase):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     def test_generation_is_deterministic_and_isolated(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         first = generate_telemetry(SENSORS[0], 24, 99)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         second = generate_telemetry(SENSORS[0], 24, 99)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         self.assertEqual(first, second)\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+34 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(test_all_fixture_sensors_have_signal (test_sign...) 0.1s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(SIGNAL GARDEN OBSERVATORY) 0.1s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;203m\u001b[39mPreparing file_read \u00b7 55 chars \u001b[38;5;136m8.4s\u001b[38;5;172m (reasoning\u2026)\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
