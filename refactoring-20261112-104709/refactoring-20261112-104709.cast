[18.750898, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ from time import perf_counter\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ def has_duplicates_slow(values):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     for index, value in enumerate(values):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+         for previous in values[:index]:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+             if value == previous:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+                 return True\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     return False\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ def main():\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     values = list(range(12000)) + [11999]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     start = perf_counter()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     slow_result = has_duplicates_slow(values)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u0