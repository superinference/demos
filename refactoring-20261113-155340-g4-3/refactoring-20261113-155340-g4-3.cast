[65.812969, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[25G\u001b[K \u001b[32m\u28de\u28d3\u2840\u001b[39m  \u001b[37m\u284e\u28b1\u001b[39m     \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[93m\u28e0\u28be\u2877\u001b[35m\u28de\u28d3\u2840\u001b[39m  \u001b[37m\u284e\u28b1\u001b[39m\r\r\n\u001b[26G\u001b[K\u001b[32m\u28bd\u282b\u2862\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[37m\u2808\u001b[39m     \u001b[36m\u001b[2m\u2820\u001b[22m\u2869\u288d\u001b[39m              \u001b[93m\u2839\u287a\u001b[35m\u2819\u28ff\u28ab\u2843\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[37m\u2808\u001b[39m\r\r\n\u001b[41G\u001b[K\u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m            \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m  \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \