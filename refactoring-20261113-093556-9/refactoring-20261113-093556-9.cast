[77.800318, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m12  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m3  def heavy_hash(data: bytes) -> str:\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14-     \"\"\"Hash `data` repeatedly to simulate a CPU-bound workload.\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15-     digest = data\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-     for _ in range(ROUNDS):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-         digest = hashlib.sha256(digest).digest()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     \"\"\"Hash the full large byte string 200 times (genuinely CPU-bound).\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 1 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     digest) so every iteration does ~1 MiB of work, not 32 bytes.\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+     \"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     digest = b\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     for _ in range(ROUNDS):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m21+         digest = hashlib.sha256(digest + data).digest()\r\r\n\u001b[6G\u001b[K\u001b[2m22      return digest.hex()\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m23  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m4  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+8\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-4\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-vrjaxn && python3 bench.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m-\u001b[39m bash cd /tmp/ami-demo-vrjaxn && python3 bench.py \u001b[2m16.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K           \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m    \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                    \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m        \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K           \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2824\u001b[22m\u001b[39m   \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                   \u001b[93m\u001b[2m\u2824\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m        \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u001b[2m\u2812\u001b[22m\u001b[39m                                     \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
