[221.627715, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[24G\u001b[K \u001b[32m\u28f8\u28ee\u2835\u28cc\u001b[39m        \u001b[36m\u289e\u285f\u288f\u280c\u001b[39m               \u001b[33m\u28a8\u28b7\u28f7\u28c4\u001b[2m\u2802\u001b[22m\u001b[39m          \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[24G\u001b[K \u001b[32m\u28fc\u2836\u288d\u283f\u001b[39m        \u001b[36m\u28ce\u2839\u2823\u282d\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m            \u001b[33m\u001b[2m\u2820\u001b[22m\u2819\u28aa\u2875\u2809\u001b[39m          \u001b[35m\u001b[2m\u2837\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[25G\u001b[K             \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                    \u001b[33m\u001b[2m\u2804\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u0