[24.909169, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ \"\"\"Parameterized tests for string_utils using the standard library only.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ import unittest\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ from string_utils import normalize_whitespace\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ class NormalizeWhitespaceTests(unittest.TestCase):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     cases = [\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+         (\"   \\t\\n\", \"\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         (\"one\\u00a0two\", \"one two\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         (\" leading and trailing \", \"leading and trailing\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     def test_normalizes_representative_and_edge_cases(self):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         for value, expected in self.cases:\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+15 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n"]
[24.909267, "o", "\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;136m\u001b[39mRunning python3 -m unittest -v test_string_utils \u00b7 165 chars \u001b[2m3.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[7G\u001b[K\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m     \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[32m\u2898\u28be\u2877\u2843\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m                                   \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[7G\u001b[K\u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2824\u001b[22m\u001b[39m      \u001b[32m\u2811\u2801\u2808\u280a\u001b[39m                \u001b[36m\u284d\u28a9\u001b[39m  \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                \u001b[35m\u2894\u285f\u28ab\u2863\u001b[39m\r\r\n\u001b[9G\u001b[K                            \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007