[178.468267, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mBefore the fix\u001b[22m (buggy lexicographic string comparison record[\"score\"] > str(threshold)):\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K[FAIL] threshold=  90  expected=['Alice', 'Carol']  got=['Alice']\r\r\n\u001b[1G\u001b[K[FAIL] threshold= 100  expected=[]  got=['Alice', 'Bob', 'Dave', 'Eve']\r\r\n\u001b[1G\u001b[K[PASS] threshold=   0  expected=[...all...]  got=[...all...]\r\r\n\u001b[1G\u001b[K[FAIL] threshold=  85  expected=['Alice', 'Carol', 'Dave']  got=['Alice', 'Dave', 'Eve']\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K1/4 cases passed\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mAfter the fix\u001b[22m (float(record[\"score\"]) > threshold):\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K[PASS] threshold=  90  expected=['Alice', 'Carol']  got=['Alice', 'Carol']\r\r\n\u001b[2G\u001b[KPASS] threshold= 100  expected=[]  got=[]\r\r\n\u001b[1G\u001b[K[PASS] threshold=   0  expected=[...all...]  got=[...all...]\r\r\n\u001b[1G\u001b[K[PASS] threshold=  85  expected=['Alice', 'Carol', 'Dave']  got=['Alice', 'Carol', 'Dave']\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K4/4 cases passed\r\r\n\u001b[1G\u001b[K\u001b[1mWhat the bug was\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[E\u001b[1G\u001b[KThe original code\r\r\n\u001b[3G\u001b[K\u001b[38;