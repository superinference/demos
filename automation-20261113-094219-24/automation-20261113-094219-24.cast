[167.760004, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K-\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m \u001b[22m\u001b[38;5;75m\u2191 79 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mInitialize a new git repo in \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K \u001b[92m\u289b\u28d3\u28e1\u001b[39m \u001b[37m\u2808\u2801\u2801\u2890\u001b[39m         \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m              \u001b[33m\u28f0\u28bf\u2866\u28c4\u001b[39m               \u001b[35m\u289b\u28d3\u28e1\u001b[39m \u001b[37m\u2808\u2801\u2801\u2890\u001b[39m\r\r\n\u001b[20G\u001b[K\u001b[92m\u282b\u2863\u001b[39m \u001b[92m\u001b[2m\u2802\u001b[22m\u001b[37m\u2810\u2808\u001b[39m          \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m              \u001b[33m\u2809\u283a\u28b7\u285f\u001b[39m              \u001b[35m\u2819\u285f\u28ab\u2843\u001b[39m  \u001b[37m\u2810\u2808\u001b[39m\r\r\n\u001b[38G\u001b[K\u001b[36m\u001b[2m\u001b[22m\u001b[39m                    \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[19G\u001b[K\u001b[38;5;248m87 \u00b7 C\u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u00