[62.851114, "o", "\u001b[29A\u001b[E\u001b[13G\u001b[K\u001b[2m\u001b[22mCommand-line interface for the unit converter.\"\"\"\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22mimport argparse\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mimport sys\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mdef create_parser():\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m\"\"\"Create and configure the argument parser.\"\"\"\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mparser = argparse.ArgumentParser(\r\r\n\u001b[E\u001b[12G\u001b[K\u001b[2m\u001b[22m%(prog)s 100 km miles\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m  %(prog)s 72 fahrenheit celsius\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m   %(prog)s 5 kg pounds\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m        \"\"\"\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m    )\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mparser.add_argument(\r\r\n\u001b[16G\u001b[K\u001b[2m29 more lines)\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Crystallizing \u001b[2m20.4s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m                \u001b[36m\u2890\u2842\u001b[39m                                 \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m           \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                              \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m           \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                     \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m    \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m            \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[62.945365, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[62.945418, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2880\u28fa\u28d3\u2840\u001b[39m  \u001b[37m\u280a\u2811\u001b[39m            \u001b[36m\u2890\u2842\u001b[39m                                 \u001b[35m\u2880\u28fa\u28d3\u2840\u001b[39m  \u001b[37m\u280a\u2811\u001b[39m        \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2814\u283d\u282b\u2862\u001b[2m\u2802\u001b[22m\u001b[39m               \u001b[36m\u284d\u28a9\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                               \u001b[35m\u2819\u287f\u28bb\u284b\u001b[39m           \u001b[93m\u001b[2m\u2824\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n\u001b[73G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m\u001b[36m\u001b[2m\u001b[22m\u001b[39m                   \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m