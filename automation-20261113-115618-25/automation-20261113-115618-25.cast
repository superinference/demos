[165.012158, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[1G\u001b[K\u001b[1mSummary\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KCreated \u001b[1mroman.py\u001b[22m with:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1m\u001b[3mThree main functions:\u001b[23m\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K1. \u001b[1mto_roman(num)\u001b[22m - Converts integers (1-3999) to Roman numerals\r\r\n\u001b[1G\u001b[K2. \u001b[1mfrom_roman(roman_str)\u001b[22m - Converts Roman numerals back to integers\r\r\n\u001b[1G\u001b[K3. \u001b[1mis_valid_roman(roman_str)\u001b[22m - Validates Roman numeral strings\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mKey features:\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mGoogle-style docstrings\u001b[22m with Args, Returns, Raises, and Examples sections\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mComprehensive examples\u001b[22m in every function (6+ examples per function)\r\r\n\u001b[3G\u001b[K\u001b[1mProper validation\u001b[22m with meaningful error messages\r\r\n\u001b[3G\u001b[K\u001b[1mSubtractive notation\u001b[22m handling (IV, IX, XL, XC, CD, CM)\r\r\n\u001b[3G\u001b[K\u001b[1mRound-trip validation\u001b[22m to ensure correctness\r\r\n\u001b[3G\u001b[K\u001b[1m__main__ block\u001b[22m that prints a beautiful two-column table for 1-50 plus sample conversions\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mOutput verification:\u001b[23m\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K-\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
