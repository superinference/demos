[33.874357, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[33.874527, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ Solve the cryptarithmetic puzzle: EAT + THAT = APPLE\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ Each letter represents a unique digit (0-9).\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ Leading letters E, T, A cannot be zero.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ from itertools import permutations\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     # Extract unique letters: E, A, T, H, P, L\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     letters = ['E', 'A', 'T', 'H', 'P', 'L']\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     # Try all permutations of 6 unique digits from 0-9\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     for perm in permutations(range(10), 6):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+         # Create a mapping\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         mapping = dict(zip(letters, perm))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+65 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Crystallizing \u001b[2m5.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[55G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m      \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m\u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m    \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[56G\u001b[K \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n"]
