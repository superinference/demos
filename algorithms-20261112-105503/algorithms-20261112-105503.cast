[18.493378, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[18.494628, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ SAMPLE_COUNT = 1_000_000\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def estimate_pi(sample_count: int) -> float:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     points_inside = 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     for _ in range(sample_count):\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     return 4.0 * points_inside / sample_count\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ def main() -> None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     estimate = estimate_pi(SAMPLE_COUNT)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     absolute_error = abs(estimate - 3.141592653589793)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     print(f\"Monte Carlo \u03c0 estimate using {SAMPLE_COUNT:,} samples\")\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+6 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-TlUzJs && python3 estimate_pi.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-TlUzJs && python3 estimate_pi.py \u001b[2m1.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K\u001b[32m\u2880\u28fa\u28d7\u28c0\u001b[2m\u2824\u001b[22m\u001b[37m\u2814\u2813\u281a\u2802\u001b[39m           \u001b[36m\u2890\u2842\u001b[2m\u2820\u001b[22m\u001b[39m               \u001b[93m\u28e0\u28be\u2877\u28ff\u001b[39m             \u001b[35m\u2880\u28fa\u28d7\u28c0\u001b[2m\u2812\u001b[22m\u001b[37m\u2814\u2813\u281a\u2802\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2814\u281f\u282b\u2862\u001b[39m                \u001b[36m\u2869\u288d\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                              \u001b[35m\u2819\u285f\u28bb\u284b\u001b[39m\r\r\n\u001b[22G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m               \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                  \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m                         \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39mopenai/gpt-5.6-luna \u00b7  2% \u001b[22m\u001b[38;5;35m\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
