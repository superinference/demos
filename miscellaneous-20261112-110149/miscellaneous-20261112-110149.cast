[81.649138, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u2022 Deterministic synthetic telemetry for four sensors:\r\r\n\u001b[1G\u001b[K  \u25e6 Canopy Temperature\r\r\n\u001b[1G\u001b[K  \u25e6 Soil Moisture\r\r\n\u001b[1G\u001b[K  \u25e6 Light Flux\r\r\n\u001b[1G\u001b[K  \u25e6 Air Pressure\r\r\n\u001b[1G\u001b[K\u2022 Robust anomaly detection using:\r\r\n\u001b[1G\u001b[K  \u25e6 Median and MAD-based modified z-scores for spikes\r\r\n\u001b[5G\u001b[KMedian-window trend comparison for drift\r\r\n\u001b[1G\u001b[K\u2022 Polished dark-theme SVG visualization with:\r\r\n\u001b[5G\u001b[KSensor traces\r\r\n\u001b[5G\u001b[KSpike markers\r\r\n\u001b[1G\u001b[K  \u25e6 Drift markers\r\r\n\u001b[5G\u001b[KSensor statistics and legend\r\r\n\u001b[1G\u001b[K\u2022 Concise terminal dashboard\r\r\n\u001b[3G\u001b[KSix automated tests covering:\r\r\n\u001b[5G\u001b[KDeterministic generation\r\r\n\u001b[20G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;75m15 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mIn this empty current directo\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
