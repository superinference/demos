[60.583284, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from roman_numerals import (\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     MAX_VALUE,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     MIN_VALUE,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     int_to_roman,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     roman_to_int,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ )\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     (14, \"XIV\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     (44, \"XLIV\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     (99, \"XCIX\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     (399, \"CCCXCIX\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     (944, \"CMXLIV\"),\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     (1994, \"MCMXCIV\"),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     (3999, \"MMMCMXCIX\"),\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+49 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-elZciS && python -m pytest -v test_roman...\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\\\u001b[39m bash cd /tmp/ami-demo-elZciS && python -m pytest -v test_roman... \u001b[2m16.5s\u001b[22