[147.01057, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ use std::collections::{VecDeque, HashSet};\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+ use std::fs;\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3+ use std::io;\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+ use std::path::Path;\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+ #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+ struct Pos(usize, usize);\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ #[derive(serde::Serialize, serde::Deserialize)]\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     start: [usize; 2],\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m15+     end: [usize; 2],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ }\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ #[derive(serde::Serialize, serde::Deserialize)]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ struct MazeOutput {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     path: Vec<[usize; 2]>,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+109 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Conjuring \u001b[2m49.6s\u001b[22m\r\r\n\u001b[3G\