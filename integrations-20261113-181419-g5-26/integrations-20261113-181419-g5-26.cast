[302.418753, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K                                                                          \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                   \u001b[92m\u28ce\u2893\u001b[39m   \u001b[37m\u284e\u28b1\u001b[39m    \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m                                 \u001b[35m\u28ce\u2893\u001b[39m   \u001b[37m\u284e\u28b1\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                   \u001b[92m\u28bc\u2827\u2842\u001b[39m  \u001b[37m\u28bc\u2867\u001b[39m    \u001b[36m\u287d\u2839\u280f\u28af\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                               \u001b[35m\u28fe\u28a7\u2843\u001b[39m  \u001b[37m\u28bc\u2867\u001b[39m\r\r\n\u001b[5G\u001b[K \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                 \u001b[92m\u001b[2m\u2820\u001b[22m\u001b[39m             \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                       \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[12G\u001b[K\u001b[92m\u001b[2mt\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u0