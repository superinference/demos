[100.96499, "o", "\u001b[29A\u001b[1G\u001b[K\u2705 \u001b[1mStandard Library Only\u001b[22m \u2014 Uses only random and collections.deque\r\r\n\u001b[1G\u001b[K\u2705 \u001b[1mReproducible\u001b[22m \u2014 Seeded random generation ensures the same maze every run\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe script generates a perfect maze (no loops, single path between any two points) using recursive\r\r\n\u001b[1G\u001b[Kbacktracking, then solves it optimally with BFS, giving you the shortest route from start to finish\r\r\n\u001b[1G\u001b[Kmarked with dots.\r\r\n\u001b[E\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- **Recursive backtracking** carves paths by stepping 2 cells at a time (to maintain alternating\r\r\n\u001b[1G\u001b[Kwall/path structure), then randomizing direction order to create variety\r\r\n\u001b[1G\u001b[K- **BFS** guarantees the shortest path because it explores layer-by-layer; we track parents to\r\r\n\u001b[1G\u001b[Kreconstruct the path at the end\r\r\n\u001b[5G\u001b[KSeeding with 42** makes the maze identical each run for reproducibility while still looking\r\r\n\u001b[1G\u001b[Kgenuinely random\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Forged for 1m 27s \u00b7 done 3:23 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[1.7m | 37070 tokens | $0.02] Done in 4 turns \u00b7 done 3:23 PM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[7G\u001b[K\u001b[2mdiffs expand automatically so you see each change\u001b[22m\r\r\n\u001b[1G\u001b[K                                                        \u001b[93m\u001b[2m\u2880\u2840\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2890\u2842\u2820\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u28f4\u28bb\u285f\u28e6\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u284d\u28a9\u001b[22m\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[93m\u001b[2m\u2808\u283b\u281f\u2801\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[21G\u001b[K                                                      \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u001b[22m\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[36m\u001b[2m Explorer  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l\u001b]2;\u2b22 AMI \u00b7 Random ASCII Maze Generator and BFS Solver\u0007"]
[101.061804, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[101.062209, "o", "\u001b[1;1H\u001b[J\u2705 \u001b[1mStandard Library Only\u001b[22m \u2014 Uses only random and collections.deque\r\r\n\u2705 \u001b[1mReproducible\u001b[22m \u2014 Seeded random generation ensures the same maze every run\r\r\n\r\r\nThe script generates a perfect maze (no loops, single path between any two points) using recursive\r\r\nbacktracking, then solves it optimally with BFS, giving you the shortest route from start to finish\r\r\nmarked with dots.\r\r\n\r\r\n\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n- **Recursive backtracking** carves paths by stepping 2 cells at a time (to maintain alternating\r\r\nwall/path structure), then randomizing direction order to create variety\r\r\n- **BFS** guarantees the shortest path because it explores layer-by-layer; we track parents to\r\r\nreconstruct the path at the end\r\r\n- **Seeding with 42** makes the maze identical each run for reproducibility while still looking\r\r\ngenuinely random\r\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\r\r\n\u001b[2m\u2733 Forged for 1m 27s \u00b7 done 3:23 PM\u001b[22m\r\r\n\r\r\n\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n[1.7m | 37070 tokens | $0.02] Done in 4 turns \u00b7 done 3:23 PM\r\r\nGoodbye.\r\r\n\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mRandom ASCII Maze Generator a\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n \u001b[2mTip: diffs expand automatically so you see each change\u001b[22m\r\r\n                                                        \u001b[93m\u001b[2m\u2880\u2840\u001b[22m\u001b[39m\r\r\n                 \u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2890\u2842\u2820\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u28f4\u28bb\u285f\u28e6\u001b[22m\u001b[39m\r\r\n                 \u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u284d\u28a9\u001b[22m\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m             \u001b[93m\u001b[2m\u2808\u283b\u281f\u2801\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n                                                                          \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u001b[22m\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[36m\u001b[2m Explorer  \u258c\u001b[22m\u001b[39m\r\r\n \u001b[2mSi:AMI \u00b7 /help \u00b7 Ctrl+D exit\u001b[22m     \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
