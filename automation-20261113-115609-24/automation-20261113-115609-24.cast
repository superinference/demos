[131.346145, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K                                                          \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[36m\u2816\u2853\u2897\u2813\u001b[39m       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m    \u001b[93m\u28c0\u285d\u2837\u28ec\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[36m\u28b8\u28b5\u284d\u2809\u001b[39m       \u001b[35m\u2899\u287f\u28bf\u284b\u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m \u001b[93m\u283d\u287b\u28a7\u2821\u001b[39m\r\r\n\u001b[40G\u001b[K\u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m        \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m          \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u25