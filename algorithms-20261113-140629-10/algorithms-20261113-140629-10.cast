[53.898277, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[38G\u001b[K\u001b[32m\u001b[39m\u001b[37m\u001b[39m\u001b[36m\u28ff\u28ff\u28e2\u2844\u001b[39m          \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                  \u001b[35m\u001b[2m\u2804\u001b[22m\u284e\u2809\u2809\u28b1\u001b[39m \u001b[37m\u284e\u2809\u2809\u28b1\u001b[39m\r\r\n\u001b[35G\u001b[K\u001b[32m\u001b[39m\u001b[37m\u001b[39m\u001b[36m\u001b[2m\u2820\u001b[22m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m          \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                 \u001b[35m\u2808\u281d\u2809\u2801\u001b[2m\u2820\u001b[22m\u001b[37m\u2808\u281d\u2809\u2801\u001b[39m\r\r\n\u001b[39G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m           \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[36m\u001b[2me\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5