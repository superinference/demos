[75.554821, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[75.554888, "o", "\u001b[29A\u001b[1G\u001b[K  \u2717\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KSummary \u2014 files matched by each pattern:\r\r\n\u001b[3G\u001b[K*.tar.gz           -> ['snapshot_2024.tar.gz', 'archive.tar.gz']\r\r\n\u001b[1G\u001b[K  report_?????.pdf   -> ['report_final.pdf']\r\r\n\u001b[3G\u001b[Kdata_v*.csv        -> ['data_v3.csv']\r\r\n\u001b[1G\u001b[K  *.*                -> ['snapshot_2024.tar.gz', 'report_final.pdf', 'data_v3.csv', 'notes.txt',\r\r\n\u001b[1G\u001b[K'archive.tar.gz']\r\r\n\u001b[3G\u001b[K???es.txt          -> ['notes.txt']\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KA couple of results worth verifying by eye:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 report_?????.pdf matched only report_final.pdf because final is exactly 5 chars \u2014 each ? consumes\r\r\n\u001b[1G\u001b[Kone. A 6-char stem would fail.\r\r\n\u001b[1G\u001b[K\u2022 ???es.txt matched notes.txt: not fills the three ?, then es.txt matches literally.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mHow the DP works:\u001b[22m dp[i][j] answers \"do the first i chars of the filename match the first j chars of\r\r\n\u001b[1G\u001b[Kthe pattern?\" The whole algorithm hinges on the * recurrence \u2014 a * either matches \u001b[3mnothing\u001b[23m\r\r\n\u001b[1G\u001b[K(dp[i][j-1], skip the star) or \u001b[3mconsumes one more character\u001b[23m and stays available (dp[i-1][j]). That\r\r\n\u001b[1G\u001b[Ksingle OR is what lets one * absorb an arbitrary-length run without backtracking.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python file pattern_\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
