[101.351841, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m53-     print(f\"{'Rank':<5} {'Drink':<15} {'Mean':<10} {'Median':<10} {'7-Day Trend':<20}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m54-     print(\"=\" * 80)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m55-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m56-     for rank, (drink, mean, median, sales) in enumerate(stats_list, 1):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-         marker = \"\u2605\" if rank <= 3 else \" \"\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 9 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+         marker = \"\u2605\" if rank <= 3 else \" \"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         spark = sparkline(sales)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         print(f\"{marker:<3} {rank:<5} {drink:<15} {mean:<10.2f} {median:<10.1f} {spark}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m60+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m61+     print(\"=\" * 90 + \"\\n\")\r\r\n\u001b[6G\u001b[K\u001b[2m62  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m63  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m64  if __name__ == \"__main__\":\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+10\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-10\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it again to show the final output with the \u2605 markers:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-zgDyhr && python3 stats.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-zgDyhr && python3 stats.py \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K                  \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m             \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K                 \u001b[36m\u001b[2m\u2802\u001b[22m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m \u001b[32m\u001b[2m\u2809\u001b[22m\u001b[39m           \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[19G\u001b[K                    \u001b[36m\u001b[2m\u2820\u001b[32m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[K\u001b[38;5;248mTab inspect \u00b7 Ctrl+B bg\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
