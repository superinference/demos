[75.050107, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[1m\u001b[3m2. Top 5 Most Frequently Erupting Volcanoes\u001b[23m\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K1. \u001b[1mSakurajima\u001b[22m \u2014 5.0 yr median (most active)\r\r\n\u001b[1G\u001b[K2. \u001b[1mKilauea\u001b[22m \u2014 7.0 yr median\r\r\n\u001b[1G\u001b[K3. \u001b[1mMerapi\u001b[22m \u2014 9.0 yr median\r\r\n\u001b[1G\u001b[K4. \u001b[1mMount Etna\u001b[22m \u2014 10.0 yr median\r\r\n\u001b[1G\u001b[K5. \u001b[1mYasur\u001b[22m \u2014 10.0 yr median\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3m3. Longest Quiet Period\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mSanta Maria\u001b[22m: 38 years without eruption (1922\u20131960)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mTechnical Highlights\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mRepose interval calculation\u001b[22m: Computes gaps between consecutive eruptions for each volcano\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mStandard library only\u001b[22m: Uses statistics.mean(), statistics.median(), and manual ASCII table\r\r\n\u001b[1G\u001b[Kformatting\r\r\n\u001b[3G\u001b[K\u001b[1mClean output\u001b[22m: Custom print_table() function creates bordered, centered tables for readability\r\r\n\u001b[3G\u001b[K\u001b[1mRealistic data\u001b[22m: 15 volcanoes with 5\u201310 eruption records each, using approximate historical dates\r\r\n\u001b[1G\u001b[K(Mount Etna, Sakurajima, Mount Merapi, Kilauea, etc.)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python script stats.\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
