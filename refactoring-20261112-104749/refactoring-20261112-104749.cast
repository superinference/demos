[36.539762, "o", "\u001b[29A\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Results match: yes | serial: 0.607s | threads: ...) 0.8s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated and ran /tmp/ami-demo-oDujj8/parallel_demo.py.\r\r\n\u001b[1G\u001b[KFinal result:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KResults match: yes | serial: 0.607s | threads: 0.154s | speedup: 3.94x\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- `ThreadPoolExecutor` is effective here because each task spends time sleeping, allowing other\r\r\n\u001b[1G\u001b[Kthreads to run.\r\r\n\u001b[1G\u001b[K- `executor.map` preserves input order, making direct result comparison with the serial version\r\r\n\u001b[1G\u001b[Kstraightforward.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Brewed for 23s \u00b7 done 10:48 AM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[34s | 35228 tokens | $0.0027] Done in 7 turns \u00b7 done 10:48 AM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[74G\u001b[K\u001b[38;5;239m\u001b[2m\u001b[22m\u001b[38;5;35mParallel Demo with Thr\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[7G\u001b[K\u001b[2m--skill <name> pins a skill stance (e.g. pentest, swebench)\u001b[22m\r\r\n\u001b[57G\u001b[K\u001b[93m\u001b[2m\u2880\u2840\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[22m\u001b[39m              \u001b[93m\u001b[2m\u28f4\u28bb\u2877\u28c4\u2824\u001b[22m\u001b[39m              \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[22m\u001b[39m              \u001b[93m\u001b[2m\u2808\u283b\u2837\u280b\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u001b[22m\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                                                       \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[32m\u001b[2m Mentor  Ask anything\u001b[22m\u001b[39m\r\r\n"]
