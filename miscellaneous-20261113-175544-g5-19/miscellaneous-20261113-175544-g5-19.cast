[141.760031, "o", "\u001b[29A\u001b[3G\u001b[K\u001b[2m\u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ import base64\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ # Define the three scripts with base64 placeholders\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ bash_template = b'''#!/bin/bash\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ # Step 3/3: Bash quine - outputs Python\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ s='!!PYTHON_B64!!'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ echo \"$s\" | base64 -d\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ '''\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ puts s.unpack(\"m\")[0]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ '''\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ python_template = b'''#!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ # Step 1/3: Python quine - outputs Ruby\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ import base64\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ s='!!RUBY_B64!!'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+26 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u00