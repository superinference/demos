[51.482836, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ CATEGORIES = {\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+     0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3+     4: \"four\", 5: \"five\", 6: \"six\", 7: \"seven\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+     8: \"eight\", 9: \"nine\", 10: \"ten\", 11: \"eleven\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     12: \"twelve\", 13: \"thirteen\", 14: \"fourteen\", 15: \"fifteen\",\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ def classify(code):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+     return CATEGORIES[code]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+ if __name__ == \"__main__\":\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     for i in range(16):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         print(classify(i))\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run both and diff them:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Error: Blocked: unquoted redirect operators det...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Hyperspacing \u001b[2m0.0s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u250