[45.997142, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ # 20 daily temperature data points (in Fahrenheit)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ temperatures = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     72, 75, 68, 71, 76, 79, 81, 78, 74, 70,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     69, 73, 77, 80, 82, 75, 72, 71, 76, 78\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ ]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ max_temp = max(temperatures)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ top_3_highest = sorted(temperatures, reverse=True)[:3]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ # Create summary table\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ summary_data = [\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+     [\"Mean\", f\"{mean_temp:.2f}\u00b0F\"],\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     [\"Median\", f\"{median_temp:.2f}\u00b0F\"],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+11 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run it:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Traceback (most recent call last):) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Noodling \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b