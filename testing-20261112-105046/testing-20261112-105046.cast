2m\u001b[39m                      \u001b[36m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m        \u001b[33m\u001b[2m\u28f0\u28bf\u2866\u28c4\u001b[22m\u001b[39m                          \u001b[35m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[32m\u001b[2m\u2810\u28bf\u28ff\u283f\u28ff\u287f\u2802\u001b[22m\u001b[39m                     \u001b[36m\u001b[2m\u287d\u2839\u280f\u28af\u001b[22m\u001b[39m      \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m \u001b[33m\u001b[2m\u2809\u283a\u28f7\u281f\u001b[22m\u001b[39m                          \u001b[35m\u001b[2m\u28b9\u285f\u28bb\u284f\u001b[22m\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u001b[2m\u2801\u001b[22m\u001b[39m \u001b[32m\u001b[2m\u2808\u001b[22m\u001b[39m                        \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                           \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[15G\u001b[K\u001b[32m\u001b[2mm\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u