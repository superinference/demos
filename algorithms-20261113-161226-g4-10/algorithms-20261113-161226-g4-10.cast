[129.129714, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m23+         # Initialize distances and parent tracking\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         distances = {node: float('inf') for node in all_nodes}\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         distances[start] = 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         parent = {node: None for node in all_nodes}\r\r\n\u001b[6G\u001b[K\u001b[2m27          \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m28          # Min heap: (distance, node)\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m9          pq = [(0, start)]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+10\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-4\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Shortest path from A to E:) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KPerfect! Here's the result:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mOutput:\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KShortest path from A to E:\r\r\n\u001b[1G\u001b[KPath: A -> C -> B -> E\r\r\n\u001b[1G\u001b[KTotal cost: 4\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mHow it works:\u001b[22m\r\r\n\u001b[1G\u001b[KThe implementation uses a **min-heap priority queue** to always process the nearest unvisited node\r\r\n\u001b[1G\u001b[Knext. The algorithm\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[2G\u001b[K\u001b[38;5;248m10.0 tps \u00b7 \u219143k \u21931.2k \u00b7 Ctrl+B bg\u001b[39m \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
