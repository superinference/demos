[40.814257, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ Volcanic Eruption Analysis\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ Analyzes historical eruption data for active volcanoes.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ from statistics import mean, median\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ from collections import defaultdict\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ from textwrap import dedent\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     \"Mount Etna\": [1909, 1928, 1950, 1971, 1981, 1992, 2001, 2008, 2017, 2021],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     \"Sakurajima\": [1955, 1960, 1974, 1981, 1995, 2008, 2013, 2017, 2020, 2023],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     \"Merapi\": [1961, 1972, 1988, 1997, 2006, 2010, 2018, 2023],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     \"Stromboli\": [1952, 1966, 1975, 1989, 2002, 2012, 2019],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     \"Kilauea\": [1940, 1960, 1971, 1983, 1990, 2008, 2015, 2018, 2021, 2023],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     \"Yasur\": [1960, 1975, 1987, 2003, 2011, 2017, 2022],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     \"Pacaya\": [1961, 1976, 1987, 2000, 2010, 2021],\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+163 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2