[29.986233, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import statistics\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ from tabulate import tabulate\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ # 20 daily temperature data points (in Fahrenheit)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ temperatures = [\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     72, 75, 68, 71, 76, 79, 81, 78, 74, 70,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     69, 73, 77, 80, 82, 75, 72, 71, 76, 78\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ ]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ max_temp = max(temperatures)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ top_3_highest = sorted(temperatures, reverse=True)[:3]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ # Create summary table\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ summary_data = [\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     [\"Mean\", f\"{mean_temp:.2f}\u00b0F\"],\r\r\n