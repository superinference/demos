[37.211709, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ from pathlib import Path\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from report import report_for\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ MARKER = Path(\"injection_marker.txt\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ def test_name_cannot_execute_a_command() -> None:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+     MARKER.unlink(missing_ok=True)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+     report_for(f\"Alice; touch {MARKER}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     assert not MARKER.exists(), \"command-injection marker was executed\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ if __name__ == \"__main__\":\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     test_name_cannot_execute_a_command()\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     print(\"PASS: injection marker was not created\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(VULNERABLE: marker executed) 0.1s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[2m\u2234 Thinking #4\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;136m\u001b[39mPreparing file_read \u00b7 55 chars \u001b[2m4.5s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
