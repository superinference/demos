[119.088162, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[6G\u001b[K\u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m        \u001b[32m\u2811\u2884\u2860\u280a\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m          \u001b[36m\u2860\u28ea\u28db\u2802\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                \u001b[35m\u2811\u2884\u2860\u280a\u001b[39m \u001b[37m\u2811\u2884\u2860\u280a\u001b[39m\r\r\n\u001b[5G\u001b[K\u001b[93m\u001b[2m\u2824\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m        \u001b[32m\u2814\u2801\u2808\u2822\u001b[2m\u2836\u001b[22m\u001b[37m\u2814\u2801\u2808\u2822\u001b[39m          \u001b[36m\u28f9\u2815\u28ae\u28a2\u001b[39m                                  \u001b[35m\u2814\u2801\u2808\u2822\u001b[2m\u2837\u001b[22m\u001b[37m\u2814\u2801\u2808\u2822\u001b[39m\r\r\n\u001b[9G\u001b[K\u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m        \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001