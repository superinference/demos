[232.589086, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[30G\u001b[K\u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m    \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[93m\u28e0\u288e\u28f7\u28c4\u001b[39m      \u001b[32m\u2898\u289c\u2805\u284d\u001b[39m \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[30G\u001b[K\u001b[35m\u2899\u287f\u28bf\u283b\u001b[2m\u2837\u001b[22m\u001b[39m   \u001b[36m\u2869\u288d\u001b[39m                \u001b[93m\u28ad\u28da\u2895\u2837\u001b[2m\u2809\u001b[22m\u001b[39m     \u001b[32m\u2830\u281c\u28ab\u2882\u001b[39m\r\r\n\u001b[1G\u001b[K                               \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m         \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                         \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[