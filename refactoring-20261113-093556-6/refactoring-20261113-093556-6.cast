[94.402461, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import subprocess, difflib\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ a = subprocess.run([\"python3\", \"nested.py\"], capture_output=True, text=True).stdout\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ b = subprocess.run([\"python3\", \"refactored.py\"], capture_output=True, text=True).stdout\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+ print(\"=== nested.py output ===\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+ print(a, end=\"\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ print(\"\\n=== diff (unified) ===\")\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     print(\"\\nRESULT: DIFFERENCES FOUND\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ else:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     print(\"(empty)\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     print(\"RESULT: NO DIFFERENCES - outputs match exactly\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m18+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ print(\"\\n=== line counts ===\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ nl = len(open(\"nested.py\").readlines())\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+4 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250