[32.452011, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ from pathlib import Path\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from report import report_for\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ MARKER = Path(\"injection_marker.txt\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ def test_name_cannot_execute_a_command() -> None:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m0+     MARKER.unlink(missing_ok=True)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+     report_for(f\"Alice; touch {MARKER}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+     assert not MARKER.exists(), \"command-injection marker was executed\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ if __name__ == \"__main__\":\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     test_name_cannot_execute_a_command()\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m17+     print(\"PASS: injection marker was not created\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(VULNERABLE: marker executed) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Tinkering \u001b[2m3.0s\u001b[22m\r\r\n\u001b[E\