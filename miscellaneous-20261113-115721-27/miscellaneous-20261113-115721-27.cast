[58.698603, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 4+ import heapq\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ WIDTH, HEIGHT = 41, 21  # odd dimensions so walls/cells alternate\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ WALL, PATH = '#', ' '\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ GREEN, RESET = '\\033[92m', '\\033[0m'\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     rng = random.Random(seed)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     grid = [[WALL] * w for _ in range(h)]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     def carve(cx, cy):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         grid[cy][cx] = PATH\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         dirs = [(0, -2), (0, 2), (-2, 0), (2, 0)]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         rng.shuffle(dirs)\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+77 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's run it. Recursion depth could be an issue for 41\u00d721 (max ~420 cells), so it's fine.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Unsolved maze:) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Conjuring \u001b[2m0.0s\u001b[2