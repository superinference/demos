[87.994451, "o", "\u001b[29A\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## Performance\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K- Processes files in a single pass.\r\r\n\u001b[1G\u001b[K- Memory usage is constant regardless of file size.\r\r\n\u001b[1G\u001b[K- Typical throughput: ~200 MB/s on modern hardware.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## Exit codes\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K| Code | Meaning |\r\r\n\u001b[1G\u001b[K|------|---------|\r\r\n\u001b[1G\u001b[K| 0 | Success |\r\r\n\u001b[1G\u001b[K| 1 | One or more files not found or unreadable |\r\r\n\u001b[1G\u001b[K| 2 | Invalid arguments |\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## License\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KMIT\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K**\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mActivate the cognitive-doc-de\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E