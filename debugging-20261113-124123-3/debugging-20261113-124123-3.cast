[299.390363, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[299.390966, "o", "\u001b[29A\u001b[1G\u001b[KPWNED_BY_YAML_ATTACK      \u2190 os.system executed during parsing\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mThe fix\u001b[22m\r\r\n\u001b[1G\u001b[Kconfig = yaml.safe_load(f)   # FIXED\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[Ksafe_load uses SafeLoader, which only builds plain YAML types (dict/list/scalars) and rejects\r\r\n\u001b[1G\u001b[KPython-object tags. I also wrapped the call to catch yaml.YAMLError so the refusal is reported\r\r\n\u001b[1G\u001b[Kcleanly.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mProof the attack is neutralized (fixed version, same malicious file):\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KRefused to load config: unsafe or invalid YAML.\r\r\n\u001b[1G\u001b[KReason: ConstructorError\r\r\n\u001b[1G\u001b[K=== Did the attack create pwned.txt? ===\r\r\n\u001b[1G\u001b[KSUCCESS: pwned.txt was NOT created \u2014 attack neutralized\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[1mProof normal configs still work:\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KLoaded settings:\r\r\n\u001b[1G\u001b[K{'app_name': 'demo', 'debug': True, 'port': 8080, 'hosts': ['a.example', 'b.example']}\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K## Files created\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a small Python script \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[32m\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u2877\u2843\u001b[2m\u2820\u001b[22m\u001b[39m     \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m     \u001b[36m\u001b[2m\u2802\u001b[22m\u2890\u2842\u001b[39m   \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2890\u281d\u2808\u2802\u001b[39m      \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m      \u001b[36m\u2869\u288d\u001b[39m      \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K             \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m        \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m    \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[15G\u001b[K\u001b[36m\u001b[2mc\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
