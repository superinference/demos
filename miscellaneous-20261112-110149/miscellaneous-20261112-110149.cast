[81.29406, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[81.295312, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502    2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  104          window = values[end - drift_window * 2:end]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  105          first, last = window[:drift_window], window[drift_window:]\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m106          slope = (statistics.median(last) - statistics.median(first)) / drift_window\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m107-         local_mad = median_absolute_deviation(window)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m108-         scale = max(local_mad, mad, 1e-9)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m107+         # A trend inflates the window MAD, so use the known sensor noise floor\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m108+         # rather than letting the suspected drift hide its own signal.\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m109+         scale = max(sensor.noise, 1e-9)\r\r\n\u001b[6G\u001b[K\u001b[2m110          score = slope * drift_window / scale\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m111          if abs(score) >= drift_threshold:\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m112              direction = \"rising\" if score > 0 else \"falling\"\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(test_all_fixture_sensors_have_signal (test_sign...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(SIGNAL GARDEN OBSERVATORY) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #7\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KBuilt \u001b[1mSignal Garden Observatory\u001b[22m, a self-contained dependency-free Python project using only the\r\r\n\u001b[1G\u001b[Kstandard library.\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mIncluded\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K- Deterministic synthetic telemetry\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m \u001b[22m\u001b[38;5;75m\u2191 122 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mIn this empty current directo\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m   \u001b[36m\u2890\u2842\u001b[39m                                   \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m \u001b[92m\u001b[2m\u2804\u001b[22m\u001b[39m       \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[36m\u284d\u28a9\u001b[39m                                   \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m  \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n"]
