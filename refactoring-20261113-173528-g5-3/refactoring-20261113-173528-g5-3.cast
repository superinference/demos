[141.455244, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m3-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4-     sales_items = [r for r in records if r['category'] == 'sales']\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5-     sales_total = 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-     sales_count = 0\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-     for item in sales_items:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8-         sales_total += item['amount']\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9-         sales_count += 1\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10-     results.append({\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 17 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8+         'category': category,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+         'total': sum(item['amount'] for item in items),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+         'count': len(items),\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+     }\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def process_records(records):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     return [summarize(records, category) for category in CATEGORIES]\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+14\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;