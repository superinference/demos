[134.959753, "o", "\u001b[29A\u001b[5G\u001b[K                                       >      results.append(_summarize_by_status(records,\r\r\n\u001b[1G\u001b[K\"pending\"))\r\r\n\u001b[58G\u001b[K.append(_summarize_by_status(records,\r\r\n\u001b[1G\u001b[K\"active\"))\r\r\n\u001b[1G\u001b[K                                           >      results.append(_summarize_by_status(records,\r\r\n\u001b[1G\u001b[K\"expired\"))\r\r\n\u001b[1G\u001b[K                                           >      results.append(_summarize_by_status(records,\r\r\n\u001b[1G\u001b[K\"cancelled\"))\r\r\n\u001b[1G\u001b[K    return results                            ==  return results\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mTest result (real output, run against the refactored messy.py)\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[Ktest_messy.py::test_process_records_matches_expected PASSED              [ 50%]\r\r\n\u001b[1G\u001b[Ktest_messy.py::test_empty_status_has_zero_avg PASSED                     [100%]\r\r\n\u001b[E\u001b[1G\u001b[K============================== 2 passed in 0.01s ===============================\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe same 2 tests passed \u001b[1mbefore\u001b[22m the refactor (against the duplicated version) and \u001b[1mafter\u001b[22m (against the\r\r\n\u001b[1G\u001b[Khelper version) \u2014 identical results, proving behavior is preserved. Files: messy.py (refactored),\r\r\n\u001b[1G\u001b[Ktest_messy.py, and messy_original.py (kept only as the diff reference).\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2