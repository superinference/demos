[49.711247, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ with open(\"data.json\") as f:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     data = json.load(f)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ regions = data[\"regions\"]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ print(f\"Sales Report - {data['company']} - {data['quarter']}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ print(\"=\" * 60)\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ total_units = 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ for r in regions:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     total_revenue += r[\"revenue\"]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     total_units += r[\"units\"]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     print(f\"{r['name']:<16}{'$' + format(r['revenue'], ','):>15}\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+           f\"{format(r['units'], ','):>12}{r['growth'] * 100:>9.1f}%\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+4 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-DQpet7 && python3 report.py\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m-\u001b[39m bash cd /tmp/ami-demo-DQpet7 && python3 report.py \u001b[2m16.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m                  \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m   \u001b[32m\u001b[2m\u2809\u001b[22m\u28a0\u28fa\u28d7\u2844\u001b[39m                         \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m                  \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m    \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m                         \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m                     \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                                   \u001b[35m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
