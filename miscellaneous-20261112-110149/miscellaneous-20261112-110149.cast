[44.631011, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+ import tempfile\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ import unittest\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ from pathlib import Path\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ from signal_garden import (\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     SENSORS,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     Sensor,\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     analyze,\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+     detect_anomalies,\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ class SignalGardenTests(unittest.TestCase):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     def test_generation_is_deterministic_and_isolated(self):\r\r\n"]
[44.631107, "o", "\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         first = generate_telemetry(SENSORS[0], 24, 99)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+         second = generate_telemetry(SENSORS[0], 24, 99)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         self.assertEqual(first, second)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+34 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;136m\u001b[39mSimmering \u001b[2m5.7s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K        \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[93m\u28c4\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2802\u001b[22m\u001b[39m      \u001b[36m\u001b[2m\u2804\u001b[22m\u2879\u282d\u283b\u282d\u288b\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[93m\u280f\u001b[39m\r\r\n\u001b[26G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                                              \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m   \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38