[131.370793, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[131.371086, "o", "\u001b[1;1H\u001b[J4. \u001b[1mChunking\u001b[22m - Each section has one clear job (install, use, troubleshoot, understand value)\r\r\n5. \u001b[1mSignposting\u001b[22m - Clear headings, visual separation, and a \"Next steps\" exit ramp\r\r\n\r\r\nThe README is deliberately \u001b[1mshort and scannable\u001b[22m - readers can find their answer in under 30 seconds,\r\r\nwhether they're installing, using a flag, or debugging an error.\r\r\n\r\r\n\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n- Cognitive load isn't about page length\u2014it's about **search cost**. Tables let readers\r\r\npattern-match (\"I want to monitor continuously \u2192 scan left column \u2192 found it\") instead of reading\r\r\nlinearly.\r\r\n- \"Quick start\" before \"Options\" respects that most readers want to **do something first**, then\r\r\ntune it. Alphabetical or completeness-first ordering creates friction for the 80% case.\r\r\n- Error handling as a table with exit codes gives both humans (clear message) and CI scripts\r\r\n(numeric code) what they need in one place, avoiding the \"where do I look?\" split.\r\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\r\r\n\u001b[2m\u2733 Worked for 1m 58s \u00b7 done 5:30 PM\u001b[22m\r\r\n\r\r\n\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n[2.2m | 45925 tokens | $0.02] Done in 4 turns \u00b7 done 5:30 PM\r\r\nGoodbye.\r\r\n\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCLI Tool README: quickping Ne\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n \u001b[2mTip: diffs expand automatically so you see each change\u001b[22m\r\r\n\r\r\n                                    \u001b[93m\u001b[2m\u2809\u28e0\u28be\u2877\u28c4\u001b[22m\u001b[39m\r\r\n                 \u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m                \u001b[93m\u001b[2m\u2839\u287a\u2897\u280f\u001b[22m\u001b[39m                                 \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n                 \u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                    \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u001b[22m\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[93m\u001b[2m Analyst  \u258c\u001b[22m\u001b[39m\r\r\n \u001b[2mSi:AM\u2026\u001b[22m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[cognitive-doc-design] \u001b[39manthropic-vertex/claude-sonnet-4-5 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
