[46.952131, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[17G\u001b[K \u001b[32m\u2828\u287b\u2866\u2840\u001b[39m               \u001b[36m\u28a0\u28d2\u28ff\u28d2\u2844\u001b[39m       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m  \u001b[33m\u001b[2m\u2802\u001b[22m\u28f4\u28bf\u2866\u28c0\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[39m\u001b[32m\u2805\u001b[39m               \u001b[36m\u2879\u282d\u283b\u282d\u288b\u001b[39m       \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m    \u001b[33m\u2839\u28ba\u2817\u284f\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                  \u001b[33m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[16G\u001b[K\u001b[32m\u001b[2me\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;