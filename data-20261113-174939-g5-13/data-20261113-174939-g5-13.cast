[30.18045, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import statistics\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ from tabulate import tabulate\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ # Monthly revenue data (in thousands)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ revenue = [\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     45.2, 52.1, 48.9, 61.5, 55.3,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     58.7, 62.4, 59.1, 64.8, 72.3,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     68.5, 71.2, 66.9, 58.4, 63.2,\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     69.8, 75.1, 73.6, 67.4, 70.9\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ median_revenue = statistics.median(revenue)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ min_revenue = min(revenue)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ max_revenue = max(revenue)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ # Get top-3 highest months (sorted descending)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ top_3 = sorted(revenue, reverse=True)[:3]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+14 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Percolating \u001b[2m1.2s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m            \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m            \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                   \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m                     \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u0