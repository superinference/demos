[28.266628, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ \"\"\"Refactor a repetitive record formatter without changing its output.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ from __future__ import annotations\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ from typing import Any, Mapping, Sequence\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9+ Record = Mapping[str, Any]\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+     {\"name\": \"Linus\", \"role\": \"Maintainer\", \"team\": \"Tools\", \"active\": False},\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ ]\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ EXPECTED_SAMPLE = \"\"\"Name: Ada\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ Role: Engineer\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+ Team: Core\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ Status: active\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+96 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(All 6 checks passed.) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;13