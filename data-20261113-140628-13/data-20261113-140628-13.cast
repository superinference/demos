[62.04921, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ max_temp = max(temperatures)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ top_3_highest = sorted(temperatures, reverse=True)[:3]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ # Create summary table\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+ summary_data = [\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     [\"Mean\", f\"{mean_temp:.2f}\u00b0F\"],\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+     [\"Median\", f\"{median_temp:.2f}\u00b0F\"],\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+11 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let me run it:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Traceback (most recent call last):) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe tabulate module isn't installed. Let me install it and re-run:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[E\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mpip install tabulate -q && cd /tmp/ami-demo-u9tw2y && pyt...\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash pip install tabulate -q && cd /tmp/ami-demo-u9tw2y && pyt... \u0