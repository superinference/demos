[25.296428, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[25.297265, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m11+ print(summary)\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Mean: 11.62 | Median: 10.50 | Top three: [21, 1...) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated and ran stats_demo.py successfully.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KOutput:\r\r\n\u001b[E\u001b[1G\u001b[KMean: 11.62 | Median: 10.50 | Top three: [21, 19, 15]\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The script uses only Python\u2019s standard-library `statistics` module and an inline dataset.\r\r\n\u001b[1G\u001b[K- Sorting in reverse order makes selecting the three largest values straightforward.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Cooked for 12s \u00b7 done 10:56 AM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n"]
[25.29736, "o", "\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[23s | 17527 tokens | $0.0016] Done in 4 turns \u00b7 done 10:56 AM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[7G\u001b[K\u001b[2m/loop runs a prompt or command on a recurring interval\u001b[22m\r\r\n\u001b[1G\u001b[K                                                        \u001b[93m\u001b[2m\u2880\u2840\u001b[22m\u001b[39m\r\r\n\u001b[16G\u001b[K  \u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m               \u001b[36m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u28f4\u28bb\u28e7\u2840\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[16G\u001b[K  \u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m               \u001b[36m\u001b[2m\u287d\u2839\u280f\u28af\u001b[22m\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[93m\u001b[2m\u2808\u283b\u28a7\u281f\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u001b[22m\u001b[39m \u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                                                            \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K\u001b[32m\u001b[2mg\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;