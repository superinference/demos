[163.401725, "o", "\u001b[29A\u001b[1G\u001b[K\u2502  # \u2502 nested.out                \u2502 refactored.out            \u2502\r\r\n\u001b[1G\u001b[K\u251c\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\r\n\u001b[1G\u001b[K\u2502  1 \u2502 100 Continue              \u2502 100 Continue              \u2502\r\r\n\u001b[4G\u001b[K2 \u2502 200 OK                    \u2502 200 OK                    \u2502\r\r\n\u001b[1G\u001b[K\u2502  3 \u2502 201 Created               \u2502 201 Created               \u2502\r\r\n\u001b[4G\u001b[K4 \u2502 204 No Content            \u2502 204 No Content            \u2502\r\r\n\u001b[4G\u001b[K5 \u2502 301 Moved                 \u2502 301 Moved                 \u2502\r\r\n\u001b[4G\u001b[K6 \u2502 302 Found                 \u2502 302 Found                 \u2502\r\r\n\u001b[4G\u001b[K7 \u2502 304 Not Modified          \u2502 304 Not Modified          \u2502\r\r\n\u001b[4G\u001b[K8 \u2502 400 Bad Request           \u2502 400 Bad Request           \u2502\r\r\n\u001b[4G\u001b[K9 \u2502 404 Not Found             \u2502 404 Not Found             \u2502\r\r\n\u001b[3G\u001b[K10 \u2502 500 Internal Server Error \u2502 500 Internal Server Error \u2502\r\r\n\u001b[3G\u001b[K11 \u2502 503 Service Unavailable   \u2502 503 Service Unavailable   \u2502\r\r\n\u001b[3G\u001b[K12 \u2502 418 Client Error          \u2502 418 Client Error          \u2502\r\r\n\u001b[1G\u001b[K\u2514\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\