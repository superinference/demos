[49.962339, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ # Step 1/3: Python quine - outputs Ruby\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ import codecs\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ s='#!/usr/bin/env ruby\\n# Step 2/3: Ruby quine - outputs Bash\\ns=%q{#!/bin/bash\\n# Step 3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ # Step 3/3: Bash quine - outputs Python\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ cat<<'ENDPYTHON'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ #!/usr/bin/env python3\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ # Step 1/3: Python quine - outputs Ruby\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ import codecs\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+ };\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ require('erb')\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ template=ERB.new(s)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ result=template.result()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ puts result\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ ENDPYTHON\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ };echo \"$s\"}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+4 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500