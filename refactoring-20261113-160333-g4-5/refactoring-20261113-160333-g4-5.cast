[144.608415, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[KDone! All three files created and verified:\r\r\n\u001b[1G\u001b[K\u001b[1mSummary\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[K\u2705 \u001b[1moriginal.py\u001b[22m \u2014 Three temperature functions with \u001b[1mduplicated inline logic\u001b[22m:\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 fahrenheit_to_celsius, celsius_to_fahrenheit, kelvin_to_celsius\r\r\n\u001b[1G\u001b[K\u2022 Each repeats: range validation, error formatting, conversion math, rounding\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2705 \u001b[1mrefactored.py\u001b[22m \u2014 \u001b[1mExtracted shared logic\u001b[22m into _convert() helper:\r\r\n\u001b[E\u001b[1G\u001b[K\u2022 Generic validation + rounding in one place\r\r\n\u001b[1G\u001b[K\u2022 Functions now delegate to _convert() with lambda transformations\r\r\n\u001b[3G\u001b[KCleaner, more maintainable code\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2705 \u001b[1mverify.py\u001b[22m \u2014 \u001b[1mComprehensive verification\u001b[22m:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 Tests 15 valid conversions (all PASS)\r\r\n\u001b[1G\u001b[K\u2022 Tests 3 error cases (all PASS)\r\r\n\u001b[3G\u001b[KProduces readable before/after comparison table\r\r\n\u001b[3G\u001b[KExits with 0 (PASS) when all outputs match, 1 (FAIL) otherwise\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KAll\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file called original\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
