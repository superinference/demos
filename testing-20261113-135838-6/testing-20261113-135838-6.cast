[60.312325, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[60.312418, "o", "\u001b[29A\u001b[E\u001b[13G\u001b[K\u001b[2m\u001b[22mTest suite for calc module.\"\"\"\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m import pytest\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mimport calc\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m class TestAdd:\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m     \"\"\"Tests for add function.\"\"\"\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[E\u001b[10G\u001b[K\u001b[2m\u001b[22m    def test_add_negative_numbers(self):\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    \"\"\"Add two negative integers.\"\"\"\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    assert calc.add(-5, -3) == -8\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m     def test_add_mixed_signs(self):\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m        \"\"\"Add positive and negative number.\"\"\"\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m    assert calc.add(10, -4) == 6\r\r\n\u001b[17G\u001b[K\u001b[2m06 more lines)\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Conjuring \u001b[2m27.3s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m                                \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m        \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m                               \u001b[35m\u001b[2m\u2820\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m        \u001b[93m\u2819\u28be\u2877\u280b\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u001b[39m                                                \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m          \u001b[93m\u001b[2m\u2809\u001b[22m\u0