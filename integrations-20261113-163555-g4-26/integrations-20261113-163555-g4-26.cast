[229.711862, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ <!DOCTYPE html>\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ \u001b[90m<\u001b[34mhtml\u001b[90m lang=\"en\">\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ \u001b[90m<\u001b[34mhead\u001b[90m>\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+     \u001b[90m<\u001b[34mmeta\u001b[90m charset=\"UTF-8\">\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     \u001b[90m<\u001b[34mmeta\u001b[90m name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     \u001b[90m<\u001b[34mtitle\u001b[90m>\u001b[39mGet Started\u001b[90m</\u001b[34mtitle\u001b[90m>\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+     \u001b[90m<\u001b[34mstyle\u001b[90m>\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+         * {\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+             margin: 0;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 5 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+             min-height: 100vh;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+             display: flex;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+             align-items: center;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+             justify-content: center;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+             background: #f5f5f7;\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+             font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, U\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+54 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  22  [Auto-formatted]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Marinating \u001b[2m5.1s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mActivate your impeccable skil\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[39m                    \u001b[36m\u2890\u2842\u001b[39m  \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m      \u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m                    \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[93m\u001b[2m\u001b[22m\u001b[39m                    \u001b[36m\u284d\u28a9\u001b[39m         \u001b[92m\u2894\u281d\u282b\u2862\u001b[39m \u001b[92m\u001b[2m\u2804\u001b[22m\u001b[39m                  \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[E\u001b[8G\u001b[K\u001b[35m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216