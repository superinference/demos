[12.892084, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[K\u001b[38;5;167m-\u001b[39m Crystallizing \u001b[2m1.8s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[20G\u001b[K\u001b[32m\u001b[2m\u001b[22m\u28d7\u2841\u001b[39m  \u001b[37m\u2880\u28d4\u2841\u001b[39m           \u001b[36m\u28ce\u28b3\u001b[39m \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[37m\u2846\u28b1\u001b[39m            \u001b[33m\u288e\u28b3\u2880\u001b[39m  \u001b[37m\u2846\u28b1\u001b[39m            \u001b[35m\u2880\u28d7\u2841\u001b[39m  \u001b[37m\u2880\u28d4\u2841\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u2828\u280a\u2842\u001b[39m   \u001b[37m\u2808\u001b[39m            \u001b[36m\u28bc\u2827\u2803\u001b[39m  \u001b[37m\u289c\u2864\u001b[39m           \u001b[33m\u001b[2m\u2820\u001b[22m\u28be\u2867\u2803\u001b[39m  \u001b[37m\u289c\u2864\u001b[39m            \u001b[35m\u282a\u288a\u2843\u001b[2m\u2824\u001b[22m\u001b[39m  \u001b[37m\u2808\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u001b[2m\u2824\u001b[22m\u001b[39m                                                        \u001b[35m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001