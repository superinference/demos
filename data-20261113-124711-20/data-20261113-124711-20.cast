[66.146004, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[66.146372, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m 2  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m49  \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m50  def print_table(stats_list: List[Tuple[str, float, float, List[int]]]) -> None:\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m51      \"\"\"Print a formatted table of drink statistics.\"\"\"\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m52-     print(\"\\n\" + \"=\" * 80)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m53-     print(f\"{'Rank':<5} {'Drink':<15} {'Mean':<10} {'Median':<10} {'7-Day Trend':<20}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m54-     print(\"=\" * 80)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m55-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m56-     for rank, (drink, mean, median, sales) in enumerate(stats_list, 1):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m57-         marker = \"\u2605\" if rank <= 3 else \" \"\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 9 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m57+         marker = \"\u2605\" if rank <= 3 else \" \"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m58+         spark = sparkline(sales)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m59+         print(f\"{marker:<3} {rank:<5} {drink:<15} {mean:<10.2f} {median:<10.1f} {spark}\")\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m60+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m61+     print(\"=\" * 90 + \"\\n\")\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  62  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  63  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  64  if __name__ == \"__main__\":\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+10\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-10\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Tinkering \u001b[2m0.3s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python script stats.\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m         \u001b[36m\u2890\u2842\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m          \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m        \u001b[36m\u001b[2m\u2820\u001b[22m\u2869\u288d\u001b[39m            \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m       \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[19G\u001b[K       \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m       \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u0