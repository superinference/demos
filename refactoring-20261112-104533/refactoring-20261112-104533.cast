[25.526903, "o", "\u001b[29A\u001b[9G\u001b[K\u001b[2m\u001b[22m RULES = {\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m     \"apple\": \"fruit\",\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22m    \"pear\": \"fruit\",\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m\"carrot\": \"vegetable\",\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m\"broccoli\": \"vegetable\",\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22m\"salmon\": \"fish\",\r\r\n\u001b[E\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mdef classify(value):\r\r\n\u001b[14G\u001b[K\u001b[2m\u001b[22mreturn RULES.get(value, \"unknown\")\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[9G\u001b[K\u001b[2m\u001b[22m\r\r\n\u001b[10G\u001b[K\u001b[2m\u001b[22mif __name__ == \"__main__\":\r\r\n\u001b[16G\u001b[K\u001b[2m2 more lines)\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[47G\u001b[K\u001b[2m, /tmp/ami-demo-FP4nl5/compare_outputs.py]\u001b[22m\r\r\n\u001b[E\u001b[17G\u001b[K\u001b[38;5;167m\u001b[39m\u001b[1m\u001b[38;5;167m\u001b[39m\u001b[22m\u001b[2m\u001b[22m\u001b[38;5;243mcompare_outputs.py\u001b[39m\r\r\n\u001b[13G\u001b[K\u001b[38;5;167m\u001b[39mcompare_outputs.py \u001b[2m8.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
