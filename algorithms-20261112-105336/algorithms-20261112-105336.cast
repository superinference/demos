[24.985047, "o", "\u001b[29A\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan bash(Expression Result) 0.1s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KCreated arithmetic_demo.py in the current directory. It includes:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 Tokenizer for integers and operators\r\r\n\u001b[1G\u001b[K\u2022 Recursive-descent parser with precedence and parentheses\r\r\n\u001b[1G\u001b[K\u2022 Unary minus support\r\r\n\u001b[1G\u001b[K\u2022 Integer evaluator with division-by-zero handling\r\r\n\u001b[1G\u001b[K\u2022 Sample expressions and a concise results table\r\r\n\u001b[1G\u001b[KExecuted output:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KExpression                         Result\r\r\n\u001b[1G\u001b[K------------------------------------------\r\r\n\u001b[1G\u001b[K1 + 2 * 3                            7\r\r\n\u001b[1G\u001b[K(10 - 4) / 2                         3\r\r\n\u001b[1G\u001b[K-3 * (2 + 5)                         -21\r\r\n\u001b[1G\u001b[K18 / -4 + 7                          3\r\r\n\u001b[1G\u001b[K2 * (3 + 4 * (5 - 1))                38\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250