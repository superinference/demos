[79.96893, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import random\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ # Set fixed seed for reproducibility\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ random.seed(42)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ # Token types\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ class TokenType:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     NUMBER = 'NUMBER'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     DICE = 'DICE'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     RPAREN = 'RPAREN'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     EOF = 'EOF'\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ class Token:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     def __init__(self, type, value):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+         self.type = type\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+         self.value = value\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+195 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Crystallizing \