[88.49537, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[88.495438, "o", "\u001b[29A\u001b[1G\u001b[Kabsolute error of ~0.0006.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mHow the method works:\u001b[22m The expected number of uniform [0,1) draws needed for the cumulative sum to\r\r\n\u001b[1G\u001b[Kfirst exceed 1 is exactly \u001b[3me\u001b[23m. Formally, if N is that count, then P(N > n) = P(sum of n draws \u2264 1) =\r\r\n\u001b[1G\u001b[K1/n! (the volume of the simplex), so E[N] = \u03a3 P(N > n) = \u03a3 1/n! = e. Averaging N over many trials is\r\r\n\u001b[1G\u001b[Kan unbiased estimator of e.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- The error of a Monte Carlo estimate shrinks like 1/\u221a(trials), so cutting error by 10\u00d7 needs ~100\u00d7\r\r\n\u001b[1G\u001b[Kmore trials \u2014 that's why we land at ~3 digits with 5M trials, not more.\r\r\n\u001b[1G\u001b[K- `s <= 1.0` (not `<`) is the correct boundary: we keep drawing *until* the sum strictly exceeds 1,\r\r\n\u001b[1G\u001b[Kso the draw that crosses the threshold is counted.\r\r\n\u001b[3G\u001b[KA clean closed form backs the simulation: E[N] = \u03a3 1/n!, which is the series definition of e \u2014 the\r\r\n\u001b[1G\u001b[K experiment is essentially sampling that series.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Brewed for 1m 15s \u00b7 done 1:48 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n\u001b[1G\u001b[K[1.5m | 30944 tokens | $0.02] Done in 3 turns \u00b7 done 1:48 PM\r\r\n\u001b[1G\u001b[KGoodbye.\r\r\n\u001b[E\u001b[E\u001b[8G\u001b[K\u001b[2mprovision spins up a remote GPU pod to run on\u001b[22m\r\r\n\u001b[57G\u001b[K\u001b[93m\u001b[2m\u2880\u2840\u001b[22m\u001b[39m\r\r\n"]
[88.49546, "o", "\u001b[18G\u001b[K                    \u001b[36m\u001b[2m\u2890\u2842\u001b[22m\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m              \u001b[93m\u001b[2m\u28f4\u28bb\u28e7\u2840\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2869\u288d\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u2812\u2808\u283b\u28a7\u281f\u001b[22m\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m             \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u2808\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[36m\u001b[2m Explorer  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinfe"]
[88.495494, "o", "rence.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l"]
[88.495552, "o", "\u001b]2;\u2b22 AMI \u00b7 Monte Carlo Estimation of Euler's Number\u0007"]
[88.594635, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[88.595114, "o", "\u001b[1;1H\u001b[Jabsolute error of ~0.0006.\r\r\n\r\r\n\u001b[1mHow the method works:\u001b[22m The expected number of uniform [0,1) draws needed for the cumulative sum to\r\r\nfirst exceed 1 is exactly \u001b[3me\u001b[23m. Formally, if N is that count, then P(N > n) = P(sum of n draws \u2264 1) =\r\r\n1/n! (the volume of the simplex), so E[N] = \u03a3 P(N > n) = \u03a3 1/n! = e. Averaging N over many trials is\r\r\nan unbiased estimator of e.\r\r\n\r\r\n\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n- The error of a Monte Carlo estimate shrinks like 1/\u221a(trials), so cutting error by 10\u00d7 needs ~100\u00d7\r\r\nmore trials \u2014 that's why we land at ~3 digits with 5M trials, not more.\r\r\n- `s <= 1.0` (not `<`) is the correct boundary: we keep drawing *until* the sum strictly exceeds 1,\r\r\nso the draw that crosses the threshold is counted.\r\r\n- A clean closed form backs the simulation: E[N] = \u03a3 1/n!, which is the series definition of e \u2014 the\r\r\n experiment is essentially sampling that series.\r\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\r\r\n\u001b[2m\u2733 Brewed for 1m 15s \u00b7 done 1:48 PM\u001b[22m\r\r\n\r\r\n\u001b[48;5;235m\u001b[38;5;255m > /quit \u001b[39m\u001b[49m\r\r\n[1.5m | 30944 tokens | $0.02] Done in 3 turns \u00b7 done 1:48 PM\r\r\nGoodbye.\r\r\n\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mMonte Carlo Estimation of Eul\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n \u001b[2mTip: /provision spins up a remote GPU pod to run on\u001b[22m\r\r\n                                                        \u001b[93m\u001b[2m\u2880\u2840\u001b[22m\u001b[39m\r\r\n                                     \u001b[36m\u001b[2m\u2890\u2842\u001b[22m\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m              \u001b[93m\u001b[2m\u28f4\u28bb\u28e7\u2840\u001b[22m\u001b[39m               \u001b[35m\u001b[2m\u282a\u2810\u2805\u2807\u001b[22m\u001b[39m \u001b[37m\u282a\u2810\u2805\u2807\u001b[39m\r\r\n                 \u001b[32m\u001b[2m\u28a0\u28fa\u28d7\u2844\u001b[22m\u001b[39m \u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m              \u001b[36m\u001b[2m\u2869\u288d\u001b[22m\u001b[39m               \u001b[93m\u001b[2m\u2812\u2808\u283b\u28a7\u281f\u001b[22m\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m             \u001b[35m\u001b[2m\u282a\u282d\u282d\u2815\u2808\u001b[22m\u001b[37m\u282a\u282d\u282d\u2815\u001b[39m\r\r\n                 \u001b[32m\u001b[2m\u2894\u281d\u282b\u2862\u001b[22m\u001b[39m                    \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[36m\u001b[2m Explorer  \u258c\u001b[22m\u001b[39m\r\r\n \u001b[2mSi:AMI \u00b7 Ctrl+D exit\u001b[22m               \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  8% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
