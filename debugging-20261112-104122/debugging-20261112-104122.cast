[25.178491, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def buggy_is_adult(age):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     \"\"\"Intentional bug: compares an integer threshold to a string age.\"\"\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+     return age >= \"18\"\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ def is_adult(age):\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+         normalized_age = int(age)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+     except (TypeError, ValueError) as exc:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+         raise TypeError(\"age must be an integer or numeric string\") from exc\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     return normalized_age >= 18\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ def main():\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+41 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan file_read(File unchanged since last read: /tmp/ami-demo-Z...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[2