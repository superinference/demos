[117.219659, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[23G\u001b[K \u001b[35m\u28a3\u2887\u285e\u288f\u001b[39m        \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m              \u001b[93m\u28d0\u28fa\u2820\u28c6\u001b[39m        \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[23G\u001b[K \u001b[35m\u289f\u2876\u289f\u2890\u001b[39m        \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m              \u001b[93m\u28bb\u285b\u28d5\u284f\u001b[39m \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m      \u001b[32m\u2890\u281d\u282b\u2842\u001b[39m\r\r\n\u001b[26G\u001b[K\u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m                              \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m             \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u