[81.293722, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+ Filter log files by date range and severity level.\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+ ## Quick Start\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ ```bash\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ # Show only errors from the last hour\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ logslice --since 1h --severity error app.log\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 5 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ ## Install\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+ ```bash\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ # From source\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ git clone https://github.com/yourorg/logslice\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ cd logslice\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+55 more lines)\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m22  [Auto-formatted]\u001b[22m\r\r\n"]
[81.293778, "o", "\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[2m\u2234 Thinking #3\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan file_read([type: text, 76 lines, 2514 chars]) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Cooking \u001b[2m17.7s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u001b[93m\u28e0\u28be\u2877\u28c4\u001b[36m\u28e2\u2844\u001b[39m         \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[17G\u001b[K        \u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[36m\u287d\u001b[93m\u2819\u28be\u2877\u280b\u001b[36m\u2839\u28af\u001b[39m         \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[25G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[10G\u001b[K\u001b[32m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2