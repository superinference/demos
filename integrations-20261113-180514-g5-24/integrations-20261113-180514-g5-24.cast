[149.33514, "o", "\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KI've loaded the audit playbook and craft floor. This is a scoped refinement of existing code, so\r\r\n\u001b[1G\u001b[KI'll proceed on the incumbent implementation. Here's the audit of the unstyled button:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mAudit \u2014 index.html <button>Click me</button>\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u250c\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\r\n\u001b[1G\u001b[K\u2502 # \u2502 Dimension       \u2502 Score \u2502 Key Finding                                                        \u2502\r\r\n\u001b[1G\u001b[K\u251c\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\r\n\u001b[1G\u001b[K\u2502 1 \u2502 Accessibility   \u2502 1/4   \u2502 Relies entirely on UA default focus ring; no authored focus-visibl \u2502\r\r\n\u001b[1G\u001b[K\u2502   \u2502                 \u2502       \u2502 e, no label beyond text                                            \u2502\r\r\n\u001b[3G\u001b[K2 \u2502 Performance     \u2502 4/4   \u2502 Nothing to optimize                                                \u2502\r\r\n\u001b[1G\u001b[K\u2502 3 \u2502 Theming         \u2502 0/4   \u2502 Zero tokens; pure browser defaults                                 \u2502\r\r\n\u001b[3G\u001b[K4 \u2502 Responsive      \u2502 2/4   \u2502 Default button height may fall under 24\u00d724px floor on some UAs     \u2502\r\r\n\u001b[3G\u001b[K5 \u2502 Impl. Integrity \u2502 1/4   \u2502 No product-specific system; interchangeable with any page          \u2502\r\r\n\u001b[1G\u001b[K\u2514\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mFindings to fix (per request):\u001b[22m no authored \u001b[1mfocus style\u001b[22m, no controlled \u001b[1mcolor contrast\u001b[22m, no \u001b[1mpadding\u001b[22m, no\r\r\n"]
[149.335168, "o", "\u001b[1G\u001b[K\u001b[1mborder-radius\u001b[22m, no \u001b[1maria-label\u001b[22m. The browser default button typically clears 4.5:1 contrast, but it's\r\r\n\u001b[1G\u001b[Knot \u001b[3mowned\u001b[23m \u2014 it changes per OS/UA, so we pin it.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow applying the guidance.\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a file index.html cont\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\