[110.63989, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[23G\u001b[K\u001b[35m\u2880\u287a\u2817\u2851\u001b[39m         \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m             \u001b[93m\u2880\u28b6\u287f\u28c6\u001b[39m             \u001b[32m\u28a0\u28f8\u28df\u2844\u001b[39m\r\r\n\u001b[23G\u001b[K\u001b[35m\u284b\u2819\u288a\u28e9\u001b[2m\u2836\u001b[22m\u001b[39m       \u001b[36m\u001b[2m\u2802\u001b[22m\u287d\u280f\u2839\u283f\u280f\u2839\u28af\u001b[39m            \u001b[93m\u001b[2m\u2809\u001b[22m\u2809\u289e\u2877\u284b\u001b[39m             \u001b[32m\u2810\u28cd\u286b\u2862\u001b[39m \u001b[32m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[24G\u001b[K\u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m                                                  \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[23G\u001b[K\u001b[32m\u001b[2m \u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;