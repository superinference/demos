[18.929108, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"Compare serial and threaded execution of deterministic, sleep-bound tasks.\"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ from concurrent.futures import ThreadPoolExecutor\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ from time import perf_counter, sleep\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ TASK_COUNT = 12\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+ SLEEP_SECONDS = 0.05\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     return task_id, checksum\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ def main() -> None:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     start = perf_counter()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     serial_results = [task(task_id) for task_id in range(TASK_COUNT)]\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     serial_seconds = perf_counter() - start\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+18 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m/\u001b[39m Marinating \u001b[2m3.9s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[41G\u001b[K\u001b[36m\u001b[32m\u28d7\u2844\u001b[2m\u2802\u001b[22m\u001b[39m          \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                 \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[37G\u001b[K\u001b[36m\u001b[2m\u2804\u001b[22m\u2879\u283b\u288b\u001b[32m\u282b\u2862\u001b[39m           \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[41G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m            \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                      \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n"]
