[218.257998, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[1G\u001b[K  \u25e6 Multiple consecutive spaces/special chars (3 tests)\r\r\n\u001b[1G\u001b[K  \u25e6 Leading/trailing special characters (5 tests)\r\r\n\u001b[5G\u001b[KEdge cases: empty, whitespace, single chars (8 tests)\r\r\n\u001b[6G\u001b[Kppercase and mixed case (2 tests)\r\r\n\u001b[5G\u001b[KNumbers (3 tests)\r\r\n\u001b[5G\u001b[KReal-world examples (4 tests)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K2. \u001b[1mEdge Cases Suite (6 tests)\u001b[22m \u2014 TestSlugifyEdgeCases\r\r\n\u001b[5G\u001b[KConsecutive hyphens collapsing\r\r\n\u001b[5G\u001b[KSpecial character replacement\r\r\n\u001b[5G\u001b[KAlphanumeric and hyphen preservation\r\r\n\u001b[5G\u001b[KNon-ASCII character handling\r\r\n\u001b[1G\u001b[K  \u25e6 Empty-after-processing cases\r\r\n\u001b[1G\u001b[K  \u25e6 Whitespace handling (tabs, newlines, carriage returns)\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K3. \u001b[1mType/Boundary Suite (2 tests)\u001b[22m \u2014 TestSlugifyTypes\r\r\n\u001b[5G\u001b[KSingle character handling\r\r\n\u001b[5G\u001b[KSpecial character only inputs\r\r\n\u001b[5G\u001b[KHyphen-only inputs\r\r\n\u001b[1G\u001b[K\u001b[1m\u001b[3mKey Behaviors Verified:\u001b[23m\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K- \u2713\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u250