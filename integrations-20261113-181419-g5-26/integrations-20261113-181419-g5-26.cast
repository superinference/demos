[68.693552, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[6G\u001b[K \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                          \u001b[36m\u28e0\u28b8\u28d3\u2804\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[93m\u2860\u28ba\u2877\u28c4\u001b[39m                         \u001b[32m\u2822\u2883\u2893\u284f\u001b[39m\r\r\n\u001b[6G\u001b[K \u001b[35m\u28b9\u287f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2837\u001b[22m\u001b[39m                       \u001b[36m\u001b[2m\u2804\u001b[22m\u282e\u2839\u284c\u28ee\u001b[39m               \u001b[93m\u2819\u28fe\u2877\u280b\u001b[39m                         \u001b[32m\u2830\u28a8\u2826\u2822\u001b[39m \u001b[32m\u001b[2m\u2836\u001b[22m\u001b[39m\r\r\n\u001b[8G\u001b[K\u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m                                                    \u001b[93m\u001b[2m\u2809\u001b[22m\u001b[39m                        \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m\r\r\n\u001b[15G\u001b[K\u001b[32m\u001b[2m \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u25