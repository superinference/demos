[133.775799, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m4-     Args:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5-         s: String in format 'start-end' (e.g., '1-5')\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-     Returns:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8-         Tuple of (start, end) as integers\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 56 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+         raise ValueError(f\"Invalid range format: {s}\")\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     try:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+         start = int(start_str)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+         end = int(end_str)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+         return (start, end)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     except ValueError:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m58+         raise ValueError(f\"Invalid range format: {s}\")\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+55\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-15\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow rerun the tests:\r\r\n\u001b[E\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(============================= test session star...) 0.2s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Marinating \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[37G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m     \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m                       \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[23G\u001b[K\u001b[32m\u001b[39m\u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m             \u001b[36m\u2879\u281d\u282f\u288b\u001b[39m       \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                       \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[39G\u001b[K\u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m            \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m                     \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m     \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n\u001b[89G\u001b[K\u001b[38;5;248m\u001b[39m\u001b[33m\u001b[36m\u001b[2m\u001b[39m2% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b