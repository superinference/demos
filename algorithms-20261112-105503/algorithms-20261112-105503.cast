[17.115129, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ import random\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ SAMPLE_COUNT = 1_000_000\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ def estimate_pi(sample_count: int) -> float:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     points_inside = 0\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     for _ in range(sample_count):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     return 4.0 * points_inside / sample_count\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+ def main() -> None:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     estimate = estimate_pi(SAMPLE_COUNT)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     absolute_error = abs(estimate - 3.141592653589793)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     print(f\"Monte Carlo \u03c0 estimate using {SAMPLE_COUNT:,} samples\")\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+6 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m-\u001b[39m Percolating \u001b[2m3.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m             \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[56G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u001b[39m             \u001b[93m\u2819\u28be\u2877\u280b\u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[59G\u001b[K\u001b[36m\u001b[2m\u001b[22m\u001b[39m             \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[32m\u001b[2m Mentor  \u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
