[74.374462, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m3-\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4-     # pending block\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5-     pending = [r for r in records if r[\"status\"] == \"pending\"]\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6-     count = len(pending)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7-     total_value = sum(r[\"value\"] for r in pending)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8-     avg_value = total_value / count if count else 0\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-     results.append({\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m0-         \"status\": \"pending\",\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 23 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+ def process_records(records):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+     results = []\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     results.append(_summarize_by_status(records, \"pending\"))\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502  \u001b[22m18+     results.append(_summarize_by_status(records, \"active\"))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     results.append(_summarize_by_status(records, \"expired\"))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     results.append(_summarize_by_status(records, \"cancelled\"))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m21+     return results\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25