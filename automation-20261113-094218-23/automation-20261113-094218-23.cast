[133.371143, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[20G\u001b[K\u001b[32m\u28d3\u2840\u001b[39m  \u001b[37m\u2804\u001b[39m \u001b[37m\u280a\u001b[39m          \u001b[36m\u28a0\u28fa\u28d7\u2844\u001b[39m \u001b[36m\u001b[2m\u2802\u001b[22m\u001b[39m              \u001b[33m\u2840\u289e\u28f3\u28c0\u001b[39m  \u001b[37m\u2844\u2801\u001b[39m           \u001b[35m\u289e\u28d3\u2840\u001b[39m  \u001b[37m\u2804\u001b[39m \u001b[37m\u280a\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u281d\u282a\u2862\u001b[39m \u001b[32m\u001b[2m\u2837\u001b[22m\u001b[39m \u001b[37m\u2808\u2802\u001b[39m          \u001b[36m\u2879\u281d\u282f\u288b\u001b[39m                \u001b[33m\u2819\u28be\u2867\u2803\u001b[39m  \u001b[37m\u2810\u2804\u001b[39m          \u001b[35m\u2819\u285f\u28aa\u2843\u001b[39m   \u001b[37m\u2808\u2802\u001b[39m\r\r\n\u001b[18G\u001b[K                     \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                     \u001b[33m\u001b[2m\u2802\u001b[22m\u001b[39m            \u001b[35m\u001b[2m\u2836\u001b[22m\u001b[39m     \u001b[35m\u001b[2m\u283e\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u0