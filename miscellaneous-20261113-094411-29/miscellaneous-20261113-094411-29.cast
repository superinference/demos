[202.071428, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ #!/bin/bash\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ set -e\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5+ cd \"$SCRIPT_DIR\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7+ # Color codes\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ GREEN='\\033[0;32m'\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+ RED='\\033[0;31m'\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+ END='\\033[48;5;226m  \\033[0m'\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+ echo \"=== Polyglot Maze Project ===\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+ echo \"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m18+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m19+ # Step 1: Generate maze with Python\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+ echo \"Step 1: Generating 25x25 maze...\"\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+76 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Conjuring \u001b[2m4.5s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a self-contained polyg\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m   \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m                               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[2m\u2820\u001b[22m\u001b[39m      \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m   \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m                               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[18G\u001b[K \u001b[92m\u001b[2m\u2802\u001b[22m\u001b[39m                  \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                  \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m\r\r\n\u001b[12G\u001b[K\u001b[36m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001