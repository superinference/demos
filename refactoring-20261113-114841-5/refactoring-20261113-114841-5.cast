[40.837377, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+ Recipe scoring system with nutritional analysis.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ Original monolithic version - 120+ lines with extensive code duplication.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ def score_recipes(recipes):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     \"\"\"\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+     Score recipes based on nutritional density and ingredient validation.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+     - ingredients: list of str (e.g., '2 cups flour', '150g butter')\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     - protein_g: float\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     - fat_g: float\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     - carbs_g: float\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     - fiber_g: float\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     Returns list of dicts with original recipe data plus score and summary.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+182 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m12.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[38G\u001b[K\u001b[32m\u001b[39m\u001b[36m\u28ff\u28ff\u28e2\u2844\u001b[39m            \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m               \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[29G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m      \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m           \u001b[93m\u001b[2m\u2812\u001b[22m\u2819\u28be\u2877\u280b\u001b[39m               \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[26G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m            \u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m                                 \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[2m \u001b[22m\r\r\n"]
