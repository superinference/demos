[83.890489, "o", "\u001b[29A\u001b[7G\u001b[K\u001b[2m\u001b[22m8+     def test_hours(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         assert parse_duration('3h') == 3 * 3600\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 4 more changes ...\u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m14+     def test_seconds(self):\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m15+         assert parse_duration('120s') == 120\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m16+\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m17+     def test_single_unit(self):\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         assert parse_duration('1h') == 3600\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+         assert parse_duration('1m') == 60\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m20+         assert parse_duration('1s') == 1\r\r\n\u001b[6G\u001b[K\u001b[2m21  ... (+86 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow run the tests to expose the bugs:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(Passed 0. Showing failing output only.) 0.2s\u001b[22m\r\r\n\u001b[E\u001b[1G\u001b[KPerfect! The bugs are exposed. Now I'll fix the parse_duration function:\r\r\n\u001b[E\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;35m\u25cf \u001b[39m\u001b[2mRan file_read(File unchanged since last read: /tmp/ami-demo-e...) 0.0s\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m|\u001b[39m Simmering \u001b[2m0.0s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m                                 \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m             \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u2879\u282f\u281b\u283f\u281d\u288b\u001b[39m                                \u001b[35m\u001b[2m\u2804\u001b[22m\u28b9\u285f\u28bb\u284f\u001b[39m             \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n"]
