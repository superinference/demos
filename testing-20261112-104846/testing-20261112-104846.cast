[32.778463, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1+ from text_tools import normalize_and_count\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+ def test_normal_input():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+     assert normalize_and_count(\"hello world\") == (\"hello world\", 2)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+ def test_extra_whitespace():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+     assert normalize_and_count(\"  hello\\tworld\\nagain  \") == (\"hello world again\", 3)\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m1+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m2+ def test_empty_input():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m3+     assert normalize_and_count(\"\") == (\"\", 0)\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m4+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m5+\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m6+ def test_punctuation():\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7+     assert normalize_and_count(\"Hello, world!\") == (\"Hello, world!\", 2)\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;208m\u25b6 \u001b[39m \u001b[38;5;203m\u2717 \u001b[39m\u001b[2mRan bash(bash: line 1: pytest: command not found) 0.1s\u001b[22m\r\r\n\u001b[15G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[38;5;203m\u001b[39m\u001b[2m/usr/bin/python: No module named pytest) 0.0s\u001b[22m\r\r\n\u001b[4G\u001b[K\u001b[38;5;208m\u001b[39m\u001b[2m\u2234 Thinking #4\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;136m\u001b[39mRunning python -c 'import test_text_tools as t; \u00b7 318 chars \u001b[2m5.1s\u001b[22m\r\r\n\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
