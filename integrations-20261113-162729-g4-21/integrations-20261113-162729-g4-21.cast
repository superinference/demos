[129.260443, "o", "\u001b[29A\u001b[1G\u001b[K2. \u001b[1mProgressive disclosure\u001b[22m - Quick start \u2192 Common tasks \u2192 Options \u2192 Details, so readers can stop when\r\r\n\u001b[1G\u001b[K they have what they need\r\r\n\u001b[1G\u001b[K3. \u001b[1mRecognition over recall\u001b[22m - Tables for common tasks and error handling instead of paragraphs to\r\r\n\u001b[1G\u001b[Kmemorize\r\r\n\u001b[1G\u001b[K4. \u001b[1mChunking\u001b[22m - Each section has one clear job (install, use, troubleshoot, understand value)\r\r\n\u001b[1G\u001b[K5. \u001b[1mSignposting\u001b[22m - Clear headings, visual separation, and a \"Next steps\" exit ramp\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe README is deliberately \u001b[1mshort and scannable\u001b[22m - readers can find their answer in under 30 seconds,\r\r\n\u001b[1G\u001b[Kwhether they're installing, using a flag, or debugging an error.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- Cognitive load isn't about page length\u2014it's about **search cost**. Tables let readers\r\r\n\u001b[1G\u001b[Kpattern-match (\"I want to monitor continuously \u2192 scan left column \u2192 found it\") instead of reading\r\r\n\u001b[1G\u001b[Klinearly.\r\r\n\u001b[1G\u001b[K- \"Quick start\" before \"Options\" respects that most readers want to **do something first**, then\r\r\n\u001b[1G\u001b[Ktune it. Alphabetical or completeness-first ordering creates friction for the 80% case.\r\r\n\u001b[1G\u001b[K- Error handling as a table with exit codes gives both humans (clear message) and CI scripts\r\r\n\u001b[1G\u001b[K(numeric code) what they need in one place, avoiding the \"where do I look?\" split.\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Worked for 1m 58s \u00b7 done 5:30 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCLI Tool README: quickping Ne\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                              Type / for commands\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: click a \u25b6 row, or press Ctrl+T, to expand every component\u001b[22m\r\r\n\u001b[19G\u001b[K                                      \u001b[93m\u2880\u28e0\u2840\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m              \u001b[36m\u28a0\u28d4\u28ff\u28ff\u28e2\u2844\u001b[39m              \u001b[93m\u28f4\u28bb\u28e7\u281f\u001b[2m\u2812\u001b[22m\u001b[39m              \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2894\u281d\u282b\u2862\u001b[2m\u2808\u001b[22m\u001b[39m             \u001b[36m\u287d\u280f\u283f\u283f\u2839\u28af\u001b[39m              \u001b[93m\u2808\u283b\u2807\u001b[39m                \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K                     \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m                                    \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AM\u2026\u001b[22m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[cognitive-doc-design] \u001b[39manthropic-vertex/claude-sonnet-4-5 \u00b7  9% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38"]
[131.260443, "o", ";5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[38G\u001b[K\u001b[36m\u2880\u2860\u2840\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u28ba\u28d7\u2844\u001b[39m \u001b[37m\u280a\u2810\u2801\u2801\u001b[39m \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m     \u001b[36m\u28f0\u28fd\u285f\u28d7\u001b[39m                                  \u001b[35m\u28a0\u28ba\u28d7\u2844\u001b[39m \u001b[37m\u280a\u2810\u2801\u2801\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[32m\u2814\u283d\u282b\u2873\u001b[2m\u2808\u001b[22m\u001b[39m     \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m     \u001b[36m\u281e\u2818\u2803\u2808\u001b[39m                                  \u001b[35m\u2839\u287f\u28bb\u285f\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[19G\u001b[K\u001b[32m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[?2026l\u001b]2;\u2819 AMI \u00b7 CLI Tool README: quickping Network Latency Checker\u0007\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38