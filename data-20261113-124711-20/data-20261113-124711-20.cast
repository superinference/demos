[136.129284, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8"]
[136.129828, "o", "\u001b[29A\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K1. \u001b[1mLatte\u001b[22m (\u2605) \u2014 Mean: 61.43, Median: 61.0 \u2014 the clear winner with most consistent high volume\r\r\n\u001b[1G\u001b[K2. \u001b[1mEspresso\u001b[22m (\u2605) \u2014 Mean: 41.00, Median: 41.0 \u2014 solid second place with steady demand\r\r\n\u001b[1G\u001b[K3. \u001b[1mCappuccino\u001b[22m (\u2605) \u2014 Mean: 35.00, Median: 35.0 \u2014 rounds out the top 3\r\r\n\u001b[1G\u001b[K4. \u001b[1mMatcha\u001b[22m \u2014 Mean: 29.14, Median: 29.0\r\r\n\u001b[1G\u001b[K5. \u001b[1mChai\u001b[22m \u2014 Mean: 20.00, Median: 20.0\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KThe sparkline visualization shows 7-day trends using Unicode block characters (\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588) where the\r\r\n\u001b[1G\u001b[Kheight represents relative daily sales. All three top drinks are marked with \u2605 for quick visual\r\r\n\u001b[1G\u001b[Kidentification.\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2605 Insight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K- Sparklines encode min/max normalized to 8 Unicode characters to show trends in minimal space\r\r\n\u001b[1G\u001b[Kwithout consuming extra columns\r\r\n\u001b[1G\u001b[K- Sorting by mean (not median) captures overall volume preference; median would show consistency,\r\r\n\u001b[1G\u001b[Kbut mean is more intuitive for caf\u00e9 revenue ranking\r\r\n\u001b[1G\u001b[K- Using `statistics` module keeps it simple; for larger datasets, NumPy would offer better\r\r\n\u001b[1G\u001b[Kperformance\r\r\n\u001b[1G\u001b[K\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[2m\u2733 Brewed for 2m 5s \u00b7 done 1:49 PM\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCaf\u00e9 Daily Drink Sales Analys\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n\u001b[1G\u001b[K \u001b[2mTip: send a running session to the background with /background\u001b[22m\r\r\n\u001b[19G\u001b[K                   \u001b[36m\u2880\u2840\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2820\u001b[22m\u001b[39m              \u001b[36m\u28f0\u28fd\u28ef\u28c6\u001b[39m                 \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m\r\r\n\u001b[18G\u001b[K\u001b[92m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[36m\u281e\u2818\u2803\u2833\u001b[39m                 \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m           \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[45G\u001b[K                                \u001b[35m\u001b[2m\u2810\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[2mSi:AMI \u00b7 /help \u00b7 Ctrl+D exit\u001b[22m     \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-haiku-4-5 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b["]
