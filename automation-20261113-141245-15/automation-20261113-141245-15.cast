[66.298762, "o", " \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8Could not find the language 'csv', did you forget to load/include a language module?\r\r\n\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[2m  \u2502  \u001b[22m 1+ #!/usr/bin/env python3\r\r\n\u001b[2m  \u2502  \u001b[22m 2+ \"\"\"\r\r\n\u001b[2m  \u2502  \u001b[22m 3+ CSV Statistics Tool - Calculates and displays statistics for numeric columns in a CSV fil\r\r\n\u001b[2m  \u2502  \u001b[22m 4+ Usage: python csvstats.py <filename.csv>\r\r\n\u001b[2m  \u2502  \u001b[22m 5+ \"\"\"\r\r\n\u001b[2m  \u2502  \u001b[22m 6+\r\r\n\u001b[2m  \u2502  \u001b[22m 7+ import csv\r\r\n\u001b[2m  \u2502  \u001b[22m 8+ import sys\r\r\n\u001b[2m  \u2502  \u001b[22m 9+ import statistics\r\r\n\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[2m  \u2502  \u001b[22m14+     \"\"\"Check if a string value can be converted to a number.\"\"\"\r\r\n\u001b[2m  \u2502  \u001b[22m15+     try:\r\r\n\u001b[2m  \u2502  \u001b[22m16+         float(value)\r\r\n\u001b[2m  \u2502  \u001b[22m17+         return True\r\r\n\u001b[2m  \u2502  \u001b[22m18+     except (ValueError, TypeError):\r\r\n\u001b[2m  \u2502  \u001b[22m19+         return False\r\r\n\u001b[2m  \u2502  \u001b[22m20+\r\r\n\u001b[2m  \u2502  21  ... (+109 more lines)\u001b[22m\r\r\n"]
[66.298792, "o", "\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\nNow let's create a realistic sales dataset:\r\r\n\u001b[38;5;167m|\u001b[39m Tinkering \u001b[2m3.6s\u001b[22m\r\r\n\u001b[38;5;239m\u001b[2m\u2500\u2500 \u001b[22m\u001b[38;5;75m\u2191 30 above \u00b7 \u2193 1 below \u00b7 Shift+\u2191\u2193 \u00b7 End \u2913\u001b[38;5;239m\u001b[2m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mCreate a Python command-line \u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[38;5;167m\u25ba\u001b[39m \u001b[7m \u001b[27m\u001b[2m                                                                        Press \u2191 to recall history\u001b[22m\r\r\n                  \u001b[32m\u2880\u2840\u001b[39m  \u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                                                          \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n                 \u001b[32m\u2830\u28fd\u28ef\u2806\u001b[39m                \u001b[36m\u28a0\u28ff\u2844\u001b[39m           \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m                        \u001b[93m\u28f0\u28b5\u286e\u28c6\u001b[39m\r\r\n                 \u001b[32m\u2828\u280a\u2811\u2805\u001b[39m                \u001b[36m\u2879\u283b\u288b\u001b[39m           \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m                      \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m\r\r\n                                        \u001b[36m\u001b[2m\u2820\u001b[22m\u001b[39m           \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m                         "]
