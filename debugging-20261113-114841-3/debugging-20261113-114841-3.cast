[184.299906, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[1G\u001b[KLet me find a concrete difference between \u001b[2mFullLoader\u001b[22m and `\r\r\n\u001b[E\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[17G\u001b[K \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m               \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m                                  \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[2m\u2820\u001b[22m\u001b[39m\r\r\n\u001b[17G\u001b[K \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m               \u001b[93m\u2819\u28be\u2877\u280b\u001b[39m                                  \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m\r\r\n\u001b[21G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m                                      \u001b[35m\u001b[2m\u2802\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[2G\u001b[K\u001b[38;5;248m6.0 tps \u00b7 \u219168k \u21931.1k \u00b7\u2026\u001b[39m           \u001b[33m\u26a1auto \u00b7 \u001b[36m\u001b[2m[core] \u001b[39manthropic-vertex/claude-opus-4-8 \u00b7  10% \u001b[22m\u001b[38;5;35m\u25b0\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u25b1\u001b[39m\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 