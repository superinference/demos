[34.09885, "o", "\u001b[29A\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[E\u001b[36G\u001b[K\u001b[32m\u28ce\u28b3\u001b[36m\u2890\u2842\u001b[39m \u001b[37m\u2846\u28b1\u001b[39m             \u001b[93m\u001b[2m\u2809\u001b[22m\u28c4\u28b7\u28ff\u28e2\u001b[39m \u001b[37m\u28d4\u28f7\u28fe\u28e2\u001b[39m          \u001b[35m\u28ce\u28b3\u001b[39m \u001b[35m\u001b[2m\u2820\u001b[22m\u001b[39m \u001b[37m\u2846\u28b1\u001b[39m\r\r\n\u001b[35G\u001b[K\u001b[32m\u001b[2m\u2802\u001b[22m\u28bc\u2827\u001b[36m\u284d\u28a9\u001b[39m \u001b[37m\u289c\u2864\u001b[36m\u001b[2m\u2804\u001b[22m\u001b[39m             \u001b[93m\u2811\u283f\u283b\u280b\u001b[2m\u2824\u001b[22m\u001b[37m\u2811\u281f\u2838\u2802\u001b[39m        \u001b[35m\u001b[2m\u2804\u001b[22m\u001b[39m \u001b[35m\u28be\u28a7\u2843\u001b[39m  \u001b[37m\u289c\u2864\u001b[39m\r\r\n\u001b[39G\u001b[K\u001b[32m\u001b[2m\u2820\u001b[22m\u001b[39m                   \u001b[93m\u001b[2m\u2812\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222