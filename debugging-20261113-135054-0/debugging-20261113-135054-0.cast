[152.22766, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 5-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6-     while lo < hi:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m7-         mid = (lo + hi) // 2\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8-         if arr[mid] < target:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9-             lo = mid + 1\r\r\n\u001b[6G\u001b[K\u001b[2m    ... 8 more changes ...\u001b[22m\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m8+         if arr[mid] == target:\r\r\n\u001b[7G\u001b[K\u001b[2m\u001b[22m9+             return mid\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m10+         elif arr[mid] < target:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m11+             lo = mid + 1\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m12+         else:\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m13+             hi = mid\r\r\n\u001b[6G\u001b[K\u001b[2m14      \u001b[22m\r\r\n\u001b[6G\u001b[K\u001b[2m15      return -1\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+12\u001b[39m\u001b[2m \u001b[22m\u001b[38;5;203m-10\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[KNow let's re-run the tests to verify the fix:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K  \u001b[38;5;167m\u25cf\u001b[39m \u001b[1m\u001b[38;5;167mbash\u001b[39m\u001b[22m\u001b[2m \u00b7 \u001b[22m\u001b[38;5;243mcd /tmp/ami-demo-yz1vdS && python -m pytest test_search.p...\u001b[39m\r\r\n\u001b[1G\u001b[K\u001b[38;5;167m|\u001b[39m bash cd /tmp/ami-demo-yz1vdS && python -m pytest test_search.p..