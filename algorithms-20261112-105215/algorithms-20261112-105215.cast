[17.176924, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ from collections import deque\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+ def shortest_path(graph, start, goal):\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+     queue = deque([(start, [start])])\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+     visited = {start}\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+     while queue:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+         node, path = queue.popleft()\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 4 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m14+             if neighbor not in visited:\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+                 visited.add(neighbor)\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+                 queue.append((neighbor, path + [neighbor]))\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     return None\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+14 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u