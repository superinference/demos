[186.692413, "o", "\u001b[?2026h\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b[29A\u001b[19G\u001b[KDivide::test_divide_floats PASSED                      [ 96%]\r\r\n\u001b[19G\u001b[KDivide::test_divide_by_one PASSED                      [100%]\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K============================== 25 passed in 0.02s ==============================\r\r\n\u001b[1G\u001b[K\u001b[1mSummary\u001b[22m\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mcalc.py\u001b[22m contains four functions:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 add(a, b) - adds two numbers\r\r\n\u001b[1G\u001b[K\u2022 subtract(a, b) - subtracts b from a\r\r\n\u001b[1G\u001b[K\u2022 multiply(a, b) - multiplies two numbers\r\r\n\u001b[1G\u001b[K\u2022 divide(a, b) - divides a by b with explicit ZeroDivisionError handling\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u001b[1mtest_calc.py\u001b[22m contains 25 comprehensive tests organized into 4 test classes:\r\r\n\u001b[1G\u001b[K\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mTestAdd\u001b[22m (5 tests): positive, negative, mixed signs, zero, floats\r\r\n\u001b[1G\u001b[K\u2022 \u001b[1mTestSubtract\u001b[22m (6 tests): positive, negative, result to negative, zero cases, floats\r\r\n\u001b[7G\u001b[K\u001b[1mMultiply\u001b[22m (6 tests): positive, negative, mixed signs, zero, identity (\u00d71), floats\r\r\n\u001b[7G\u001b[K\u001b[1mDivide\u001b[22