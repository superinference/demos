[158.592404, "o", "\u001b[29A\u001b[6G\u001b[K\u001b[2m\u001b[22m 1- #!/usr/bin/env python3\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 2- \"\"\"Encode a hardcoded phrase into Morse code (letters and spaces only).\"\"\"\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 3-\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 4- MORSE = {\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 5-     \"A\": \".-\", \"B\": \"-...\", \"C\": \"-.-.\", \"D\": \"-..\", \"E\": \".\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 6-     \"F\": \"..-.\", \"G\": \"--.\", \"H\": \"....\", \"I\": \"..\", \"J\": \".---\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 7-     \"K\": \"-.-\", \"L\": \".-..\", \"M\": \"--\", \"N\": \"-.\", \"O\": \"---\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 8-     \"P\": \".--.\", \"Q\": \"--.-\", \"R\": \".-.\", \"S\": \"...\", \"T\": \"-\",\r\r\n\u001b[6G\u001b[K\u001b[2m\u001b[22m 9-     \"U\": \"..-\", \"V\": \"...-\", \"W\": \".--\", \"X\": \"-..-\", \"Y\": \"-.--\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m10-     \"Z\": \"--..\",\r\r\n\u001b[3G\u001b[K\u001b[2m\u2502      ... 24 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+     \"0\": \"-----\", \"1\": \".----\", \"2\": \"..---\", \"3\": \"...--\", \"4\": \"....-\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+     \"5\": \".....\", \"6\": \"-....\", \"7\": \"--...\", \"8\": \"---..\", \"9\": \"----.\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+     \".\": \".-.-.-\", \",\": \"--..--\", \"?\": \"..--..\", \"'\": \".----.\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+     \"!\": \"-.-.--\", \"/\": \"-..-.\", \"(\": \"-.--.\", \")\": \"-.--.-\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+     \"&\": \".-...\", \":\": \"---...\", \";\": \"-.-.-.\", \"=\": \"-...-\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+     \"+\": \".-.-.\", \"-\": \"-....-\", \"_\": \"..--.-\", '\"': \".-..-.\",\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[2