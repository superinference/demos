[62.750959, "o", "\u001b[29A\u001b[1G\u001b[K\u001b[2m  \u2502   2  \u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 1+ # quickping\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 2+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 3+ A lightweight network latency checker that shows you response times instantly.\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 4+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 5+ ```bash\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 6+ quickping google.com\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 7+ ```\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 8+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m 9+ ## Quick start\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502      ... 5 more changes ...\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m15+ # Check a single host\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m16+ quickping example.com\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m17+\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m18+ # Monitor continuously\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m19+ quickping -c example.com\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  \u001b[22m20+ ```\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  21  ... (+57 more lines)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2502  22  [Auto-formatted]\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;243m  \u2502  \u001b[39m\u001b[2m(\u001b[22m\u001b[38;5;35m+20\u001b[39m\u001b[2m total)\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[2m  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[22m\r\r\n\u001b[1G\u001b[K\u001b[38;5;136m\\\u001b[39m Cooking \u001b[2m9.3s\u001b[22m\r\r\n\u001b[3G\u001b[K\u001b[38;5;239m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[22m\u001b[38;5;35mActivate the cognitive-doc-de\u2026\u001b[38;5;239m\u001b[2m \u2500\u2500\u001b[22m\u001b[39m\r\r\n\u001b[E\u001b[1G\u001b[K\r\r\n\u001b[18G\u001b[K       \u001b[32m\u28a0\u28fa\u28d7\u2844\u001b[39m       \u001b[36m\u28a0\u28d4\u28fa\u28ff\u28d7\u28e2\u2844\u001b[39m             \u001b[35m\u28a0\u28fa\u28d7\u2844\u001b[39m            \u001b[93m\u28e0\u28be\u2877\u28c4\u001b[39m\r\r\n\u001b[18G\u001b[K       \u001b[32m\u2894\u281d\u282b\u2862\u001b[39m       \u001b[36m\u2879\u282f\u281d\u283b\u282f\u281d\u288b\u001b[39m             \u001b[35m\u28b9\u285f\u28bb\u284f\u001b[39m            \u001b[93m\u2839\u287a\u2897\u280f\u001b[39m\r\r\n\u001b[28G\u001b[K\u001b[32m\u001b[2m\u2804\u001b[22m\u001b[39m                                            \u001b[93m\u001b[2m\u2824\u001b[22m\u001b[39m\r\r\n\u001b[12G\u001b[K\u001b[36m\u001b[2m\u258c\u001b[22m\u001b[39m\r\r\n\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588\u001b[38;5;216m\u2580\u001b[38;5;216m\u2584\u001b[38;5;216m\u2580\u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580\u001b[38;5;222m\u2588\u001b[38;5;222m\u2580\u001b[0m\u001b[3;77H\u001b[38;5;210m\u2588\u001b[38;5;210m\u2580\u001b[38;5;210m\u2588 \u001b[38;5;216m\u2588 \u001b[38;5;216m\u2580 \u001b[38;5;216m\u2588 \u001b[38;5;222m\u2584\u001b[38;5;222m\u2588\u001b[38;5;222m\u2584\u001b[0m\u001b[4;77H\u001b]8;;https://www.superinference.org\u0007\u001b[2mwww.superinference.org\u001b[22m\u001b]8;;\u0007\u001b[0m\u001b8\u001b7\u001b[2;77H\u001b[38;5;210m\u2584\u001b[38;5;210m\u25